        if(x==0xff800000u)return Exact32::from_bits(0u);
        if(abstop>=0x7f8u)return Exact32::from_bits(soft32_add(x,x));
        if(!(x&0x80000000u)&&x>0x42b17218u)return Exact32::from_bits(0x7f800000u);
        if((x&0x80000000u)&&(x&0x7fffffffu)>0x42cff1b4u)return Exact32::from_bits(0u);
    }
    ulong xd=soft64_from_f32_bits(x),inv=0x40471547652b82feul,shift=0x4338000000000000ul;
    ulong kd=soft64_fma(inv,xd,shift),ki=kd;kd=soft64_sub(kd,shift);
    ulong r=soft64_fma(inv,xd,soft64_negate_bits(kd));
