    ulong z=soft64_fma(0x3ebc6af84b912394ul,r,0x3f2ebfce50fac4f3ul),r2=soft64_mul(r,r);
    ulong y=soft64_fma(0x3f962e42ff0c52d6ul,r,0x3ff0000000000000ul);
    return Exact32::from_bits(soft64_to_f32_bits(soft64_mul(soft64_fma(z,r2,y),scale)));
}
static inline Exact32 mynn_pow(Exact32 a,Exact32 b) {
    uint x=a.bits,y=b.bits,ax=x&0x7fffffffu,ay=y&0x7fffffffu;
    if(ay==0u)return Exact32::from_bits((ax>0x7f800000u&&!(x&0x00400000u))?x|0x00400000u:0x3f800000u);
    if(x==0x3f800000u)return Exact32::from_bits((ay>0x7f800000u&&!(y&0x00400000u))?y|0x00400000u:0x3f800000u);
