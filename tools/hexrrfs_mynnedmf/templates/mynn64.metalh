#include "exact_binary32.metalh"
#include "soft_binary64.metalh"
// A distinct type keeps binary64 overloads and conversions separate from uint64.
struct Mynn64 {
    ulong bits;
    Mynn64() : bits(0) {}
    Mynn64(Exact32 a) : bits(soft64_from_f32_bits(a.bits)) {}
    Mynn64(float a) : bits(soft64_from_f32_bits(as_type<uint>(a))) {}
    Mynn64(int a) : bits(soft64_from_i32(a)) {}
    static Mynn64 from_bits(ulong a) { Mynn64 r; r.bits=a; return r; }
    operator Exact32() const { return Exact32::from_bits(soft64_to_f32_bits(bits)); }
};
static inline Mynn64 mynn_nan64(Mynn64 a,Mynn64 b,ulong r) {
    if (soft64_is_nan(a.bits)) return Mynn64::from_bits(a.bits|0x0008000000000000ul);
    if (soft64_is_nan(b.bits)) return Mynn64::from_bits(b.bits|0x0008000000000000ul);
    if (soft64_is_nan(r)) return Mynn64::from_bits(0xfff8000000000000ul);
    return Mynn64::from_bits(r);
}
static inline Mynn64 mynn_dadd(Mynn64 a,Mynn64 b) { return mynn_nan64(a,b,soft64_add(a.bits,b.bits)); }
static inline Mynn64 mynn_dsub(Mynn64 a,Mynn64 b) { return mynn_nan64(a,b,soft64_sub(a.bits,b.bits)); }
static inline Mynn64 mynn_dmul(Mynn64 a,Mynn64 b) { return mynn_nan64(a,b,soft64_mul(a.bits,b.bits)); }
static inline Mynn64 mynn_ddiv(Mynn64 a,Mynn64 b) { return mynn_nan64(a,b,soft64_div(a.bits,b.bits)); }
static inline Mynn64 mynn_sqrt(Mynn64 a) { return mynn_nan64(a,Mynn64::from_bits(0ul),soft64_sqrt(a.bits)); }
static inline Mynn64 mynn_abs(Mynn64 a) { return Mynn64::from_bits(a.bits & 0x7ffffffffffffffful); }
static inline Mynn64 mynn_sign(Mynn64 a,Mynn64 b) { return Mynn64::from_bits((a.bits&0x7ffffffffffffffful)|(b.bits&0x8000000000000000ul)); }
static inline Mynn64 r6_neg(Mynn64 a) { return Mynn64::from_bits(a.bits^0x8000000000000000ul); }
static inline bool operator<(Mynn64 a,Mynn64 b) { return soft64_less(a.bits,b.bits); }
static inline bool operator>(Mynn64 a,Mynn64 b) { return soft64_greater(a.bits,b.bits); }
static inline bool operator<=(Mynn64 a,Mynn64 b) { return soft64_less_equal(a.bits,b.bits); }
static inline bool operator>=(Mynn64 a,Mynn64 b) { return soft64_greater_equal(a.bits,b.bits); }
