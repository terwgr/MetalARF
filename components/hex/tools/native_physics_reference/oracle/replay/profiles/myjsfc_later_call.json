  "initialize": [
    "  do profile_cell=1,ime",
    "    ht(profile_cell,1)=100.0_real32*real(mod(profile_cell,3),real32)",
    "    if(mod(profile_cell,3)==0) xland(profile_cell,1)=2.0_real32",
    "    if(mod(profile_cell,8)==0) lowlyr(profile_cell,1)=2",
    "    tsk(profile_cell,1)=290.0_real32+real(mod(profile_cell,5)-2,real32)*5.0_real32",
