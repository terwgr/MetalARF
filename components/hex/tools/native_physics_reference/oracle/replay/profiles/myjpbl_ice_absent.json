  "initialize": [
    "  do profile_cell=1,ime",
    "    ht(profile_cell,1)=100.0_real32*real(mod(profile_cell,3),real32)",
    "    if(mod(profile_cell,3)==0) xland(profile_cell,1)=2.0_real32",
    "    if(mod(profile_cell,8)==0) lowlyr(profile_cell,1)=2",
    "    tsk(profile_cell,1)=290.0_real32+real(mod(profile_cell,5)-2,real32)*5.0_real32",
    "    do profile_level=1,kme",
    "      dz(profile_cell,profile_level,1)=30.0_real32+10.0_real32*real(mod(profile_cell,4),real32)",
    "      pint(profile_cell,profile_level,1)=100000.0_real32-1500.0_real32*real(profile_level-1,real32)",
    "      pmid(profile_cell,profile_level,1)=pint(profile_cell,profile_level,1)-750.0_real32",
    "      exner_value=(pmid(profile_cell,profile_level,1)/100000.0_real32)**(287.04_real32/1004.64_real32)",
    "      th(profile_cell,profile_level,1)=290.0_real32+real(mod(profile_cell,4)-1,real32)*0.5_real32*real(profile_level-1,real32)",
    "      t(profile_cell,profile_level,1)=th(profile_cell,profile_level,1)*exner_value",
    "      qv(profile_cell,profile_level,1)=0.007_real32*exp(-real(profile_level-1,real32)/12.0_real32)",
    "      u(profile_cell,profile_level,1)=5.0_real32+0.1_real32*real(profile_level-1,real32)",
    "      if(mod(profile_cell,8)==4) then",
    "        u(profile_cell,profile_level,1)=0.0_real32",
    "        v(profile_cell,profile_level,1)=0.0_real32",
    "      endif",
    "      exner(profile_cell,profile_level,1)=exner_value",
    "      rho(profile_cell,profile_level,1)=pmid(profile_cell,profile_level,1)/(287.04_real32*t(profile_cell,profile_level,1))",
    "      if(mod(profile_cell,8)==6 .and. mod(profile_level,2)==0) qcw(profile_cell,profile_level,1)=1.e-39_real32",
    "      if(mod(profile_cell,8)==6 .and. mod(profile_level,2)==1) qci(profile_cell,profile_level,1)=2.e-39_real32",
    "      if(mod(profile_cell,8)==7) then",
