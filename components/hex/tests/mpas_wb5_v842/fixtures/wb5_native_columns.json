    "--- pinned/mp_wsm6.F90",
    "+++ referee/mp_wsm6.F90",
    "@@ -63,0 +64,6 @@",
    "+",
    "+!correct mode, finding WB5 (the host sets this once at initialization; MPAS from config_physics_mode):",
    "+!.false. books the below-ground part of the straddling sedimentation cell at the flat cell mean, as",
    "+!released; .true. books it with the same piecewise-linear profile (qmi/qpi) the remap integrates for",
    "+!the part that stays aloft, so column water plus surface precipitation is conserved.",
    "+ logical,public,save:: wsm6_plm_surface = .false.",
    "@@ -1984 +1990,6 @@",
    "-          precip(i) = precip(i) + qa(k)*(0.0-za(k))",
    "+          if(wsm6_plm_surface) then",
    "+             th = (0.0-za(k))/dza(k)",
    "+             precip(i) = precip(i) + dza(k)*(qmi(k)*th + 0.5*(qpi(k)-qmi(k))*th*th)",
    "+          else",
    "+             precip(i) = precip(i) + qa(k)*(0.0-za(k))",
    "+          endif",
    "@@ -2254 +2265,6 @@",
    "-             precip(i) = precip(i) + qa(k)*(0.0-za(k))",
    "+             if(wsm6_plm_surface) then",
    "+                th = (0.0-za(k))/dza(k)",
    "+                precip(i) = precip(i) + dza(k)*(qmi(k)*th + 0.5*(qpi(k)-qmi(k))*th*th)",
    "+             else",
    "+                precip(i) = precip(i) + qa(k)*(0.0-za(k))",
    "+             endif"
  ],
