static inline LakeWcrDD lw_odd(int i,int sign){LakeWcrDD v={lw_bits(lw_wcr_inv_odd_h[i]),lw_bits(lw_wcr_inv_odd_l[i])};return sign&1?lw_neg(v):v;}
static inline LakeWcrDD lw_int(int i,int sign){LakeWcrDD v={lw_bits(lw_wcr_inv_int_h[i]),lw_bits(lw_wcr_inv_int_l[i])};return sign&1?lw_neg(v):v;}
static inline LakeWcrDD lw_add_nc(LakeWcrDD a,LakeWcrDD b){LakeWcrDD s=lw_sum(a.h,b.h);return lw_fast_sum(s.h,s.l+(a.l+b.l));}
static inline LakeWcrDD lw_div(LakeWcrDD a,LakeWcrDD b){W q1=a.h/b.h;LakeWcrDD r=lw_add(a,lw_neg(lw_mul_d(b,q1)));W q2=r.h/b.h;r=lw_add(r,lw_neg(lw_mul_d(b,q2)));W q3=r.h/b.h;return lw_add(lw_fast_sum(q1,q2),{q3,W(0)});}
static inline LakeWcrDD lw_log_fast(W x){
 int e=0;if(x<lw_bits(0x0010000000000000ul)){x=x*lw_bits(0x4350000000000000ul);e=-54;}
 ulong bits=x.bits;e+=int((bits>>52)&0x7fful)-1023;W m=lw_bits((bits&0x000ffffffffffffful)|0x3ff0000000000000ul);
 if(m>=W(1.5f)){m=m*W(.5f);e+=1;}int j=soft64_to_i32_rz(soft64_rint_bits((m*W(128)).bits)).value-96;
 LakeWcrDD p=lw_prod(m,lw_bits(lw_log_inv[j])),r=lw_sum(p.h-W(1),p.l);W rh=r.h;LakeWcrDD r2=lw_prod(rh,rh);
 W tail=rh*r2.h*(lw_bits(0x3fd5555555555555ul)+rh*(W(-.25f)+rh*(lw_bits(0x3fc999999999999aul)+rh*(-lw_bits(0x3fc5555555555555ul)+rh*(lw_bits(0x3fc2492492492492ul)+rh*(W(-.125f)+rh*(lw_bits(0x3fbc71c71c71c71cul)-rh*lw_bits(0x3fb999999999999aul))))))));
 LakeWcrDD v=lw_sum(rh,-W(.5f)*r2.h);v=lw_fast_sum(v.h,v.l+(r.l+((-W(.5f)*r2.l-rh*r.l)+tail)));
 LakeWcrDD tab={lw_bits(lw_wcr_log_tab_h[j]),lw_bits(lw_wcr_log_tab_l[j])};
 if(e!=0){W ed=W(e);LakeWcrDD E=lw_prod(ed,lw_bits(0x3fe62e42fefa39eful));E.l=E.l+ed*lw_bits(0x3c7abc9e3b39803ful);tab=lw_add_nc(E,tab);}return lw_add_nc(tab,v);
}
static inline LakeWcrDD lw_log_dd(W x){int e=0;if(x<lw_bits(0x0010000000000000ul)){x=x*lw_bits(0x4350000000000000ul);e=-54;}
 ulong bits=x.bits;e+=int((bits>>52)&0x7fful)-1023;W m=lw_bits((bits&0x000ffffffffffffful)|0x3ff0000000000000ul);
 if(m>lw_bits(0x3ff6a09e667f3bcdul)){m=m*W(.5f);e+=1;}W f=m-W(1),zero=W(0);
 LakeWcrDD u=lw_div({f,zero},lw_sum(W(2),f)),u2=lw_mul(u,u),s=lw_odd(20,0);
 for(int n=19;n>=0;--n)s=lw_add(lw_mul(s,u2),lw_odd(n,0));
 LakeWcrDD lm=lw_mul({W(2)*u.h,W(2)*u.l},s);if(e==0)return lm;W ed=W(e);
 LakeWcrDD r=lw_add(lw_prod(ed,lw_bits(0x3fe62e42fefa39eful)),lw_prod(ed,lw_bits(0x3c7abc9e3b39803ful)));
 r=lw_add(r,{ed*lw_bits(0x3907b57a079a1934ul),zero});return lw_add(r,lm);
}
static inline W lw_log_near1(W x){W f=x-W(1);LakeWcrDD p=lw_int(16,17);for(int n=15;n>=2;--n)p=lw_add(lw_mul_d(p,f),lw_int(n,n+1));LakeWcrDD A=lw_mul(lw_prod(f,f),p);return lw_rn3(f,A.h,A.l);}
static inline ulong lake_wcr_log_bits(ulong bits){W x=lw_bits(bits),zero=W(0);if(soft64_is_nan(bits))return (x+x).bits;if(x==W(1))return 0ul;if(x<zero)return (zero/zero).bits;if(x==zero)return 0xfff0000000000000ul;if(soft64_is_infinite(bits))return bits;W out;if(lw_round_ok(lw_log_fast(x),lw_bits(0x3c00000000000000ul),out))return out.bits;if(lw_abs(x-W(1))<lw_bits(0x3f70000000000000ul))return lw_log_near1(x).bits;return lw_round(lw_log_dd(x)).bits;}
static inline ulong lake_wcr_log10_bits(ulong bits){W x=lw_bits(bits),zero=W(0);if(soft64_is_nan(bits))return (x+x).bits;if(x==W(1))return 0ul;if(x<zero)return (zero/zero).bits;if(x==zero)return 0xfff0000000000000ul;if(soft64_is_infinite(bits))return bits;LakeWcrDD inv={lw_bits(0x3fdbcb7b1526e50eul),lw_bits(0x3c695355baaafad3ul)};W out;if(lw_round_ok(lw_mul(lw_log_fast(x),inv),lw_bits(0x3c10000000000000ul),out))return out.bits;return lw_round(lw_mul(lw_log_dd(x),inv)).bits;}
