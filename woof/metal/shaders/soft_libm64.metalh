    const ulong plm_L1 = soft64_plm_bits(0x3fe3333333333303), plm_L2 = soft64_plm_bits(0x3fdb6db6db6fabff), plm_L3 = soft64_plm_bits(0x3fd55555518f264d);
    const ulong plm_L4 = soft64_plm_bits(0x3fd17460a91d4101), plm_L5 = soft64_plm_bits(0x3fcd864a93c9db65), plm_L6 = soft64_plm_bits(0x3fca7e284a454eef);
    const ulong plm_P1 = soft64_plm_bits(0x3fc555555555553e), plm_P2 = soft64_plm_bits(0xbf66c16c16bebd93), plm_P3 = soft64_plm_bits(0x3f11566aaf25de2c);
    const ulong plm_P4 = soft64_plm_bits(0xbebbbd41c5d26bf1), plm_P5 = soft64_plm_bits(0x3e66376972bea4d0);
    const ulong plm_LG2 = soft64_plm_bits(0x3fe62e42fefa39ef), plm_LG2_H = soft64_plm_bits(0x3fe62e4300000000), plm_LG2_L = soft64_plm_bits(0xbe205c610ca86c39);
    const ulong plm_OVT = 0x3c971547652b82feul, plm_CP = soft64_plm_bits(0x3feec709dc3a03fd), plm_CP_H = soft64_plm_bits(0x3feec709e0000000), plm_CP_L = soft64_plm_bits(0xbe3e2fe0145b01f5);
    const ulong plm_IVLN2 = soft64_plm_bits(0x3ff71547652b82fe), plm_IVLN2_H = soft64_plm_bits(0x3ff7154760000000), plm_IVLN2_L = soft64_plm_bits(0x3e54ae0bf85ddf44);
    int hx = (int)soft64_plm_hi(x), hy = (int)soft64_plm_hi(y);
    uint lx = (uint)soft64_plm_word(x), ly = (uint)soft64_plm_word(y);
    int ix = hx & 0x7fffffff, iy = hy & 0x7fffffff;
    if (((uint)iy | ly) == 0) return 0x3ff0000000000000ul;
    if (hx == 0x3ff00000 && lx == 0) return 0x3ff0000000000000ul;
    // Match the pinned source NaN precedence explicitly, including when both
    // operands are NaNs; no soft arithmetic is needed on this path.
    if (ix > 0x7ff00000 || (ix == 0x7ff00000 && lx != 0)) return (soft64_plm_word(x) | 0x0008000000000000ul);
    if (iy > 0x7ff00000 || (iy == 0x7ff00000 && ly != 0)) return (soft64_plm_word(y) | 0x0008000000000000ul);
    int yisint = 0, k, j;
    if (hx < 0) {
        if (iy >= 0x43400000) yisint = 2;
        else if (iy >= 0x3ff00000) {
            k = (iy >> 20) - 0x3ff;
            if (k > 20) { j = (int)(ly >> (52 - k)); if (((uint)j << (52 - k)) == ly) yisint = 2 - (j & 1); }
            else if (ly == 0) { j = iy >> (20 - k); if ((j << (20 - k)) == iy) yisint = 2 - (j & 1); }
        }
    }
