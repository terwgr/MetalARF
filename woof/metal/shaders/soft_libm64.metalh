        return z;
    }
    ulong s = 0x3ff0000000000000ul;
    if (hx < 0) { if (yisint == 0) return soft64_div(soft64_sub(x, x), soft64_sub(x, x)); if (yisint == 1) s = 0xbff0000000000000ul; }
    ulong t1, t2;
    if (iy > 0x41e00000) {
        if (iy > 0x43f00000) {
            if (ix <= 0x3fefffff) return hy < 0 ? soft64_mul(plm_HUGE, plm_HUGE) : soft64_mul(plm_TINY, plm_TINY);
            if (ix >= 0x3ff00000) return hy > 0 ? soft64_mul(plm_HUGE, plm_HUGE) : soft64_mul(plm_TINY, plm_TINY);
        }
        if (ix < 0x3fefffff) return hy < 0 ? soft64_mul(soft64_mul(s, plm_HUGE), plm_HUGE) : soft64_mul(soft64_mul(s, plm_TINY), plm_TINY);
        if (ix > 0x3ff00000) return hy > 0 ? soft64_mul(soft64_mul(s, plm_HUGE), plm_HUGE) : soft64_mul(soft64_mul(s, plm_TINY), plm_TINY);
        ulong t = soft64_sub(ax, 0x3ff0000000000000ul), w = soft64_mul(soft64_mul(t, t), soft64_sub(0x3fe0000000000000ul, soft64_mul(t, soft64_sub(0x3fd5555555555555ul, soft64_mul(t, 0x3fd0000000000000ul)))));
        ulong u = soft64_mul(plm_IVLN2_H, t), v = soft64_sub(soft64_mul(t, plm_IVLN2_L), soft64_mul(w, plm_IVLN2));
        t1 = soft64_plm_setlo(soft64_add(u, v), 0); t2 = soft64_sub(v, soft64_sub(t1, u));
    } else {
        int n = 0;
        if (ix < 0x00100000) { ax = soft64_mul(ax, plm_TWO53); n -= 53; ix = (int)soft64_plm_hi(ax); }
        n += (ix >> 20) - 0x3ff; j = ix & 0x000fffff;
        int k; ix = j | 0x3ff00000;
        if (j <= 0x3988e) k = 0;
        else if (j < 0xbb67a) k = 1;
        else { k = 0; n += 1; ix -= 0x00100000; }
        ax = soft64_plm_sethi(ax, (uint)ix);
        ulong u = soft64_sub(ax, plm_BP[k]), v = soft64_div(0x3ff0000000000000ul, soft64_add(ax, plm_BP[k])), ss = soft64_mul(u, v), s_h = soft64_plm_setlo(ss, 0);
        ulong t_h = soft64_plm_sethi(0x0000000000000000ul, (((uint)ix >> 1) | 0x20000000) + 0x00080000 + ((uint)k << 18));
        ulong t_l = soft64_sub(ax, soft64_sub(t_h, plm_BP[k])), s_l = soft64_mul(v, soft64_sub(soft64_sub(u, soft64_mul(s_h, t_h)), soft64_mul(s_h, t_l)));
        ulong s2 = soft64_mul(ss, ss), r = soft64_mul(soft64_mul(s2, s2), soft64_add(plm_L1, soft64_mul(s2, soft64_add(plm_L2, soft64_mul(s2, soft64_add(plm_L3, soft64_mul(s2, soft64_add(plm_L4, soft64_mul(s2, soft64_add(plm_L5, soft64_mul(s2, plm_L6)))))))))));
        r = soft64_add(r, soft64_mul(s_l, soft64_add(s_h, ss))); s2 = soft64_mul(s_h, s_h);
        t_h = soft64_plm_setlo(soft64_add(soft64_add(0x4008000000000000ul, s2), r), 0); t_l = soft64_sub(r, soft64_sub(soft64_sub(t_h, 0x4008000000000000ul), s2));
        u = soft64_mul(s_h, t_h); v = soft64_add(soft64_mul(s_l, t_h), soft64_mul(t_l, ss));
        ulong p_h = soft64_plm_setlo(soft64_add(u, v), 0), p_l = soft64_sub(v, soft64_sub(p_h, u));
        ulong z_h = soft64_mul(plm_CP_H, p_h), z_l = soft64_add(soft64_add(soft64_mul(plm_CP_L, p_h), soft64_mul(p_l, plm_CP)), plm_DP_L[k]);
        ulong t = soft64_from_i32(n);
        t1 = soft64_plm_setlo(soft64_add(soft64_add(soft64_add(z_h, z_l), plm_DP_H[k]), t), 0);
        t2 = soft64_sub(z_l, soft64_sub(soft64_sub(soft64_sub(t1, t), plm_DP_H[k]), z_h));
    }
    ulong y1 = soft64_plm_setlo(y, 0), p_l = soft64_add(soft64_mul(soft64_sub(y, y1), t1), soft64_mul(y, t2)), p_h = soft64_mul(y1, t1), z = soft64_add(p_l, p_h);
    j = (int)soft64_plm_hi(z); int i = (int)soft64_plm_word(z);
    if (j >= 0x40900000) {
        if (((j - 0x40900000) | i) != 0) return soft64_mul(soft64_mul(s, plm_HUGE), plm_HUGE);
        if (soft64_greater(soft64_add(p_l, plm_OVT), soft64_sub(z, p_h))) return soft64_mul(soft64_mul(s, plm_HUGE), plm_HUGE);
    } else if ((j & 0x7fffffff) >= 0x4090cc00) {
        if ((((uint)j - 0xc090cc00U) | (uint)i) != 0) return soft64_mul(soft64_mul(s, plm_TINY), plm_TINY);
        if (soft64_less_equal(p_l, soft64_sub(z, p_h))) return soft64_mul(soft64_mul(s, plm_TINY), plm_TINY);
    }
    i = j & 0x7fffffff; k = (i >> 20) - 0x3ff; int n = 0;
    if (i > 0x3fe00000) {
        n = j + (0x00100000 >> (k + 1)); k = ((n & 0x7fffffff) >> 20) - 0x3ff;
        ulong t = soft64_plm_sethi(0x0000000000000000ul, (uint)(n & ~(0x000fffff >> k)));
