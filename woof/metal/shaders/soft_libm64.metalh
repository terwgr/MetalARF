    z = soft64_add(u, v); ulong w = soft64_sub(v, soft64_sub(z, u)); t = soft64_mul(z, z);
    t1 = soft64_sub(z, soft64_mul(t, soft64_add(plm_P1, soft64_mul(t, soft64_add(plm_P2, soft64_mul(t, soft64_add(plm_P3, soft64_mul(t, soft64_add(plm_P4, soft64_mul(t, plm_P5))))))))));
    ulong r = soft64_sub(soft64_div(soft64_mul(z, t1), soft64_sub(t1, 0x4000000000000000ul)), soft64_add(w, soft64_mul(z, w))); z = soft64_sub(0x3ff0000000000000ul, soft64_sub(r, z));
