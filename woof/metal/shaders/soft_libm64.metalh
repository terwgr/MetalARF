        if (iy == 0x7ff00000) {
            if (((ix - 0x3ff00000) | (int)lx) == 0) return 0x3ff0000000000000ul;
            if (ix >= 0x3ff00000) return hy >= 0 ? y : 0x0000000000000000ul;
            return hy >= 0 ? 0x0000000000000000ul : soft64_negate_bits(y);
        }
        if (iy == 0x3ff00000) return hy >= 0 ? x : soft64_div(0x3ff0000000000000ul, x);
        if (hy == 0x40000000) return soft64_mul(x, x);
        if (hy == 0x3fe00000 && hx >= 0) return soft64_sqrt(x);
