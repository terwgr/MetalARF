    if (lx == 0 && (ix == 0x7ff00000 || ix == 0 || ix == 0x3ff00000)) {
        ulong z = ax;
        if (hy < 0) z = soft64_div(0x3ff0000000000000ul, z);
        if (hx < 0) {
            if (((ix - 0x3ff00000) | yisint) == 0) z = soft64_div(soft64_sub(z, z), soft64_sub(z, z));
            else if (yisint == 1) z = soft64_negate_bits(z);
