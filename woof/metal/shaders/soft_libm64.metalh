#include "soft_binary64.metalh"

static inline ulong soft64_plm_bits(ulong bits) { return bits; }
static inline ulong soft64_plm_word(ulong bits) { return bits; }
static inline uint soft64_plm_hi(ulong bits) { return uint(bits >> 32); }
static inline ulong soft64_plm_sethi(ulong x, uint h) { return (ulong(h) << 32) | (x & 0xfffffffful); }
static inline ulong soft64_plm_setlo(ulong x, uint l) { return (x & 0xffffffff00000000ul) | ulong(l); }
static inline ulong soft64_plm_scalbn(ulong x, int n);
static inline int soft64_plm_i32(ulong x) {
    if (soft64_is_nan(x)) return 0;
    if (soft64_greater_equal(x, 0x41dfffffffc00000ul)) return 2147483647;
    if (soft64_less_equal(x, 0xc1e0000000000000ul)) return as_type<int>(0x80000000u);
    const Soft64I32Result cv = soft64_to_i32_rz(x);
    return cv.valid ? cv.value : (soft64_sign(x) ? as_type<int>(0x80000000u) : 2147483647);
}
static inline ulong soft64_plm_scalbn(ulong x, int n) {
    if (n > 1023) {
        x = soft64_mul(x, 0x7fe0000000000000ul); n -= 1023;
        if (n > 1023) { x = soft64_mul(x, 0x7fe0000000000000ul); n -= 1023; if (n > 1023) n = 1023; }
    } else if (n < -1022) {
        x = soft64_mul(x, 0x0360000000000000ul); n += 969;
        if (n < -1022) { x = soft64_mul(x, 0x0360000000000000ul); n += 969; if (n < -1022) n = -1022; }
    }
    const ulong scale = ulong(1023 + n) << 52;
    return soft64_mul(x, scale);
}

static inline ulong soft64_plm_exp(ulong x) {
    const ulong plm_LN2HI = soft64_plm_bits(0x3fe62e42fee00000ul);
    const ulong plm_LN2LO = soft64_plm_bits(0x3dea39ef35793c76ul);
    const ulong plm_INVLN2 = soft64_plm_bits(0x3ff71547652b82feul);
    const ulong plm_P1 = soft64_plm_bits(0x3fc555555555553eul);
    const ulong plm_P2 = soft64_plm_bits(0xbf66c16c16bebd93ul);
    const ulong plm_P3 = soft64_plm_bits(0x3f11566aaf25de2cul);
    const ulong plm_P4 = soft64_plm_bits(0xbebbbd41c5d26bf1ul);
    const ulong plm_P5 = soft64_plm_bits(0x3e66376972bea4d0ul);
    uint hx = soft64_plm_hi(x);
    const int sign = int(hx >> 31);
    hx &= 0x7fffffffu;

    if (hx >= 0x4086232bu) {
        if ((soft64_plm_word(x) & 0x7ffffffffffffffful)
                > 0x7ff0000000000000ul)
            return x;
        if (soft64_greater(x, 0x40862e42fefa39eful))
            return soft64_mul(x, 0x7fe0000000000000ul);
        if (soft64_less(x, 0xc0874910d52d3051ul))
            return 0ul;
    }

    int k;
    ulong hi, lo;
    if (hx > 0x3fd62e42u) {
        if (hx >= 0x3ff0a2b2u) {
            const ulong half_word = sign != 0 ? 0xbfe0000000000000ul
                                              : 0x3fe0000000000000ul;
            k = soft64_plm_i32(
                soft64_add(soft64_mul(plm_INVLN2, x), half_word));
        } else {
            k = 1 - sign - sign;
        }
        const ulong kd = soft64_from_i32(k);
        hi = soft64_sub(x, soft64_mul(kd, plm_LN2HI));
        lo = soft64_mul(kd, plm_LN2LO);
        x = soft64_sub(hi, lo);
    } else if (hx > 0x3e300000u) {
        k = 0;
        hi = x;
        lo = 0ul;
    } else {
        return soft64_add(0x3ff0000000000000ul, x);
    }

    const ulong xx = soft64_mul(x, x);
    const ulong c = soft64_sub(x, soft64_mul(xx, soft64_add(plm_P1,
        soft64_mul(xx, soft64_add(plm_P2, soft64_mul(xx,
            soft64_add(plm_P3, soft64_mul(xx,
                soft64_add(plm_P4, soft64_mul(xx, plm_P5))))))))));
    const ulong rational = soft64_sub(
        soft64_div(soft64_mul(x, c), soft64_sub(0x4000000000000000ul, c)),
        lo);
    const ulong y = soft64_add(0x3ff0000000000000ul,
                               soft64_add(rational, hi));
    return k == 0 ? y : soft64_plm_scalbn(y, k);
}

static inline ulong soft64_plm_log(ulong x) {
    const ulong plm_LN2_HI = soft64_plm_bits(0x3fe62e42fee00000), plm_LN2_LO = soft64_plm_bits(0x3dea39ef35793c76);
    const ulong plm_LG1 = soft64_plm_bits(0x3fe5555555555593), plm_LG2 = soft64_plm_bits(0x3fd999999997fa04), plm_LG3 = soft64_plm_bits(0x3fd2492494229359);
    const ulong plm_LG4 = soft64_plm_bits(0x3fcc71c51d8e78af), plm_LG5 = soft64_plm_bits(0x3fc7466496cb03de), plm_LG6 = soft64_plm_bits(0x3fc39a09d078c69f), plm_LG7 = soft64_plm_bits(0x3fc2f112df3e5244);
    ulong ui = soft64_plm_word(x); uint hx = ui >> 32; int k = 0;
    if (hx < 0x00100000 || (hx >> 31) != 0) {
        if ((ui << 1) == 0) return soft64_plm_bits(0xfff0000000000000);
        if (hx >> 31) return soft64_div(soft64_sub(x, x), 0x0000000000000000ul);
        k -= 54; x = soft64_mul(x, soft64_plm_bits(0x4350000000000000)); ui = soft64_plm_word(x); hx = ui >> 32;
    } else if (hx >= 0x7ff00000) return x;
    else if (hx == 0x3ff00000 && (ui << 32) == 0) return 0x0000000000000000ul;
    hx += 0x3ff00000 - 0x3fe6a09e; k += (int)(hx >> 20) - 0x3ff;
    hx = (hx & 0x000fffff) + 0x3fe6a09e; x = soft64_plm_sethi(x, hx);
    ulong f = soft64_sub(x, 0x3ff0000000000000ul), hfsq = soft64_mul(soft64_mul(0x3fe0000000000000ul, f), f), s = soft64_div(f, soft64_add(0x4000000000000000ul, f));
    ulong z = soft64_mul(s, s), w = soft64_mul(z, z);
    ulong t1 = soft64_mul(w, soft64_add(plm_LG2, soft64_mul(w, soft64_add(plm_LG4, soft64_mul(w, plm_LG6)))));
    ulong t2 = soft64_mul(z, soft64_add(plm_LG1, soft64_mul(w, soft64_add(plm_LG3, soft64_mul(w, soft64_add(plm_LG5, soft64_mul(w, plm_LG7)))))));
    ulong r = soft64_add(t2, t1), dk = soft64_from_i32(k);
    return soft64_add(soft64_add(soft64_sub(soft64_add(soft64_mul(s, soft64_add(hfsq, r)), soft64_mul(dk, plm_LN2_LO)), hfsq), f), soft64_mul(dk, plm_LN2_HI));
}

// Keep the sizeable portable pow implementation in its own device function.
// Apple MTLCompilerService on M2 crashes while legalizing it when inlined into
// Thompson's active-ice kernel; this call boundary leaves its arithmetic intact.
