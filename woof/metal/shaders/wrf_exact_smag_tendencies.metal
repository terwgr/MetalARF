Exact32 wrf_tau13(thread const WrfSmagGrid& q, device const Exact32* km, int kw, int j, int i)
{
    if (kw <= 0 || kw >= q.nz) return 0.0f;
    Exact32 rhoavg = 0.5f * (q.fnm[kw] * (wrf_rho(q, kw, j, i - 1)
                                        + wrf_rho(q, kw, j, i))
                           + q.fnp[kw] * (wrf_rho(q, kw - 1, j, i - 1)
                                        + wrf_rho(q, kw - 1, j, i)));
    Exact32 kavg = 0.5f * (q.fnm[kw] * (wrf_k(q, km, kw, j, i - 1)
                                      + wrf_k(q, km, kw, j, i))
                         + q.fnp[kw] * (wrf_k(q, km, kw - 1, j, i - 1)
                                      + wrf_k(q, km, kw - 1, j, i)));
    return -rhoavg * kavg * wrf_defor13(q, kw, j, i);
}

Exact32 wrf_tau23(thread const WrfSmagGrid& q, device const Exact32* km, int kw, int j, int i)
{
    if (kw <= 0 || kw >= q.nz) return 0.0f;
    Exact32 rhoavg = 0.5f * (q.fnm[kw] * (wrf_rho(q, kw, j - 1, i)
                                        + wrf_rho(q, kw, j, i))
                           + q.fnp[kw] * (wrf_rho(q, kw - 1, j - 1, i)
                                        + wrf_rho(q, kw - 1, j, i)));
    Exact32 kavg = 0.5f * (q.fnm[kw] * (wrf_k(q, km, kw, j - 1, i)
                                      + wrf_k(q, km, kw, j, i))
                         + q.fnp[kw] * (wrf_k(q, km, kw - 1, j - 1, i)
                                      + wrf_k(q, km, kw - 1, j, i)));
    return -rhoavg * kavg * wrf_defor23(q, kw, j, i);
}

Exact32 wrf_tau13_mavg(thread const WrfSmagGrid& q, device const Exact32* km, int k, int j, int i)
{return 0.25f*(wrf_tau13(q,km,k+1,j,i+1)+wrf_tau13(q,km,k+1,j,i)+wrf_tau13(q,km,k,j,i+1)+wrf_tau13(q,km,k,j,i));}

Exact32 wrf_tau23_mavg(thread const WrfSmagGrid& q, device const Exact32* km, int k, int j, int i)
{return 0.25f*(wrf_tau23(q,km,k+1,j+1,i)+wrf_tau23(q,km,k+1,j,i)+wrf_tau23(q,km,k,j+1,i)+wrf_tau23(q,km,k,j,i));}
void wrf_smag_hd_w(device const Exact32* u, device const Exact32* v, device const Exact32* w, device const Exact32* php, device const Exact32* phb, device const Exact32* alt, device const Exact32* qv, device const Exact32* msft, device const Exact32* msfu, device const Exact32* msfv, device const Exact32* fnm, device const Exact32* fnp, device const Exact32* dn, device const Exact32* dnw, Exact32 rdx, Exact32 rdy, Exact32 dx, Exact32 dy, Exact32 cf1, Exact32 cf2, Exact32 cf3, int moist, device const Exact32* km, device Exact32* tend,
                   int nz, int ny, int nx, int phb3d,
                   int boundary_x, int boundary_y, int i, int j, int kw)
{



    if (i >= nx || j >= ny || kw >= nz + 1 || kw == 0 || kw == nz) return;
    WrfSmagGrid q = wrf_grid(u, v, w, php, phb, alt, qv, msft, msfu, msfv, fnm, fnp, dn, dnw, rdx, rdy, dx, dy, cf1, cf2, cf3, nz, ny, nx, phb3d, boundary_x, boundary_y, moist);
    int ii = wrf_ix(q, i), jj = wrf_iy(q, j);
    Exact32 map = msft[(SmagIndex)jj * nx + ii];
    Exact32 zx_w = 0.5f * (wrf_zx(q, kw, j, i) + wrf_zx(q, kw, j, i + 1));
    Exact32 zy_w = 0.5f * (wrf_zy(q, kw, j, i) + wrf_zy(q, kw, j + 1, i));
    Exact32 rz = wrf_rdz(q, kw, j, i);
    Exact32 divh = map * rdx * (wrf_tau13(q, km, kw, j, i + 1)
                              - wrf_tau13(q, km, kw, j, i))
              + map * rdy * (wrf_tau23(q, km, kw, j + 1, i)
                              - wrf_tau23(q, km, kw, j, i));
    Exact32 divz = map * rz * (zx_w * (wrf_tau13_mavg(q, km, kw, j, i)
                                     - wrf_tau13_mavg(q, km, kw - 1, j, i))
                           + zy_w * (wrf_tau23_mavg(q, km, kw, j, i)
                                     - wrf_tau23_mavg(q, km, kw - 1, j, i)));
    tend[((ulong)(kw) * (ny) * (nx) + (ulong)(j) * (nx) + (i))] += 9.81f / (dn[kw] * rz) * (divh - divz);
}
struct WrfScalarField {
    device const Exact32* f;
    device const Exact32* thb;
    int full_theta;
    int thb3d;
};

Exact32 wrf_scalar(thread const WrfSmagGrid& q, thread const WrfScalarField& s,
                int k, int j, int i)
{
    int jj = wrf_iy(q, j), ii = wrf_ix(q, i);
    Exact32 value = s.f[((ulong)(k) * (q.ny) * (q.nx) + (ulong)(jj) * (q.nx) + (ii))];
    if (s.full_theta) {
        SmagIndex h = s.thb3d ? ((ulong)(k) * (q.ny) * (q.nx) + (ulong)(jj) * (q.nx) + (ii)) : (SmagIndex)k;
        value = value;
    }
    return value;
}

Exact32 wrf_scalar_w_xface(thread const WrfSmagGrid& q, thread const WrfScalarField& s,
                        int kw, int j, int i)
{
if (kw <= 0) return 0.5f * (q.cf1 * wrf_scalar(q,s,0,j,i) + q.cf2 * wrf_scalar(q,s,1,j,i) + q.cf3 * wrf_scalar(q,s,2,j,i) + q.cf1 * wrf_scalar(q,s,0,j,i - 1) + q.cf2 * wrf_scalar(q,s,1,j,i - 1) + q.cf3 * wrf_scalar(q,s,2,j,i - 1));
if (kw >= q.nz) return 0.5f * (wrf_scalar(q,s,q.nz-1,j,i)+exact_div((wrf_scalar(q,s,q.nz-1,j,i)-wrf_scalar(q,s,q.nz-2,j,i))*0.5f*q.dnw[q.nz-1], q.dn[q.nz-1]) + wrf_scalar(q,s,q.nz-1,j,i - 1)+exact_div((wrf_scalar(q,s,q.nz-1,j,i - 1)-wrf_scalar(q,s,q.nz-2,j,i - 1))*0.5f*q.dnw[q.nz-1], q.dn[q.nz-1]));
    Exact32 p0 = wrf_scalar(q, s, 0, j, i - 1) + wrf_scalar(q, s, 0, j, i);
    Exact32 p1 = wrf_scalar(q, s, 1, j, i - 1) + wrf_scalar(q, s, 1, j, i);
    Exact32 p2 = wrf_scalar(q, s, 2, j, i - 1) + wrf_scalar(q, s, 2, j, i);
    Exact32 pl = wrf_scalar(q, s, q.nz - 1, j, i - 1)
            + wrf_scalar(q, s, q.nz - 1, j, i);
    Exact32 pp = wrf_scalar(q, s, q.nz - 2, j, i - 1)
            + wrf_scalar(q, s, q.nz - 2, j, i);
    int kc = kw >= q.nz ? q.nz - 1 : kw;
    int kb = kc > 0 ? kc - 1 : 0;
    Exact32 pc = wrf_scalar(q, s, kc, j, i - 1) + wrf_scalar(q, s, kc, j, i);
    Exact32 pb = wrf_scalar(q, s, kb, j, i - 1) + wrf_scalar(q, s, kb, j, i);
    return 0.5f * wrf_full_weights(q, kw, p0, p1, p2, pl, pp, pc, pb);
}

Exact32 wrf_scalar_w_yface(thread const WrfSmagGrid& q, thread const WrfScalarField& s,
                        int kw, int j, int i)
{
if (kw <= 0) return 0.5f * (q.cf1 * wrf_scalar(q,s,0,j,i) + q.cf2 * wrf_scalar(q,s,1,j,i) + q.cf3 * wrf_scalar(q,s,2,j,i) + q.cf1 * wrf_scalar(q,s,0,j - 1,i) + q.cf2 * wrf_scalar(q,s,1,j - 1,i) + q.cf3 * wrf_scalar(q,s,2,j - 1,i));
if (kw >= q.nz) return 0.5f * (wrf_scalar(q,s,q.nz-1,j,i)+exact_div((wrf_scalar(q,s,q.nz-1,j,i)-wrf_scalar(q,s,q.nz-2,j,i))*0.5f*q.dnw[q.nz-1], q.dn[q.nz-1]) + wrf_scalar(q,s,q.nz-1,j - 1,i)+exact_div((wrf_scalar(q,s,q.nz-1,j - 1,i)-wrf_scalar(q,s,q.nz-2,j - 1,i))*0.5f*q.dnw[q.nz-1], q.dn[q.nz-1]));
    Exact32 p0 = wrf_scalar(q, s, 0, j - 1, i) + wrf_scalar(q, s, 0, j, i);
    Exact32 p1 = wrf_scalar(q, s, 1, j - 1, i) + wrf_scalar(q, s, 1, j, i);
    Exact32 p2 = wrf_scalar(q, s, 2, j - 1, i) + wrf_scalar(q, s, 2, j, i);
    Exact32 pl = wrf_scalar(q, s, q.nz - 1, j - 1, i)
            + wrf_scalar(q, s, q.nz - 1, j, i);
    Exact32 pp = wrf_scalar(q, s, q.nz - 2, j - 1, i)
            + wrf_scalar(q, s, q.nz - 2, j, i);
    int kc = kw >= q.nz ? q.nz - 1 : kw;
    int kb = kc > 0 ? kc - 1 : 0;
    Exact32 pc = wrf_scalar(q, s, kc, j - 1, i) + wrf_scalar(q, s, kc, j, i);
    Exact32 pb = wrf_scalar(q, s, kb, j - 1, i) + wrf_scalar(q, s, kb, j, i);
    return 0.5f * wrf_full_weights(q, kw, p0, p1, p2, pl, pp, pc, pb);
}

Exact32 wrf_h1(thread const WrfSmagGrid& q, thread const WrfScalarField& s, device const Exact32* kh,
            int k, int j, int i)
{
    Exact32 rhoavg = 0.5f * (wrf_rho(q, k, j, i - 1)
                           + wrf_rho(q, k, j, i));
    Exact32 kavg = 0.5f * (wrf_k(q, kh, k, j, i - 1)
                         + wrf_k(q, kh, k, j, i));
    Exact32 tmpzx = 0.5f * (wrf_zx(q, k, j, i) + wrf_zx(q, k + 1, j, i));
    Exact32 rdzu = 2.0f / (1.0f / wrf_rdzw(q, k, j, i)
                         + 1.0f / wrf_rdzw(q, k, j, i - 1));
    int jj = wrf_iy(q, j), iu = wrf_iu(q, i);
    Exact32 map = q.msfu[(SmagIndex)jj * (q.nx + 1) + iu];
    Exact32 grad = q.rdx * (wrf_scalar(q, s, k, j, i)
                         - wrf_scalar(q, s, k, j, i - 1))
              - tmpzx * (wrf_scalar_w_xface(q, s, k + 1, j, i)
                         - wrf_scalar_w_xface(q, s, k, j, i)) * rdzu;
    Exact32 xkxavg=kavg*0.5f*(wrf_rho(q,k,j,i-1)+wrf_rho(q,k,j,i)); return -map*xkxavg*grad;
}

Exact32 wrf_h2(thread const WrfSmagGrid& q, thread const WrfScalarField& s, device const Exact32* kh,
            int k, int j, int i)
{
    Exact32 rhoavg = 0.5f * (wrf_rho(q, k, j - 1, i)
                           + wrf_rho(q, k, j, i));
    Exact32 kavg = 0.5f * (wrf_k(q, kh, k, j - 1, i)
                         + wrf_k(q, kh, k, j, i));
    Exact32 tmpzy = 0.5f * (wrf_zy(q, k, j, i) + wrf_zy(q, k + 1, j, i));
    Exact32 rdzv = 2.0f / (1.0f / wrf_rdzw(q, k, j, i)
                         + 1.0f / wrf_rdzw(q, k, j - 1, i));
    int jv = wrf_jv(q, j), ii = wrf_ix(q, i);
    Exact32 map = q.msfv[(SmagIndex)jv * q.nx + ii];
    Exact32 grad = q.rdy * (wrf_scalar(q, s, k, j, i)
                         - wrf_scalar(q, s, k, j - 1, i))
              - tmpzy * (wrf_scalar_w_yface(q, s, k + 1, j, i)
                         - wrf_scalar_w_yface(q, s, k, j, i)) * rdzv;
    Exact32 xkxavg=kavg*0.5f*(wrf_rho(q,k,j-1,i)+wrf_rho(q,k,j,i)); return -map*xkxavg*grad;
}

Exact32 wrf_fx(thread const WrfSmagGrid& q, device const Exact32* fx, int k, int j, int i)
{
    int jj = wrf_iy(q, j), ii = wrf_iu(q, i);
    return fx[((ulong)(k) * (q.ny) * (q.nx + 1) + (ulong)(jj) * (q.nx + 1) + (ii))];
}

Exact32 wrf_fy(thread const WrfSmagGrid& q, device const Exact32* fy, int k, int j, int i)
{
    int jj = wrf_jv(q, j), ii = wrf_ix(q, i);
    return fy[((ulong)(k) * (q.ny + 1) * (q.nx) + (ulong)(jj) * (q.nx) + (ii))];
}

Exact32 wrf_h1_mavg(thread const WrfSmagGrid& q, device const Exact32* fx,
                 int kw, int j, int i)
{
    if (kw <= 0 || kw >= q.nz) return 0.0f;
    return 0.5f * (q.fnm[kw] * (wrf_fx(q, fx, kw, j, i + 1)
                                 + wrf_fx(q, fx, kw, j, i))
                  + q.fnp[kw] * (wrf_fx(q, fx, kw - 1, j, i + 1)
                                 + wrf_fx(q, fx, kw - 1, j, i)));
}

Exact32 wrf_h2_mavg(thread const WrfSmagGrid& q, device const Exact32* fy,
                 int kw, int j, int i)
{
    if (kw <= 0 || kw >= q.nz) return 0.0f;
    return 0.5f * (q.fnm[kw] * (wrf_fy(q, fy, kw, j + 1, i)
                                 + wrf_fy(q, fy, kw, j, i))
                  + q.fnp[kw] * (wrf_fy(q, fy, kw - 1, j + 1, i)
                                 + wrf_fy(q, fy, kw - 1, j, i)));
}
void wrf_smag_flux_s(device const Exact32* u, device const Exact32* v, device const Exact32* w, device const Exact32* php, device const Exact32* phb, device const Exact32* alt, device const Exact32* qv, device const Exact32* msft, device const Exact32* msfu, device const Exact32* msfv, device const Exact32* fnm, device const Exact32* fnp, device const Exact32* dn, device const Exact32* dnw, Exact32 rdx, Exact32 rdy, Exact32 dx, Exact32 dy, Exact32 cf1, Exact32 cf2, Exact32 cf3, int moist, device const Exact32* f, device const Exact32* kh,
                     device const Exact32* thb, int full_theta, int thb3d,
                     device Exact32* fx, device Exact32* fy, int nz, int ny, int nx, int phb3d,
                     int boundary_x, int boundary_y, int i, int j, int k)
{



    if (k >= nz) return;
    WrfSmagGrid q = wrf_grid(u, v, w, php, phb, alt, qv, msft, msfu, msfv, fnm, fnp, dn, dnw, rdx, rdy, dx, dy, cf1, cf2, cf3, nz, ny, nx, phb3d, boundary_x, boundary_y, moist);
    WrfScalarField s = {f, thb, full_theta, thb3d};
    if (i < nx + 1 && j < ny)
        fx[((ulong)(k) * (ny) * (nx + 1) + (ulong)(j) * (nx + 1) + (i))] = wrf_h1(q, s, kh, k, j, i);
    if (i < nx && j < ny + 1)
