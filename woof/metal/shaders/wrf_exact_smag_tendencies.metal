void wrf_smag_hd_s(device const Exact32* u, device const Exact32* v, device const Exact32* w, device const Exact32* php, device const Exact32* phb, device const Exact32* alt, device const Exact32* qv, device const Exact32* msft, device const Exact32* msfu, device const Exact32* msfv, device const Exact32* fnm, device const Exact32* fnp, device const Exact32* dn, device const Exact32* dnw, Exact32 rdx, Exact32 rdy, Exact32 dx, Exact32 dy, Exact32 cf1, Exact32 cf2, Exact32 cf3, int moist, device const Exact32* fx, device const Exact32* fy,
                   device Exact32* tend, int nz, int ny, int nx, int phb3d,
                   int boundary_x, int boundary_y, int i, int j, int k)
{



    if (i >= nx || j >= ny || k >= nz) return;
    WrfSmagGrid q = wrf_grid(u, v, w, php, phb, alt, qv, msft, msfu, msfv, fnm, fnp, dn, dnw, rdx, rdy, dx, dy, cf1, cf2, cf3, nz, ny, nx, phb3d, boundary_x, boundary_y, moist);
    int ii = wrf_ix(q, i), jj = wrf_iy(q, j);
    Exact32 map = msft[(SmagIndex)jj * nx + ii];
    Exact32 zx_m = 0.25f * (wrf_zx(q, k, j, i) + wrf_zx(q, k, j, i + 1)
                          + wrf_zx(q, k + 1, j, i)
                          + wrf_zx(q, k + 1, j, i + 1));
    Exact32 zy_m = 0.25f * (wrf_zy(q, k, j, i) + wrf_zy(q, k, j + 1, i)
                          + wrf_zy(q, k + 1, j, i)
                          + wrf_zy(q, k + 1, j + 1, i));
    Exact32 rz = wrf_rdzw(q, k, j, i);
    Exact32 divh = map * rdx * (wrf_fx(q, fx, k, j, i + 1)
                              - wrf_fx(q, fx, k, j, i))
              + map * rdy * (wrf_fy(q, fy, k, j + 1, i)
                              - wrf_fy(q, fy, k, j, i));
    Exact32 divz = map * zx_m * (wrf_h1_mavg(q, fx, k + 1, j, i)
                              - wrf_h1_mavg(q, fx, k, j, i)) * rz
              + map * zy_m * (wrf_h2_mavg(q, fy, k + 1, j, i)
                              - wrf_h2_mavg(q, fy, k, j, i)) * rz;
    Exact32 first=map*zx_m*(wrf_h1_mavg(q,fx,k+1,j,i)-wrf_h1_mavg(q,fx,k,j,i))*rz;
    Exact32 second=map*zy_m*(wrf_h2_mavg(q,fy,k+1,j,i)-wrf_h2_mavg(q,fy,k,j,i))*rz;
    tend[((ulong)(k) * (ny) * (nx) + (ulong)(j) * (nx) + (i))] += exact_div(9.81f, dnw[k] * rz)*((divh-first)-second);
}
