// WRF 4.8 urban statements retain their source operation boundaries.
// Binary64 solver intermediates use integer software arithmetic.
#include "soft_binary64.metalh"
#include "soft_urban_trig.metalh"
struct UcmR8 {
    ulong bits;
    UcmR8(): bits(0ul) {}
    UcmR8(float x): bits(soft64_from_f32_bits(as_type<uint>(x))) {}
    UcmR8(int x): bits(soft64_from_i32(x)) {}
    static UcmR8 from_bits(ulong b) {UcmR8 x; x.bits=b; return x;}
    operator float() const {return as_type<float>(soft64_to_f32_bits(bits));}
};
static inline UcmR8 operator-(UcmR8 x) {return UcmR8::from_bits(soft64_negate_bits(x.bits));}
static inline UcmR8 ucm_dadd(UcmR8 a,UcmR8 b) {return UcmR8::from_bits(soft64_add(a.bits,b.bits));}
static inline UcmR8 ucm_dsub(UcmR8 a,UcmR8 b) {return UcmR8::from_bits(soft64_sub(a.bits,b.bits));}
static inline UcmR8 ucm_dmul(UcmR8 a,UcmR8 b) {return UcmR8::from_bits(soft64_mul(a.bits,b.bits));}
static inline UcmR8 ucm_ddiv(UcmR8 a,UcmR8 b) {return UcmR8::from_bits(soft64_div(a.bits,b.bits));}
static inline bool operator<(UcmR8 a,UcmR8 b) {return soft64_less(a.bits,b.bits);}
static inline bool operator>(UcmR8 a,UcmR8 b) {return soft64_greater(a.bits,b.bits);}
static inline bool operator<(UcmR8 a,float b) {return a<UcmR8(b);}
static inline UcmR8 ucm_abs(UcmR8 x) {return UcmR8::from_bits(soft64_abs_bits(x.bits));}
static inline float ucm_abs(float x) {return as_type<float>(as_type<uint>(x)&0x7fffffffu);}
static inline UcmR8 ucm_copysign(UcmR8 a,UcmR8 b) {return UcmR8::from_bits((a.bits&0x7ffffffffffffffful)|(b.bits&0x8000000000000000ul));}
static inline float u480_real(int x) {return float(x);}
static inline int u480_int(float x) {return int(x);}
static inline int u480_nint(float x) {return int(round(x));}
static inline int u480_mod(int x,int y) {return x%y;}
static inline float u480_sign(float x,float y) {return as_type<float>((as_type<uint>(x)&0x7fffffffu)|(as_type<uint>(y)&0x80000000u));}
static inline float u480_sub(float a,float b) {return FSUB(a,b);}
static inline float ucm480_sin(float x) {return as_type<float>(soft_glibc_solar_sinf(as_type<uint>(x)));}
static inline float ucm480_cos(float x) {return as_type<float>(soft_glibc_solar_cosf(as_type<uint>(x)));}
static inline float ucm480_asin(float x) {return as_type<float>(soft_glibc_solar_asinf(as_type<uint>(x)));}
static inline float ucm480_acos(float x) {return as_type<float>(soft_urban_acosf(as_type<uint>(x)));}
static inline float ucm480_atan(float x) {return as_type<float>(soft_urban_atanf(as_type<uint>(x)));}
static inline float ucm480_tan(float x) {return as_type<float>(soft_urban_tanf(as_type<uint>(x)));}
static inline float pslmu(float zz) {return FMUL(as_type<float>(0xbf75c28fu),gfk_log(u480_sub(as_type<float>(0x3f800000u),FMUL(as_type<float>(0x40900000u),zz))));}
static inline float pslms(float zz) {return u480_sub(FDIV(zz,as_type<float>(0x3e439581u)),FMUL(as_type<float>(0x4004dd2fu),u480_sub(as_type<float>(0x3f800000u),FDIV(as_type<float>(0x3f800000u),FADD(zz,as_type<float>(0x3f800000u))))));}
static inline float pslhu(float zz) {return FMUL(as_type<float>(0xbf75c28fu),gfk_log(u480_sub(as_type<float>(0x3f800000u),FMUL(as_type<float>(0x40900000u),zz))));}
static inline float pslhs(float zz) {return u480_sub(FMUL(zz,as_type<float>(0x40c8a703u)),FMUL(as_type<float>(0x4004dd2fu),u480_sub(as_type<float>(0x3f800000u),gfk_exp(FMUL(as_type<float>(0xbf99999au),zz)))));}
static inline float pspmu(float xx) {return u480_sub(FADD(u480_sub(FMUL(as_type<float>(0xc0000000u),gfk_log(FMUL(FADD(xx,as_type<float>(0x3f800000u)),as_type<float>(0x3f000000u)))),gfk_log(FMUL(FADD(FMUL(xx,xx),as_type<float>(0x3f800000u)),as_type<float>(0x3f000000u)))),FMUL(as_type<float>(0x40000000u),ucm480_atan(xx))),as_type<float>(0x3fc90fdbu));}
static inline float pspms(float yy) {return FMUL(as_type<float>(0x40a00000u),yy);}
static inline float psphu(float xx) {return FMUL(as_type<float>(0xc0000000u),gfk_log(FMUL(FADD(FMUL(xx,xx),as_type<float>(0x3f800000u)),as_type<float>(0x3f000000u))));}
static inline float psphs(float yy) {return FMUL(as_type<float>(0x40a00000u),yy);}
