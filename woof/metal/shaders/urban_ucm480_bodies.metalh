static inline UcmR8 u480_maxd(UcmR8 a,UcmR8 b) {return a>b?a:b;}
static inline UcmR8 u480_powi64(UcmR8 x,int n) {unsigned int m=n<0?0u-(unsigned int)n:(unsigned int)n;UcmR8 y=m&1?x:UcmR8(1);while(m>>=1) {x=ucm_dmul(x,x);if(m&1)y=ucm_dmul(y,x);}return n<0?ucm_ddiv(UcmR8(1),y):y;}
