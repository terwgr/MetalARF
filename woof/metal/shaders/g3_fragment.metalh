float dz = z_cup ( 2 ) - z_cup ( 1 ) ;
float dp = 100.f * ( p_cup ( 1 ) - p_cup ( 2 ) ) ;
float detdo1 = edt * zd ( 2 ) * cdd ( 1 ) * dz ;
float detdo2 = edt * zd ( 1 ) ;
float entdo = edt * zd ( 2 ) * mentrd_rate * dz ;
float subin = - ( edt * zd ( 2 ) ) ;
della ( 1 ) = aa_div ( ( detdo1 * .5f * ( hcd ( 1 ) + hcd ( 2 ) ) + detdo2 * hcd ( 1 ) + subin * he_cup ( 2 ) - entdo * he ( 1 ) ) * g , dp ) ;
subs ( 1 ) = 0.f ;
}

void g3_cup_dellas ( int ierr , G3Col z_cup , G3Col p_cup , G3Col hcd , float edt , G3Col zd , G3Col cdd , G3Col he , G3Col della , G3Col subs , float mentrd_rate , G3Col zu , float g , G3Col cd , G3Col hc , int ktop , int k22 , int kbcon , float mentr_rate , int jmin , G3Col he_cup , int kdet , int kpbl , bool shallow , int high_res , int ktf ) {
int kstart = shallow ? 1 : 2 ;
for ( int k = kstart ;
k <= ktf ;
++ k ) {
della ( k ) = 0.f ;
subs ( k ) = 0.f ;
}
if ( ierr != 0 ) return ;
for ( int k = 2 ;
k <= ktf - 1 ;
++ k ) {
if ( k > ktop ) continue ;
if ( k < k22 - 1 && shallow ) continue ;
float dz = z_cup ( k + 1 ) - z_cup ( k ) ;
float detdo = edt * cdd ( k ) * dz * zd ( k + 1 ) ;
float entdo = edt * mentrd_rate * dz * zd ( k + 1 ) ;
float subin = - ( zd ( k + 1 ) * edt ) ;
float entup = 0.f , detup = 0.f ;
if ( k >= kbcon && k < ktop ) {
entup = mentr_rate * dz * zu ( k ) ;
detup = cd ( k + 1 ) * dz * zu ( k ) ;
}
float subdown = - ( zd ( k ) * edt ) ;
float entdoj = 0.f , entupk = 0.f , detupk = 0.f ;
if ( k == jmin ) entdoj = edt * zd ( k ) ;
if ( k == k22 - 1 ) {
entupk = zu ( kpbl ) ;
subin = zu ( k + 1 ) - zd ( k + 1 ) * edt ;
if ( high_res == 1 ) subin = - ( zd ( k + 1 ) * edt ) ;
}
if ( k > kdet ) detdo = 0.f ;
if ( k == ktop ) {
detupk = zu ( ktop ) ;
subin = 0.f ;
subdown = 0.f ;
}
if ( k < kbcon ) detup = 0.f ;
float dp = 100.f * ( p_cup ( k - 1 ) - p_cup ( k ) ) ;
della ( k ) = aa_div ( ( detup * .5f * ( hc ( k + 1 ) + hc ( k ) ) + detdo * .5f * ( hcd ( k + 1 ) + hcd ( k ) ) - entup * he ( k ) - entdo * he ( k ) + subin * he_cup ( k + 1 ) - subdown * he_cup ( k ) + detupk * ( hc ( ktop ) - he_cup ( ktop ) ) - entupk * he_cup ( k22 ) - entdoj * he_cup ( jmin ) ) * g , dp ) ;
if ( high_res == 1 ) {
della ( k ) = aa_div ( ( detup * .5f * ( hc ( k + 1 ) + hc ( k ) ) - entup * he ( k ) + ( entup - detup ) * he ( k ) + detdo * .5f * ( hcd ( k + 1 ) + hcd ( k ) ) - entdo * he ( k ) + subin * he_cup ( k + 1 ) - subdown * he_cup ( k ) + detupk * ( hc ( ktop ) - he ( ktop ) ) - entdoj * he_cup ( jmin ) - entupk * he_cup ( k22 ) + entupk * he ( k ) ) * g , dp ) ;
}
if ( k >= k22 && k < ktop ) {
subs ( k ) = aa_div ( ( zu ( k + 1 ) * he_cup ( k + 1 ) - zu ( k ) * he_cup ( k ) ) * g , dp ) ;
}
if ( high_res == 1 ) {
if ( k >= k22 && k < ktop ) {
subs ( k ) = aa_div ( ( zu ( k + 1 ) * he_cup ( k + 1 ) - zu ( k ) * he_cup ( k ) - ( entup - detup ) * he ( k ) ) * g , dp ) ;
}
else if ( k == ktop ) {
subs ( k ) = aa_div ( detupk * ( he ( ktop ) - he_cup ( ktop ) ) * g , dp ) ;
}
else if ( k == k22 - 1 ) {
subs ( k ) = aa_div ( ( entupk * he ( k ) - entupk * he_cup ( k ) ) * g , dp ) ;
}
}
}
}

void g3_cup_axx ( float tcrit , int kbmax , float z1 , G3Col p , float psur , float xl , float rv , float cp , int ierr_in , float cap_max , float cap_max_increment , float entr_rate , float mentr_rate , thread float * axx , thread G3Col * tx , thread G3Col * qx , G3Col he , G3Col hes , G3Col qes , G3Col z , G3Col qes_cup , G3Col q_cup , G3Col he_cup , G3Col hes_cup , G3Col z_cup , G3Col p_cup , G3Col gamma_cup , G3Col t_cup , G3Col dby , G3Col hc , G3Col zu , G3Col cd , G3Col tv , int ktf ) {
for ( int n = 0 ;
n < 9 ;
++ n ) axx [ n ] = 0.f ;
const float ht1 = aa_div ( xl , cp ) ;
const float ht2 = aa_div ( 2.834E6f , cp ) ;
const float be1 = aa_div ( .622f * ht1 , .286f ) ;
const float ae1 = aa_div ( be1 , 273.f ) + gfk_log ( 610.71f ) ;
const float be2 = aa_div ( .622f * ht2 , .286f ) ;
const float ae2 = aa_div ( be2 , 273.f ) + gfk_log ( 610.71f ) ;
for ( int n = 0 ;
n < 9 ;
++ n ) {
G3Col txn = tx [ n ] , qxn = qx [ n ] ;
for ( int k = 1 ;
k <= ktf ;
++ k ) cd ( k ) = 0.1f * entr_rate ;
int ierrxx = ierr_in ;
int k22xx = 1 , kbconxx = 1 , ktopxx = 1 ;
int kstabm = ktf - 1 ;
if ( ierrxx == 0 ) {
for ( int k = 1 ;
k <= ktf ;
++ k ) {
float ae = ae1 , be = be1 ;
if ( txn ( k ) <= tcrit ) {
ae = ae2 ;
be = be2 ;
}
float e = gfk_exp ( ae - aa_div ( be , txn ( k ) ) ) ;
qes ( k ) = aa_div ( .622f * e , ( 100.f * p ( k ) - e ) ) ;
if ( qes ( k ) <= 1.e-08f ) qes ( k ) = 1.e-08f ;
if ( qxn ( k ) > qes ( k ) ) qxn ( k ) = qes ( k ) ;
tv ( k ) = txn ( k ) + .608f * qxn ( k ) * txn ( k ) ;
}
z ( 1 ) = g3max ( 0.f , z1 ) - aa_div ( ( gfk_log ( p ( 1 ) ) - gfk_log ( psur ) ) * 287.f * tv ( 1 ) , 9.81f ) ;
for ( int k = 2 ;
k <= ktf ;
++ k ) {
float tvbar = .5f * tv ( k ) + .5f * tv ( k - 1 ) ;
z ( k ) = z ( k - 1 ) - aa_div ( ( gfk_log ( p ( k ) ) - gfk_log ( p ( k - 1 ) ) ) * 287.f * tvbar , 9.81f ) ;
}
for ( int k = 1 ;
k <= ktf ;
++ k ) {
he ( k ) = 9.81f * z ( k ) + 1004.f * txn ( k ) + 2.5E06f * qxn ( k ) ;
hes ( k ) = 9.81f * z ( k ) + 1004.f * txn ( k ) + 2.5E06f * qes ( k ) ;
if ( he ( k ) >= hes ( k ) ) he ( k ) = hes ( k ) ;
}
for ( int k = 2 ;
k <= ktf ;
++ k ) {
qes_cup ( k ) = .5f * ( qes ( k - 1 ) + qes ( k ) ) ;
q_cup ( k ) = .5f * ( qxn ( k - 1 ) + qxn ( k ) ) ;
hes_cup ( k ) = .5f * ( hes ( k - 1 ) + hes ( k ) ) ;
he_cup ( k ) = .5f * ( he ( k - 1 ) + he ( k ) ) ;
if ( he_cup ( k ) > hes_cup ( k ) ) he_cup ( k ) = hes_cup ( k ) ;
z_cup ( k ) = .5f * ( z ( k - 1 ) + z ( k ) ) ;
p_cup ( k ) = .5f * ( p ( k - 1 ) + p ( k ) ) ;
t_cup ( k ) = .5f * ( txn ( k - 1 ) + txn ( k ) ) ;
gamma_cup ( k ) = ( aa_div ( xl , cp ) ) * ( aa_div ( xl , ( rv * t_cup ( k ) * t_cup ( k ) ) ) ) * qes_cup ( k ) ;
}
qes_cup ( 1 ) = qes ( 1 ) ;
q_cup ( 1 ) = qxn ( 1 ) ;
hes_cup ( 1 ) = hes ( 1 ) ;
he_cup ( 1 ) = he ( 1 ) ;
z_cup ( 1 ) = .5f * ( z ( 1 ) + z1 ) ;
p_cup ( 1 ) = .5f * ( p ( 1 ) + psur ) ;
t_cup ( 1 ) = txn ( 1 ) ;
gamma_cup ( 1 ) = aa_div ( xl , cp ) * ( aa_div ( xl , ( rv * t_cup ( 1 ) * t_cup ( 1 ) ) ) ) * qes_cup ( 1 ) ;
}
k22xx = g3_maximi ( he_cup , 3 , kbmax , ierrxx ) ;
if ( ierrxx == 0 && k22xx >= kbmax ) ierrxx = 2 ;
g3_cup_kbcon ( cap_max_increment , 1 , k22xx , kbconxx , he_cup , hes_cup , ierrxx , kbmax , p_cup , cap_max ) ;
int kstabi = g3_minimi ( hes_cup , kbconxx , kstabm , ierrxx ) ;
if ( ierrxx == 0 && kstabm - 1 > kstabi ) {
for ( int k = kstabi ;
k <= kstabm - 1 ;
++ k ) {
cd ( k ) = cd ( k - 1 ) + 1.5f * entr_rate ;
if ( cd ( k ) > 10.0f * entr_rate ) cd ( k ) = 10.0f * entr_rate ;
}
}
float hkb ;
g3_cup_up_he ( k22xx , hkb , z_cup , cd , mentr_rate , he_cup , hc , kbconxx , ierrxx , dby , he , hes_cup , false , ktf ) ;
g3_cup_ktop ( 1 , dby , kbconxx , ktopxx , ierrxx , ktf ) ;
g3_cup_up_nms ( zu , z_cup , mentr_rate , cd , kbconxx , ktopxx , ierrxx , k22xx , ktf ) ;
float aa0 = g3_cup_up_aa0 ( z , zu , dby , gamma_cup , t_cup , kbconxx , ktopxx , ierrxx , ktf ) ;
if ( ierrxx == 0 ) axx [ n ] = aa0 ;
}
}

void g3_massflx_stats ( device const float * ens , long es , int ierr , int itest , thread float & xt_ave , thread float & xt_std , thread float * apr , thread float * prv ) {
const int num = aa_div ( 144 , 16 ) ;
const int num2 = aa_div ( 144 , 3 ) ;
float x_ave [ 16 ] , x_ave_cap [ 3 ] ;
if ( itest == 1 ) {
for ( int m = 0 ;
m < 8 ;
++ m ) prv [ m ] = 0.f ;
}
for ( int k = 0 ;
k < 3 ;
++ k ) x_ave_cap [ k ] = 0.f ;
for ( int k = 0 ;
k < 16 ;
++ k ) x_ave [ k ] = 0.f ;
xt_ave = 0.f ;
xt_std = 0.f ;
if ( ierr != 0 ) return ;
for ( int kk = 1 ;
kk <= num ;
++ kk ) for ( int k = 1 ;
k <= 16 ;
++ k ) x_ave [ k - 1 ] = x_ave [ k - 1 ] + ens [ ( 16 * ( kk - 1 ) + k - 1 ) * es ] ;
for ( int iedt = 1 ;
iedt <= 3 ;
++ iedt ) for ( int k = 1 ;
k <= 3 ;
++ k ) for ( int kk = 1 ;
kk <= 16 ;
++ kk ) x_ave_cap [ k - 1 ] = x_ave_cap [ k - 1 ] + ens [ ( 16 * ( k - 1 ) + ( iedt - 1 ) * 3 * 16 + kk - 1 ) * es ] ;
for ( int k = 0 ;
k < 3 ;
++ k ) x_ave_cap [ k ] = aa_div ( x_ave_cap [ k ] , ( float ) num2 ) ;
for ( int k = 0 ;
k < 16 ;
++ k ) x_ave [ k ] = aa_div ( x_ave [ k ] , ( float ) num ) ;
for ( int k = 0 ;
k < 16 ;
++ k ) xt_ave = xt_ave + x_ave [ k ] ;
xt_ave = aa_div ( xt_ave , ( float ) 16 ) ;
if ( xt_ave > 0.f ) {
for ( int k = 0 ;
k < 16 ;
++ k ) xt_std = xt_std + g3p2 ( x_ave [ k ] - xt_ave ) ;
}
if ( xt_std > 0.f ) {
xt_std = aa_div ( xt_std , ( float ) 16 ) ;
float a3 = g3max ( 1.e-6f , xt_std ) ;
xt_std = cu_sqrt ( a3 ) ;
if ( itest == 1 ) {
prv [ 0 ] = .25f * ( x_ave [ 0 ] + x_ave [ 1 ] + x_ave [ 2 ] + x_ave [ 12 ] ) ;
prv [ 1 ] = .25f * ( x_ave [ 3 ] + x_ave [ 4 ] + x_ave [ 5 ] + x_ave [ 13 ] ) ;
prv [ 2 ] = .25f * ( x_ave [ 6 ] + x_ave [ 7 ] + x_ave [ 8 ] + x_ave [ 14 ] ) ;
prv [ 3 ] = .333f * ( x_ave [ 9 ] + x_ave [ 10 ] + x_ave [ 11 ] ) ;
prv [ 4 ] = x_ave [ 15 ] ;
prv [ 5 ] = x_ave_cap [ 0 ] ;
prv [ 6 ] = x_ave_cap [ 1 ] ;
prv [ 7 ] = x_ave_cap [ 2 ] ;
}
else if ( itest == 2 ) {
apr [ 0 ] = .25f * ( x_ave [ 0 ] + x_ave [ 1 ] + x_ave [ 2 ] + x_ave [ 12 ] ) * 3600.f * prv [ 0 ] + apr [ 0 ] ;
apr [ 1 ] = .25f * ( x_ave [ 3 ] + x_ave [ 4 ] + x_ave [ 5 ] + x_ave [ 13 ] ) * 3600.f * prv [ 1 ] + apr [ 1 ] ;
apr [ 2 ] = .25f * ( x_ave [ 6 ] + x_ave [ 7 ] + x_ave [ 8 ] + x_ave [ 14 ] ) * 3600.f * prv [ 2 ] + apr [ 2 ] ;
apr [ 3 ] = .333f * ( x_ave [ 9 ] + x_ave [ 10 ] + x_ave [ 11 ] ) * 3600.f * prv [ 3 ] + apr [ 3 ] ;
apr [ 4 ] = x_ave [ 15 ] * 3600.f * prv [ 4 ] + apr [ 4 ] ;
apr [ 5 ] = x_ave_cap [ 0 ] * 3600.f * prv [ 5 ] + apr [ 5 ] ;
apr [ 6 ] = x_ave_cap [ 1 ] * 3600.f * prv [ 6 ] + apr [ 6 ] ;
apr [ 7 ] = x_ave_cap [ 2 ] * 3600.f * prv [ 7 ] + apr [ 7 ] ;
}
}
}

enum { G3I_U, G3I_V, G3I_T, G3I_Q, G3I_P, G3I_PI, G3I_RHO, G3I_RTHFTEN,
       G3I_RQVFTEN, G3I_RTHBLTEN, G3I_RQVBLTEN, G3I_NLEV };
