    0x3febe00000000000ul, 0x3fc1aa2b7e23f000ul, 0x3d2ca78e44389934ul,
    0x3feba00000000000ul, 0x3fc2d1610c868000ul, 0x3d039d6ccb81b4a1ul,
    0x3feb800000000000ul, 0x3fc365fcb0159000ul, 0x3cc62fa8234b7289ul,
    0x3feb400000000000ul, 0x3fc4913d8333b000ul, 0x3d25837954fdb678ul,
    0x3feb200000000000ul, 0x3fc527e5e4a1b000ul, 0x3d2633e8e5697dc7ul,
    0x3feae00000000000ul, 0x3fc6574ebe8c1000ul, 0x3d19cf8b2c3c2e78ul,
    0x3feac00000000000ul, 0x3fc6f0128b757000ul, 0xbd25118de59c21e1ul,
    0x3feaa00000000000ul, 0x3fc7898d85445000ul, 0xbd1c661070914305ul,
    0x3fea600000000000ul, 0x3fc8beafeb390000ul, 0xbd073d54aae92cd1ul,
    0x3fea400000000000ul, 0x3fc95a5adcf70000ul, 0x3d07f22858a0ff6ful,
    0x3fea000000000000ul, 0x3fca93ed3c8ae000ul, 0xbd28724350562169ul,
    0x3fe9e00000000000ul, 0x3fcb31d8575bd000ul, 0xbd0c358d4eace1aaul,
    0x3fe9c00000000000ul, 0x3fcbd087383be000ul, 0xbd2d4bc4595412b6ul,
    0x3fe9a00000000000ul, 0x3fcc6ffbc6f01000ul, 0xbcf1ec72c5962bd2ul,
    0x3fe9600000000000ul, 0x3fcdb13db0d49000ul, 0xbd2aff2af715b035ul,
    0x3fe9400000000000ul, 0x3fce530effe71000ul, 0x3cc212276041f430ul,
    0x3fe9200000000000ul, 0x3fcef5ade4dd0000ul, 0xbcca211565bb8e11ul,
    0x3fe9000000000000ul, 0x3fcf991c6cb3b000ul, 0x3d1bcbecca0cdf30ul,
    0x3fe8c00000000000ul, 0x3fd07138604d5800ul, 0x3cf89cdb16ed4e91ul,
    0x3fe8a00000000000ul, 0x3fd0c42d67616000ul, 0x3d27188b163ceae9ul,
    0x3fe8800000000000ul, 0x3fd1178e8227e800ul, 0xbd2c210e63a5f01cul,
    0x3fe8600000000000ul, 0x3fd16b5ccbacf800ul, 0x3d2b9acdf7a51681ul,
    0x3fe8400000000000ul, 0x3fd1bf99635a6800ul, 0x3d2ca6ed5147bdb7ul,
    0x3fe8200000000000ul, 0x3fd214456d0eb800ul, 0x3d0a87deba46baeaul,
    0x3fe7e00000000000ul, 0x3fd2bef07cdc9000ul, 0x3d2a9cfa4a5004f4ul,
    0x3fe7c00000000000ul, 0x3fd314f1e1d36000ul, 0xbd28e27ad3213cb8ul,
    0x3fe7a00000000000ul, 0x3fd36b6776be1000ul, 0x3d116ecdb0f177c8ul,
    0x3fe7800000000000ul, 0x3fd3c25277333000ul, 0x3d183b54b606bd5cul,
    0x3fe7600000000000ul, 0x3fd419b423d5e800ul, 0x3d08e436ec90e09dul,
    0x3fe7400000000000ul, 0x3fd4718dc271c800ul, 0xbd2f27ce0967d675ul,
    0x3fe7200000000000ul, 0x3fd4c9e09e173000ul, 0xbd2e20891b0ad8a4ul,
    0x3fe7000000000000ul, 0x3fd522ae0738a000ul, 0x3d2ebe708164c759ul,
    0x3fe6e00000000000ul, 0x3fd57bf753c8d000ul, 0x3d1fadedee5d40eful,
    0x3fe6c00000000000ul, 0x3fd5d5bddf596000ul, 0xbd0a0b2a08a465dcul,
};

#define SGP_ONE 0x3ff0000000000000ul
#define SGP_NEG_ONE 0xbff0000000000000ul
#define SGP_QUIET 0x0008000000000000ul

// checkint (cuh 946-959): 0 non-integer, 1 odd integer, 2 even integer.
static inline int sgp_checkint(ulong iy)
{
    int e = int((iy >> 52) & 0x7fful);
    if (e < 0x3ff) return 0;
    if (e > 0x3ff + 52) return 2;
    if (iy & ((1ul << (0x3ff + 52 - e)) - 1ul)) return 0;
    if (iy & (1ul << (0x3ff + 52 - e))) return 1;
    return 2;
}

// zeroinfnan (cuh 960-964)
static inline bool sgp_zeroinfnan(ulong i)
{
    return 2ul * i - 1ul >= 2ul * soft64_inf() - 1ul;
}

// log_inline (cuh 965-996): returns hi, writes tail.
static inline ulong sgp_log_inline(ulong ix, thread ulong &tail)
{
    ulong tmp = ix - 0x3fe6955500000000ul;
    uint i = uint((tmp >> (52 - 7)) % 128ul);
    int k = int(as_type<long>(tmp) >> 52);
    ulong iz = ix - (tmp & (0xffful << 52));
    ulong kd = soft64_from_i32(k);
    ulong invc = sgp_log_tab[3u * i], logc = sgp_log_tab[3u * i + 1u];
    ulong logctail = sgp_log_tab[3u * i + 2u];
    ulong r = soft64_fma(iz, invc, SGP_NEG_ONE);
    ulong t1 = soft64_fma(kd, SGP_LOG_LN2HI, logc);
    ulong t2 = soft64_add(t1, r);
    ulong lo1 = soft64_fma(kd, SGP_LOG_LN2LO, logctail);
    ulong lo2 = soft64_add(soft64_sub(t1, t2), r);
    ulong ar = soft64_mul(sgp_log_poly[0], r);
    ulong ar2 = soft64_mul(r, ar);
    ulong ar3 = soft64_mul(r, ar2);
    ulong hi = soft64_add(t2, ar2);
    ulong lo3 = soft64_fma(ar, r, soft64_negate_bits(ar2));
    ulong lo4 = soft64_add(soft64_sub(t2, hi), ar2);
    ulong p = soft64_fma(ar2,
        soft64_fma(ar2, soft64_fma(r, sgp_log_poly[6], sgp_log_poly[5]),
                   soft64_fma(r, sgp_log_poly[4], sgp_log_poly[3])),
        soft64_fma(r, sgp_log_poly[2], sgp_log_poly[1]));
    ulong lo = soft64_fma(ar3, p,
        soft64_add(soft64_add(soft64_add(lo1, lo2), lo3), lo4));
    ulong y = soft64_add(hi, lo);
    tail = soft64_add(soft64_sub(hi, y), lo);
    return y;
}

// specialcase (cuh 998-1027)
static inline ulong sgp_specialcase(ulong tmp, ulong sbits, ulong ki)
{
    if ((ki & 0x80000000ul) == 0ul) {
        sbits -= 1009ul << 52;
        ulong y = soft64_fma(sbits, tmp, sbits);
        return soft64_mul(y, 0x7f00000000000000ul); // 0x1p1009
    }
    sbits += 1022ul << 52;
    ulong scale = sbits;
    ulong y = soft64_add(scale, soft64_mul(scale, tmp));
    if (soft64_less(soft64_abs_bits(y), SGP_ONE)) {
        ulong one = SGP_ONE;
        if (soft64_sign(y) && !soft64_is_zero(y)) one = SGP_NEG_ONE;
        ulong lo = soft64_add(soft64_sub(scale, y), soft64_mul(scale, tmp));
        ulong hi = soft64_add(one, y);
        lo = soft64_add(soft64_add(soft64_sub(one, hi), y), lo);
        y = soft64_sub(soft64_add(hi, lo), one);
        if (soft64_is_zero(y)) y = sbits & 0x8000000000000000ul;
    }
    return soft64_mul(0x0010000000000000ul, y); // 0x1p-1022
}

// exp_inline (cuh 1028-1067)
static inline ulong sgp_exp_inline(ulong x, ulong xtail, uint sign_bias)
{
    uint abstop = uint(x >> 52) & 0x7ffu;
    if (abstop - 0x3c9u >= 0x408u - 0x3c9u) {
        if (abstop - 0x3c9u >= 0x80000000u) {
            ulong one = soft64_add(SGP_ONE, x);
            return sign_bias ? soft64_negate_bits(one) : one;
        }
        if (abstop >= 0x409u)
            return (x >> 63) ? (sign_bias ? 0x8000000000000000ul : 0ul)
                             : (sign_bias ? 0xfff0000000000000ul : soft64_inf());
        abstop = 0u;
    }
    ulong kd = soft64_fma(SGP_EXP_INVLN2N, x, SGP_EXP_SHIFT);
    ulong ki = kd;
    kd = soft64_sub(kd, SGP_EXP_SHIFT);
    ulong r = soft64_fma(kd, SGP_EXP_NEGLN2LON,
                         soft64_fma(kd, SGP_EXP_NEGLN2HIN, x));
    r = soft64_add(r, xtail);
    ulong idx = 2ul * (ki % 128ul);
    ulong top = (ki + ulong(sign_bias)) << (52 - 7);
    ulong tail = sgp_exp_tab[idx];
    ulong sbits = sgp_exp_tab[idx + 1ul] + top;
    ulong r2 = soft64_mul(r, r);
    ulong tmp = soft64_fma(soft64_mul(r2, r2),
        soft64_fma(r, sgp_exp_poly[3], sgp_exp_poly[2]),
        soft64_fma(r2, soft64_fma(r, sgp_exp_poly[1], sgp_exp_poly[0]),
                   soft64_add(tail, r)));
    if (abstop == 0u) return sgp_specialcase(tmp, sbits, ki);
    return soft64_fma(sbits, tmp, sbits);
}

// g64_pow::pow (cuh 1068-1143), reached only for non-NaN x and y, so the
// signaling-NaN and NaN-propagation branches of the original are dead here.
static inline ulong sgp_pow_core(ulong ix, ulong iy)
{
    const ulong x_orig = ix;
    uint sign_bias = 0u;
    uint topx = uint(ix >> 52), topy = uint(iy >> 52);
    if (topx - 0x001u >= 0x7ffu - 0x001u
            || (topy & 0x7ffu) - 0x3beu >= 0x43eu - 0x3beu) {
        if (sgp_zeroinfnan(iy)) {
            if (2ul * iy == 0ul) return SGP_ONE;
            if (ix == SGP_ONE) return SGP_ONE;
            if (2ul * ix == 2ul * SGP_ONE) return SGP_ONE;
            if ((2ul * ix < 2ul * SGP_ONE) == ((iy >> 63) == 0ul)) return 0ul;
            return soft64_mul(iy, iy);
        }
        if (sgp_zeroinfnan(ix)) {
            ulong x2 = soft64_mul(ix, ix);
            if ((ix >> 63) && sgp_checkint(iy) == 1) {
                x2 = soft64_negate_bits(x2);
                sign_bias = 1u;
            }
            return (iy >> 63) ? soft64_div(SGP_ONE, x2) : x2;
        }
        if (ix >> 63) {
            int yint = sgp_checkint(iy);
            if (yint == 0) return 0xfff8000000000000ul; // __math_invalid
            if (yint == 1) sign_bias = 0x800u << 7;
            ix &= 0x7ffffffffffffffful;
            topx &= 0x7ffu;
        }
        if ((topy & 0x7ffu) - 0x3beu >= 0x43eu - 0x3beu) {
            if (ix == SGP_ONE) return SGP_ONE;
            if ((topy & 0x7ffu) < 0x3beu)
                return ix > SGP_ONE ? soft64_add(SGP_ONE, iy)
                                    : soft64_sub(SGP_ONE, iy);
            // __math_oflow(0) / __math_uflow(0)
            return (ix > SGP_ONE) == (topy < 0x800u) ? soft64_inf() : 0ul;
        }
        if (topx == 0u) {
            ix = soft64_mul(x_orig, 0x4330000000000000ul) // 0x1p52
                 & 0x7ffffffffffffffful;
            ix -= 52ul << 52;
        }
    }
    ulong lo;
    ulong hi = sgp_log_inline(ix, lo);
    ulong ehi = soft64_mul(iy, hi);
    ulong elo = soft64_fma(iy, lo,
                           soft64_fma(iy, hi, soft64_negate_bits(ehi)));
    return sgp_exp_inline(ehi, elo, sign_bias);
}

// glibc_pow (cuh ~2920-2933): NaN handling wrapper, then pow.
static inline ulong soft_glibc_pow64(ulong ix, ulong iy)
{
    const ulong absx = ix & 0x7ffffffffffffffful;
    const ulong absy = iy & 0x7ffffffffffffffful;
    if (absx > 0x7ff0000000000000ul) {
        if ((iy << 1) == 0ul && (ix & SGP_QUIET)) return SGP_ONE;
        ulong q = ix | SGP_QUIET;
        if (absy != 0ul && absy < 0x7ff0000000000000ul && (ix >> 63)
                && sgp_checkint(iy) == 1)
            q ^= 0x8000000000000000ul;
        return q;
    }
    if (absy > 0x7ff0000000000000ul) {
        if (ix == SGP_ONE && (iy & SGP_QUIET)) return SGP_ONE;
        return iy | SGP_QUIET;
    }
    return sgp_pow_core(ix, iy);
}

#endif // WOOF_SOFT_GLIBC_POW64_METALH
