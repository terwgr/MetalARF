void wrf_smag3d_km(device const Exact32* u, device const Exact32* v, device const Exact32* w, device const Exact32* php, device const Exact32* phb, device const Exact32* alt, device const Exact32* qv, device const Exact32* msft, device const Exact32* msfu, device const Exact32* msfv, device const Exact32* fnm, device const Exact32* fnp, device const Exact32* dn, device const Exact32* dnw, Exact32 rdx, Exact32 rdy, Exact32 dx, Exact32 dy, Exact32 cf1, Exact32 cf2, Exact32 cf3, int moist,
                   Exact32 c_s, Exact32 prandtl, Exact32 dt, Exact32 mix_upper_bound,
                   int isotropic,
                   device const Exact32* d11a, device const Exact32* d22a, device const Exact32* d12a,
                   device const Exact32* bn2,
                   device Exact32* xkmh, device Exact32* xkhh, device Exact32* xkmv, device Exact32* xkhv,
                   int nz, int ny, int nx, int phb3d,
                   int boundary_x, int boundary_y, int i, int j, int k)
{



    if (i >= nx || j >= ny || k >= nz) return;
    WrfSmagGrid q = wrf_grid(u, v, w, php, phb, alt, qv, msft, msfu, msfv, fnm, fnp, dn, dnw, rdx, rdy, dx, dy, cf1, cf2, cf3, nz, ny, nx, phb3d, boundary_x, boundary_y, moist);
    Exact32 d11 = wrf_d(q, d11a, k, j, i);
    Exact32 d22 = wrf_d(q, d22a, k, j, i);
    Exact32 d33 = 2.0f * (q.w[((ulong)(k + 1) * (ny) * (nx) + (ulong)(j) * (nx) + (i))]
                       - q.w[((ulong)(k) * (ny) * (nx) + (ulong)(j) * (nx) + (i))])
             * wrf_rdzw(q, k, j, i);
    Exact32 d12 = 0.25f * (wrf_d(q, d12a, k, j, i)
                         + wrf_d(q, d12a, k, j + 1, i)
                         + wrf_d(q, d12a, k, j, i + 1)
                         + wrf_d(q, d12a, k, j + 1, i + 1));
    Exact32 d13 = 0.25f * (wrf_defor13(q, k + 1, j, i)
                         + wrf_defor13(q, k, j, i)
                         + wrf_defor13(q, k + 1, j, i + 1)
                         + wrf_defor13(q, k, j, i + 1));
    Exact32 d23 = 0.25f * (wrf_defor23(q, k + 1, j, i)
                         + wrf_defor23(q, k, j, i)
                         + wrf_defor23(q, k + 1, j + 1, i)
                         + wrf_defor23(q, k, j + 1, i));
    Exact32 def2 = 0.5f * (d11 * d11 + d22 * d22 + d33 * d33)
              + d12 * d12 + d13 * d13 + d23 * d23;
    Exact32 tmp = exact_gfk_pow((exact_max(0.0f, def2 - bn2[((ulong)(k) * (ny) * (nx) + (ulong)(j) * (nx) + (i))] / prandtl)), 0.5f);
    Exact32 map = msft[(SmagIndex)wrf_iy(q, j) * nx + wrf_ix(q, i)];
    Exact32 dxm = dx / map, dym = dy / map;
    Exact32 rdzw_c = wrf_rdzw(q, k, j, i);
    Exact32 kmh, kmv, khh, khv;
    Exact32 area = dx / map * dy / map;
    (void)dxm;
    (void)dym;
    if (isotropic == 0) {
        Exact32 mlen_h = exact_sqrt(area);
        Exact32 mlen_v = 1.0f / rdzw_c;
        kmh = exact_max(c_s * c_s * mlen_h * mlen_h * tmp, 1.0e-6f * mlen_h * mlen_h);
        kmh = exact_min(kmh, mix_upper_bound * mlen_h * mlen_h / dt);
        kmv = exact_max(c_s * c_s * mlen_v * mlen_v * tmp, 1.0e-6f * mlen_v * mlen_v);
        kmv = exact_min(kmv, mix_upper_bound * mlen_v * mlen_v / dt);
        khh = exact_min(kmh / prandtl, mix_upper_bound * mlen_h * mlen_h / dt);
        khv = exact_min(kmv / prandtl, mix_upper_bound * mlen_v * mlen_v / dt);
    } else {
        Exact32 deltas = exact_gfk_pow((area / rdzw_c), (0.33333333f));
        kmh = exact_max(c_s * c_s * deltas * deltas * tmp, 1.0e-6f * deltas * deltas);
        kmh = exact_min(kmh, mix_upper_bound * dx / map * dy / map / dt);
        kmv = exact_min(kmh, mix_upper_bound / rdzw_c / rdzw_c / dt);
        khh = exact_min(kmh / prandtl, mix_upper_bound * dx / map * dy / map / dt);
        khv = exact_min(kmv / prandtl, mix_upper_bound / rdzw_c / rdzw_c / dt);
    }
    xkmh[((ulong)(k) * (ny) * (nx) + (ulong)(j) * (nx) + (i))] = kmh;
    xkmv[((ulong)(k) * (ny) * (nx) + (ulong)(j) * (nx) + (i))] = kmv;
    xkhh[((ulong)(k) * (ny) * (nx) + (ulong)(j) * (nx) + (i))] = khh;
    xkhv[((ulong)(k) * (ny) * (nx) + (ulong)(j) * (nx) + (i))] = khv;
}

Exact32 wrf_tke_deltas(Exact32 dx, Exact32 dy, Exact32 map, Exact32 rdzw_c)
{
    return exact_gfk_pow(exact_div(exact_div(dx, map) * dy, map) / rdzw_c,
                   0.33333333f);
}

Exact32 wrf_tke_hcap(Exact32 mix_upper_bound, Exact32 dx, Exact32 dy, Exact32 map, Exact32 dt)
{
    return exact_div(exact_div(mix_upper_bound * dx, map) * dy, map) / dt;
}

Exact32 wrf_l_scale(Exact32 tke_v, Exact32 bn2_v, Exact32 deltas)
{
    Exact32 l = deltas;
    if (bn2_v > 1.0e-6f) {
        Exact32 tmp = exact_sqrt(exact_max(tke_v, 1.0e-6f));
        l = 0.76f * tmp / exact_sqrt(bn2_v);
        l = exact_min(l, deltas);
        l = exact_max(l, 0.001f * deltas);
    }
    return l;
}

Exact32 wrf_theta_full(thread const WrfSmagGrid& q, device const Exact32* thp, device const Exact32* thb,
                    int thb3d, int k, int j, int i)
{
    int jj = wrf_iy(q, j), ii = wrf_ix(q, i);
    SmagIndex h = ((ulong)(k) * (q.ny) * (q.nx) + (ulong)(jj) * (q.nx) + (ii));
    return (thb3d ? thb[h] : thb[k]) + thp[h];
}
void wrf_tke_km(device const Exact32* u, device const Exact32* v, device const Exact32* w, device const Exact32* php, device const Exact32* phb, device const Exact32* alt, device const Exact32* qv, device const Exact32* msft, device const Exact32* msfu, device const Exact32* msfv, device const Exact32* fnm, device const Exact32* fnp, device const Exact32* dn, device const Exact32* dnw, Exact32 rdx, Exact32 rdy, Exact32 dx, Exact32 dy, Exact32 cf1, Exact32 cf2, Exact32 cf3, int moist,
                device const Exact32* thp, device const Exact32* thb, int thb3d,
                device const Exact32* p, device const Exact32* tke, device const Exact32* bn2,
                Exact32 c_k, Exact32 prandtl, Exact32 dt, Exact32 mix_upper_bound,
                int isotropic, Exact32 tke_seed,
                device Exact32* xkmh, device Exact32* xkhh, device Exact32* xkmv, device Exact32* xkhv,
                int nz, int ny, int nx, int phb3d,
                int boundary_x, int boundary_y, int i, int j, int k)
{



    if (i >= nx || j >= ny || k >= nz) return;
    WrfSmagGrid q = wrf_grid(u, v, w, php, phb, alt, qv, msft, msfu, msfv, fnm, fnp, dn, dnw, rdx, rdy, dx, dy, cf1, cf2, cf3, nz, ny, nx, phb3d, boundary_x, boundary_y, moist);
    SmagIndex idx = ((ulong)(k) * (ny) * (nx) + (ulong)(j) * (nx) + (i));
    Exact32 map = msft[(SmagIndex)j * nx + i];
    Exact32 dxm = dx / map;
    Exact32 rdzw_c = wrf_rdzw(q, k, j, i);
    Exact32 tmp = exact_sqrt(exact_max(tke[idx], tke_seed));
    Exact32 kmh, kmv, khh, khv;
    if (isotropic == 0) {
        Exact32 theta_c = wrf_theta_full(q, thp, thb, thb3d, k, j, i);
        Exact32 dthrdn;
        if (k == 0) {
            Exact32 tmpdz = 1.0f / wrf_rdzw(q, 1, j, i)
                       + 1.0f / wrf_rdzw(q, 0, j, i);
            Exact32 z0 = exact_div(wrf_phi(q, 0, j, i), 9.81f);
            Exact32 z1 = wrf_phy_z(q, 0, j, i);
            Exact32 z2 = wrf_phy_z(q, 1, j, i);
            Exact32 w1 = (z0 - z2) / (z1 - z2);
            Exact32 w2 = 1.0f - w1;
            Exact32 t0 = wrf_theta_full(q, thp, thb, thb3d, 0, j, i)
                    * exact_gfk_pow(exact_div(p[((ulong)(0) * (ny) * (nx) + (ulong)(j) * (nx) + (i))], 100000.0f), 0.2857142857142857f);
            Exact32 t1 = wrf_theta_full(q, thp, thb, thb3d, 1, j, i)
                    * exact_gfk_pow(exact_div(p[((ulong)(1) * (ny) * (nx) + (ulong)(j) * (nx) + (i))], 100000.0f), 0.2857142857142857f);
            Exact32 p8w0 = w1 * p[((ulong)(0) * (ny) * (nx) + (ulong)(j) * (nx) + (i))] + w2 * p[((ulong)(1) * (ny) * (nx) + (ulong)(j) * (nx) + (i))];
            Exact32 t8w0 = w1 * t0 + w2 * t1;
            Exact32 thetasfc = t8w0 / exact_gfk_pow(exact_div(p8w0, 100000.0f), 0.2857142857142857f);
            Exact32 th1 = wrf_theta_full(q, thp, thb, thb3d, 1, j, i);
            dthrdn = (th1 - thetasfc) / tmpdz;
        } else if (k == nz - 1) {
            Exact32 tmpdz = 1.0f / wrf_rdz(q, nz - 1, j, i)
                       + 0.5f / wrf_rdzw(q, nz - 1, j, i);
            Exact32 z0 = exact_div(wrf_phi(q, nz, j, i), 9.81f);
            Exact32 z1 = wrf_phy_z(q, nz - 1, j, i);
            Exact32 z2 = wrf_phy_z(q, nz - 2, j, i);
            Exact32 w1 = (z0 - z2) / (z1 - z2);
            Exact32 w2 = 1.0f - w1;
            Exact32 tm1 = wrf_theta_full(q, thp, thb, thb3d, nz - 1, j, i)
                     * exact_gfk_pow(exact_div(p[((ulong)(nz - 1) * (ny) * (nx) + (ulong)(j) * (nx) + (i))], 100000.0f), 0.2857142857142857f);
            Exact32 tm2 = wrf_theta_full(q, thp, thb, thb3d, nz - 2, j, i)
                     * exact_gfk_pow(exact_div(p[((ulong)(nz - 2) * (ny) * (nx) + (ulong)(j) * (nx) + (i))], 100000.0f), 0.2857142857142857f);
            Exact32 p8wt = exact_gfk_exp(w1 * exact_gfk_log(p[((ulong)(nz - 1) * (ny) * (nx) + (ulong)(j) * (nx) + (i))])
                                + w2 * exact_gfk_log(p[((ulong)(nz - 2) * (ny) * (nx) + (ulong)(j) * (nx) + (i))]));
            Exact32 t8wt = w1 * tm1 + w2 * tm2;
            Exact32 thetatop = t8wt / exact_gfk_pow(exact_div(p8wt, 100000.0f), 0.2857142857142857f);
            Exact32 thm1 = wrf_theta_full(q, thp, thb, thb3d, nz - 2, j, i);
            dthrdn = (thetatop - thm1) / tmpdz;
        } else {
            Exact32 tmpdz = 1.0f / wrf_rdz(q, k + 1, j, i)
                       + 1.0f / wrf_rdz(q, k, j, i);
            Exact32 thp1 = wrf_theta_full(q, thp, thb, thb3d, k + 1, j, i);
            Exact32 thm1 = wrf_theta_full(q, thp, thb, thb3d, k - 1, j, i);
            dthrdn = (thp1 - thm1) / tmpdz;
        }
        Exact32 mlen_h = exact_sqrt(exact_div(dxm * dy, map));
        Exact32 deltas = 1.0f / rdzw_c;
        Exact32 mlen_v = deltas;
        if (dthrdn > 0.0f) {
            Exact32 mlen_s = 0.76f * tmp
                        / exact_gfk_pow(exact_abs(9.81f / theta_c * dthrdn), 0.5f);
            mlen_v = exact_min(mlen_v, mlen_s);
        }
        kmh = exact_max(c_k * tmp * mlen_h, 1.0e-6f * mlen_h * mlen_h);
        kmh = exact_min(kmh, mix_upper_bound * mlen_h * mlen_h / dt);
        kmv = exact_max(c_k * tmp * mlen_v, 1.0e-6f * deltas * deltas);
        kmv = exact_min(kmv, mix_upper_bound * deltas * deltas / dt);
        khh = kmh * (1.0f / prandtl);
        khv = kmv * (1.0f + 2.0f * mlen_v / deltas);
    } else {
        Exact32 deltas = wrf_tke_deltas(dx, dy, map, rdzw_c);
        Exact32 l = wrf_l_scale(tke[idx], bn2[idx], deltas);
        Exact32 hcap = wrf_tke_hcap(mix_upper_bound, dx, dy, map, dt);
        kmh = c_k * tmp * l;
        kmh = exact_min(hcap, kmh);
        kmv = c_k * tmp * l;
        kmv = exact_min(mix_upper_bound / rdzw_c / rdzw_c / dt, kmv);
        Exact32 pr_inv = 1.0f + 2.0f * l / deltas;
        khh = exact_min(hcap, kmh * pr_inv);
        khv = exact_min(mix_upper_bound / rdzw_c / rdzw_c / dt, kmv * pr_inv);
    }
    xkmh[idx] = kmh;
    xkmv[idx] = kmv;
    xkhh[idx] = khh;
    xkhv[idx] = khv;
}
void wrf_tke_rhs(device const Exact32* u, device const Exact32* v, device const Exact32* w, device const Exact32* php, device const Exact32* phb, device const Exact32* alt, device const Exact32* qv, device const Exact32* msft, device const Exact32* msfu, device const Exact32* msfv, device const Exact32* fnm, device const Exact32* fnp, device const Exact32* dn, device const Exact32* dnw, Exact32 rdx, Exact32 rdy, Exact32 dx, Exact32 dy, Exact32 cf1, Exact32 cf2, Exact32 cf3, int moist,
                 device const Exact32* thp, device const Exact32* thb, int thb3d,
                 device const Exact32* tke, device const Exact32* bn2,
                 device const Exact32* d11a, device const Exact32* d22a, device const Exact32* d12a,
                 device const Exact32* kmh_a, device const Exact32* kmv_a, device const Exact32* khv_a,
                 device const Exact32* mut, device const Exact32* c1, device const Exact32* c2,
                 device const Exact32* ustm, device const Exact32* hfx,
                 int use_ustm, int use_hfx,
                 Exact32 c_k, Exact32 dt, Exact32 cd0, Exact32 heat_flux_const,
                 int isfflx,
                 device Exact32* tend,
                 device Exact32* b_shear, device Exact32* b_buoy, device Exact32* b_diss, device Exact32* b_lim,
                 int budget,
                 int nz, int ny, int nx, int phb3d,
                 int boundary_x, int boundary_y, int i, int j, int k)
{



    if (i >= nx || j >= ny || k >= nz) return;
    if ((boundary_x && (i == 0 || i == nx - 1))
        || (boundary_y && (j == 0 || j == ny - 1))) return;
    WrfSmagGrid q = wrf_grid(u, v, w, php, phb, alt, qv, msft, msfu, msfv, fnm, fnp, dn, dnw, rdx, rdy, dx, dy, cf1, cf2, cf3, nz, ny, nx, phb3d, boundary_x, boundary_y, moist);
    SmagIndex idx = ((ulong)(k) * (ny) * (nx) + (ulong)(j) * (nx) + (i));
    Exact32 chm = c1[k] * mut[(SmagIndex)j * nx + i] + c2[k];
    Exact32 kmh = kmh_a[idx], kmv = kmv_a[idx];
    Exact32 t0 = tend[idx];
    Exact32 t = t0;
    Exact32 d11 = wrf_d(q, d11a, k, j, i);
    Exact32 d22 = wrf_d(q, d22a, k, j, i);
    t += 0.5f * chm * kmh * (d11 * d11);
    t += 0.5f * chm * kmh * (d22 * d22);
    Exact32 rdzw_c = wrf_rdzw(q, k, j, i);
    Exact32 d33 = 2.0f * (q.w[((ulong)(k + 1) * (ny) * (nx) + (ulong)(j) * (nx) + (i))]
                       - q.w[((ulong)(k) * (ny) * (nx) + (ulong)(j) * (nx) + (i))]) * rdzw_c;
    t += 0.5f * chm * kmv * (d33 * d33);
    Exact32 s12a = wrf_d(q, d12a, k, j, i);
    Exact32 s12b = wrf_d(q, d12a, k, j + 1, i);
    Exact32 s12c = wrf_d(q, d12a, k, j, i + 1);
    Exact32 s12d = wrf_d(q, d12a, k, j + 1, i + 1);
    Exact32 avg12 = 0.25f * (s12a * s12a + s12b * s12b
                          + s12c * s12c + s12d * s12d);
    t += chm * kmh * avg12;
    Exact32 s13a = wrf_defor13(q, k + 1, j, i);
    Exact32 s13b = wrf_defor13(q, k, j, i);
    Exact32 s13c = wrf_defor13(q, k + 1, j, i + 1);
    Exact32 s13d = wrf_defor13(q, k, j, i + 1);
    Exact32 chm_kmv = chm * kmv;
    t += chm_kmv * (0.25f * (s13a * s13a + s13b * s13b
                             + s13c * s13c + s13d * s13d));
    Exact32 usum = 0.0f, vsum = 0.0f, Cd = 0.0f, absU = 0.0f;
    if (k == 0) {
        usum = q.u[((ulong)(0) * (ny) * (nx + 1) + (ulong)(j) * (nx + 1) + (wrf_iu(q, i)))]
             + q.u[((ulong)(0) * (ny) * (nx + 1) + (ulong)(j) * (nx + 1) + (wrf_iu(q, i + 1)))];
        vsum = q.v[((ulong)(0) * (ny + 1) * (nx) + (ulong)(wrf_jv(q, j)) * (nx) + (i))]
             + q.v[((ulong)(0) * (ny + 1) * (nx) + (ulong)(wrf_jv(q, j + 1)) * (nx) + (i))];
        absU = 0.5f * exact_sqrt(usum * usum + vsum * vsum);
        if (isfflx == 0) {
            Cd = cd0;
        } else {
            absU += 1.0e-15f;
            Exact32 us = use_ustm ? ustm[(SmagIndex)j * nx + i] : 0.0f;
            Cd = (us * us) / (absU * absU);
        }
        Exact32 d13sum = wrf_defor13(q, 1, j, i) + wrf_defor13(q, 1, j, i + 1);
        t += chm * (usum * 0.5f * Cd * absU * d13sum * 0.5f);
    }
    Exact32 s23a = wrf_defor23(q, k + 1, j, i);
    Exact32 s23b = wrf_defor23(q, k, j, i);
    Exact32 s23c = wrf_defor23(q, k + 1, j + 1, i);
    Exact32 s23d = wrf_defor23(q, k, j + 1, i);
    t += chm_kmv * (0.25f * (s23a * s23a + s23b * s23b
                             + s23c * s23c + s23d * s23d));
    if (k == 0) {
        Exact32 d23sum = wrf_defor23(q, 1, j, i) + wrf_defor23(q, 1, j + 1, i);
        t += chm * (vsum * 0.5f * Cd * absU * d23sum * 0.5f);
    }
    Exact32 s_shear = t - t0;
    Exact32 khv = khv_a[idx];
    if (k >= 1) {
        t -= chm * khv * bn2[idx];
    } else {
        Exact32 heat_flux;
        if (isfflx == 0 || isfflx == 2) {
            heat_flux = heat_flux_const;
        } else {
            Exact32 vapor = moist ? qv[((ulong)(0) * (ny) * (nx) + (ulong)(j) * (nx) + (i))] : 0.0f;
            Exact32 cpm = 1004.5f * (1.0f + 0.8f * vapor);
            Exact32 hf = use_hfx ? hfx[(SmagIndex)j * nx + i] : 0.0f;
            Exact32 alt0 = q.alt[((ulong)(0) * (ny) * (nx) + (ulong)(j) * (nx) + (i))];
            Exact32 rho0 = exact_div(1.0f, alt0) * (1.0f + vapor);
            heat_flux = (hf / cpm) / rho0;
        }
        Exact32 theta_c = wrf_theta_full(q, thp, thb, thb3d, 0, j, i);
        t -= chm * ((khv * bn2[idx])
                    - (9.81f / theta_c) * heat_flux) * 0.5f;
    }
    Exact32 s_buoy = t - t0 - s_shear;
    Exact32 map = msft[(SmagIndex)j * nx + i];
    Exact32 deltas = wrf_tke_deltas(dx, dy, map, rdzw_c);
    Exact32 l = wrf_l_scale(tke[idx], bn2[idx], deltas);
    Exact32 ce1 = (exact_div(c_k, 0.10f)) * 0.19f;
    Exact32 ce2 = exact_max(0.0f, 0.93f - ce1);
    Exact32 coefc = (k == 0 || k == nz - 1) ? 3.9f
               : (ce1 + ce2 * l / deltas);
    Exact32 tketmp = exact_max(tke[idx], 1.0e-6f);
    t -= chm * coefc * exact_gfk_pow(tketmp, 1.5f) / l;
    Exact32 s_diss = t - t0 - s_shear - s_buoy;
    Exact32 t_limited = exact_max(t, -chm * exact_max(0.0f, tke[idx]) / dt);
    Exact32 s_lim = t_limited - t;
    t = t_limited;
    tend[idx] = t;
    if (budget) {
        b_shear[idx] = s_shear;
        b_buoy[idx] = s_buoy;
        b_diss[idx] = s_diss;
        b_lim[idx] = s_lim;
    }
}
}
kernel void wrf_exact_calc_n2(
    constant WrfExactCalcN2Resources &r [[buffer(0)]],
    constant WrfExactCalcN2Params &p [[buffer(1)]],
    uint gid [[thread_position_in_grid]]) {
