kernel void g3_diag(
    constant G3DiagResources &r [[buffer(0)]],
    constant G3DiagParams &prm [[buffer(1)]],
    uint gid [[thread_position_in_grid]])
{
    device const float *cloud = r.cloud;
    device const float *ice = r.ice;
    device const float *rain = r.rain;
    device const float *t = r.t;
    device const float *p = r.p;
    device const float *qv = r.qv;
    device const float *qc = r.qc;
    device const float *qi = r.qi;
    device float *ca = r.ca;
    device float *cb = r.cb;
    device float *ia = r.ia;
    device float *ib = r.ib;
    device float *frac = r.frac;
    device float *ra = r.ra;
    device float *rb = r.rb;
    device const int *clock = r.clock;
    const int fqi = prm.fqi;
    const long nvol = prm.nvol;
    const long ncol = prm.ncol;
long c = long ( gid ) ;
bool first = clock [ 2 ] != 0 , end = clock [ 3 ] != 0 ;
float count = ( float ) clock [ 1 ] ;
if ( c < ncol ) {
if ( clock [ 0 ] <= 1 ) {
ra [ c ] = 0.f ;
rb [ c ] = 0.f ;
}
if ( first ) rb [ c ] = rain [ c ] ;
ra [ c ] = ra [ c ] + rain [ c ] ;
if ( end ) {
rb [ c ] = aa_div ( ra [ c ] , count ) ;
ra [ c ] = 0.f ;
}
}
if ( c >= nvol ) return ;
if ( clock [ 0 ] <= 1 ) {
ia [ c ] = 0.f ;
frac [ c ] = 0.f ;
}
if ( first ) {
cb [ c ] = cloud [ c ] ;
ib [ c ] = ice [ c ] ;
}
ca [ c ] = ca [ c ] + cloud [ c ] ;
ia [ c ] = ia [ c ] + ice [ c ] ;
if ( end ) {
cb [ c ] = aa_div ( .1f * ca [ c ] , count ) ;
ca [ c ] = 0.f ;
ib [ c ] = aa_div ( .1f * ia [ c ] , count ) ;
ia [ c ] = 0.f ;
}
if ( first || end ) {
float satvp = aa_div ( 3.80f * gfk_exp ( aa_div ( 17.27f * ( t [ c ] - 273.f ) , ( t [ c ] - 36.f ) ) ) , ( .01f * p [ c ] ) ) ;
float rhgrid = g3max ( .1f , g3min ( .95f , aa_div ( qv [ c ] , satvp ) ) ) ;
float h2oliq = fqi ? 1000.f * ( cb [ c ] + qc [ c ] + ib [ c ] + qi [ c ] ) : 1000.f * ( cb [ c ] + qc [ c ] ) ;
satvp = 1000.f * satvp ;
float value = ( 1.f - gfk_exp ( aa_div ( - 100.f * h2oliq , gfk_pow ( ( 1.f - rhgrid ) * satvp , .49f ) ) ) ) * gfk_pow ( rhgrid , .25f ) ;
value = g3max ( 0.f , g3min ( 1.f , value ) ) ;
if ( qc [ c ] == 0.f && ( ! fqi || qi [ c ] == 0.f ) ) value = value * .2f ;
frac [ c ] = value ;
}

}

kernel void g3_pack_levels(
    constant G3PackLevelsResources &r [[buffer(0)]],
    constant G3PackLevelsParams &p [[buffer(1)]],
    uint gid [[thread_position_in_grid]])
{
    if (int(gid) >= p.ncell) return;
    const ulong c = ulong(gid);
    const ulong n = ulong(p.ncell);
    r.lev_in[0 * n + c] = r.u[c];
    r.lev_in[1 * n + c] = r.v[c];
    r.lev_in[2 * n + c] = r.t[c];
    r.lev_in[3 * n + c] = r.q[c];
    r.lev_in[4 * n + c] = r.pressure[c];
    r.lev_in[5 * n + c] = r.exner[c];
    r.lev_in[6 * n + c] = r.rho[c];
    float rthraten = r.rthlw[c] + r.rthsw[c];
    float thften = (r.thdyn[c] + rthraten + r.thbl[c]) * r.exner[c];
    float qvften = r.qvdyn[c] + r.qvbl[c];
    r.lev_in[7 * n + c] = thften;
    r.lev_in[8 * n + c] = qvften;
    r.lev_in[9 * n + c] = r.thbl[c];
    r.lev_in[10 * n + c] = r.qvbl[c];
}

kernel void g3_diag_finish(
    constant G3DiagFinishResources &r [[buffer(0)]],
    constant G3DiagFinishParams &p [[buffer(1)]],
    uint gid [[thread_position_in_grid]])
{
    if (gid == 0 && r.clock[3]) r.clock[1] = 0;
}

kernel void g3_pack_surface(
    constant G3PackSurfaceResources &r [[buffer(0)]],
    constant G3PackSurfaceParams &p [[buffer(1)]],
    uint gid [[thread_position_in_grid]])
{
    if (int(gid) >= p.ncol) return;
    const ulong c = ulong(gid);
    const ulong n = ulong(p.ncol);
    r.sfc_in[0 * n + c] = r.p8w[c];
    r.sfc_in[1 * n + c] = r.ht[c];
    r.sfc_in[2 * n + c] = r.xland[c];
    r.sfc_in[3 * n + c] = r.gsw[c];
    r.sfc_out[2 * n + c] = 1.f;
    r.sfc_out[3 * n + c] = float(p.nz);
}
