#include "hexrrfs_mynnedmf_array.metalh"
#include "hexrrfs_mynnedmf_real64.metalh"
static inline bool operator<(Exact32 a,Exact32 b) { return soft32_less(a.bits,b.bits); }
static inline bool operator<=(Exact32 a,Exact32 b) { return soft32_less_equal(a.bits,b.bits); }
static inline bool operator==(Exact32 a,Exact32 b) { return soft32_equal(a.bits,b.bits); }
static inline bool operator!=(Exact32 a,Exact32 b) { return !soft32_equal(a.bits,b.bits); }
static inline Exact32 r6_nan(Exact32 a,Exact32 b,Exact32 r) {
    if (soft32_is_nan(a.bits)) return Exact32::from_bits(a.bits|0x00400000u);
    if (soft32_is_nan(b.bits)) return Exact32::from_bits(b.bits|0x00400000u);
    if (soft32_is_nan(r.bits)) return Exact32::from_bits(0xffc00000u);
    return r;
}
static inline Exact32 r6_add(Exact32 a,Exact32 b) { return r6_nan(a,b,a+b); }
static inline Exact32 r6_sub(Exact32 a,Exact32 b) { return r6_nan(a,b,a-b); }
static inline Exact32 r6_mul(Exact32 a,Exact32 b) { return r6_nan(a,b,a*b); }
static inline Exact32 r6_div(Exact32 a,Exact32 b) { return r6_nan(a,b,a/b); }
static inline Exact32 r6_neg(Exact32 a) { return -a; }
static inline Exact32 r6_neg(float a) { return -Exact32(a); }
template<class T> T mynn_min(T a,T b) { return a<b?a:b; }
template<class T> T mynn_max(T a,T b) { return a>b?a:b; }
template<class T,int R> T mynn_minval(MynnArray<T,R> a) { T v=a.linear(0);for(int i=1;i<a.size();++i)v=mynn_min(v,a.linear(i));return v; }
template<class T,int R> T mynn_maxval(MynnArray<T,R> a) { T v=a.linear(0);for(int i=1;i<a.size();++i)v=mynn_max(v,a.linear(i));return v; }
static inline Exact32 mynn_sqrt(Exact32 a) { return r6_nan(a,Exact32(0.f),exact_sqrt(a)); }
static inline Exact32 mynn_abs(Exact32 a) { return exact_abs(a); }
static inline int mynn_abs(int a) { return a<0?-a:a; }
static inline Exact32 mynn_sign(Exact32 a,Exact32 b) { return Exact32::from_bits((a.bits&0x7fffffffu)|(b.bits&0x80000000u)); }
template<int N> Exact32 mynn_ipow(Exact32 a) { Exact32 xx=r6_mul(a,a);return N==2?xx:r6_mul(xx,a); }
template<int N> Exact32 mynn_ipow(float a) { return mynn_ipow<N>(Exact32(a)); }
template<int N> Mynn64 mynn_ipow(Mynn64 a) { Mynn64 xx=mynn_dmul(a,a);return N==2?xx:mynn_dmul(xx,a); }
#include "hexrrfs_mynnedmf_math32.metalh"
#include "hexrrfs_mynnedmf_erf.metalh"
// Finite in-range round-up; invalid inputs return a provisional sentinel.
static inline int mynn_ceiling(Exact32 a) {
    ulong x=soft64_from_f32_bits(a.bits);
    Soft64I32Result r=soft64_to_i32_rz(x);
    if(!r.valid)return as_type<int>(0x80000000u);
    if(soft64_greater(x,soft64_from_i32(r.value))) {
        if(r.value==0x7fffffff)return as_type<int>(0x80000000u);
        return r.value+1;
    }
    return r.value;
}
struct MynnText {
    constant char *text="";
    MynnText()=default;
    MynnText(constant char *s):text(s) {}
    thread MynnText &operator=(constant char *s) { text=s;return *this; }
    bool operator==(thread const MynnText &b) const {
        int i=0;while(text[i]&&text[i]==b.text[i])++i;return text[i]==b.text[i];
    }
};
