z . re = re ;
z . im = im ;
return z ;
}

static inline tcplx tc_add ( tcplx a , tcplx b ) {
return tc_make ( a . re + b . re , a . im + b . im ) ;
}

static inline tcplx tc_sub ( tcplx a , tcplx b ) {
return tc_make ( a . re - b . re , a . im - b . im ) ;
}

static inline tcplx tc_mul ( tcplx a , tcplx b ) {
return tc_make ( a . re * b . re - a . im * b . im , a . re * b . im + a . im * b . re ) ;
}

