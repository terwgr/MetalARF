}
Soft8 r = aa_div ( b . re , b . im ) ;
Soft8 den = b . re * r + b . im ;
return tc_make ( aa_div ( ( a . re * r + a . im ) , den ) , aa_div ( ( a . im * r - a . re ) , den ) ) ;
}

static inline Soft8 tc_abs ( tcplx a ) {
return thompson_aa_hypot ( a . re , a . im ) ;
}

static inline tcplx tc_conj ( tcplx a ) {
return tc_make ( a . re , - a . im ) ;
}

