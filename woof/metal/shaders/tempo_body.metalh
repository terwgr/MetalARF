static inline Soft8 tempo_cloud_number ( Soft8 qc , Soft8 qr , Soft8 qi , Soft8 qs , Soft8 pressure , Soft8 temperature , Soft8 w ) {
const Soft8 input [ 7 ] = {
qc , qr , qi , qs , pressure , temperature , w }
;
Soft8 transformed [ 7 ] , activated [ 24 ] ;
for ( int i = 0 ;
i < 7 ;
++ i ) transformed [ i ] = aa_div ( ( input [ i ] - tempo_nc_ml_trans_mean ( i ) ) , sqrt ( tempo_nc_ml_trans_var ( i ) ) ) ;
for ( int node = 0 ;
node < 24 ;
++ node ) {
Soft8 value = SD8 ( 0x0000000000000000ul ) ;
for ( int i = 0 ;
i < 7 ;
++ i ) value += tempo_nc_ml_w00 ( node + 24 * i ) * transformed [ i ] ;
activated [ node ] = tmax ( value + tempo_nc_ml_b00 ( node ) , SD8 ( 0x0000000000000000ul ) ) ;
}
Soft8 value = SD8 ( 0x0000000000000000ul ) ;
for ( int node = 0 ;
node < 24 ;
++ node ) value += tempo_nc_ml_w01 ( node ) * activated [ node ] ;
value = tmax ( value + tempo_nc_ml_b01 ( 0 ) , SD8 ( 0x0000000000000000ul ) ) ;
const Soft8 p = tmin ( SD8 ( 0x40229a209a854b05ul ) , tmax ( - SD8 ( 0x4018000000000000ul ) , value ) ) ;
Soft8 bias = SD8 ( 0x3ff0000000000000ul ) ;
if ( p >= SD8 ( 0x0000000000000000ul ) && p < SD8 ( 0x4008000000000000ul ) ) {
const Soft8 p2 = p * p , p3 = p2 * p , p4 = p2 * p2 , p5 = p4 * p ;
bias = - SD8 ( 0x3fd14e3bcd35a858ul ) * p5 + SD8 ( 0x3ffd6872b020c49cul ) * p4 - SD8 ( 0x4014820c49ba5e35ul ) * p3 + SD8 ( 0x40211810624dd2f2ul ) * p2 - SD8 ( 0x4020e0c49ba5e354ul ) * p + SD8 ( 0x40113020c49ba5e3ul ) ;
}
return bias * tempo_pow ( SD8 ( 0x4024000000000000ul ) , p ) ;
}

template < typename P_qc , typename P_qr , typename P_qi , typename P_qs , typename P_nc , typename P_w , typename P_qc_bl , typename P_fraction_bl > static inline void tempo_subgrid_cloud_radii ( thread const TempoParams & P , thread const TempoCtx & C , int nz , device TempoWork & W , P_qc qc , P_qr qr , P_qi qi , P_qs qs , P_nc nc , P_w w , P_qc_bl qc_bl , P_fraction_bl fraction_bl , int nt , int c0 ) {
if ( ! W . did_micro || ! C . re_cloud_flag || ! C . re_ice_flag || ! C . re_snow_flag ) return ;
for ( int k = 1 ;
k <= nz ;
++ k ) {
const long index = ( long ) ( k - 1 ) * nt + c0 ;
W . xrx [ k ] = qc [ k ] ;
if ( qc [ k ] <= ( P . L [ TOFF_r1 + ( 0 ) ] ) && qc_bl [ index ] > SD8 ( 0x3e112e0be826d695ul ) && fraction_bl [ index ] > SD8 ( 0x0000000000000000ul ) ) W . xrx [ k ] += aa_div ( ( Soft8 ) qc_bl [ index ] , ( Soft8 ) fraction_bl [ index ] ) ;
if ( W . xrx [ k ] <= SD8 ( 0x3d719799812dea11ul ) ) W . xrx [ k ] = SD8 ( 0x0000000000000000ul ) ;
W . xncx [ k ] = tempo_cloud_number ( W . xrx [ k ] , qr [ k ] , qi [ k ] , qs [ k ] , W . pres [ k ] , W . temp [ k ] , w [ k ] ) ;
W . qcten [ k ] = SD8 ( 0x0000000000000000ul ) ;
W . ncten [ k ] = SD8 ( 0x0000000000000000ul ) ;
}
cloud_check_and_update ( P , C , nz , W . rho , W . l_qc , W . xrx , W . xncx , ( thread const Soft8 * ) nullptr , W . rc , W . nc , W . qcten , W . ncten , W . ilamc , W . mvd_c ) ;
effective_radius ( P , C , nz , W . temp , W . l_qc , W . nc , W . ilamc , W . l_qi , W . ilami , W . l_qs , W . rs , W . re_cloud , W . re_ice , W . re_snow ) ;
}

