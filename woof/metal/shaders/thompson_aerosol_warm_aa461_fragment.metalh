template < typename P_snow_cloud_efficiency , typename P_out > static inline void thompson_aa_frozen_collect_rates ( float qs_v , float qg_v , float graupel_number_per_kg_v , bool l_qc , float cloud_mass , float cloud_number , float cloud_mvd , float nwfa_m3 , float nifa_m3 , float rho , float temp_k , float wet_bulb , float rho_factor , float inverse_dt , P_snow_cloud_efficiency snow_cloud_efficiency , P_out out ) {
