template < typename P_lu , typename P_snowc , typename P_xice , typename P_snoalb , typename P_initial_albbck , typename P_table , typename P_out , typename P_ivg , typename P_status > static inline void sfire_ideal_landuse_body ( P_lu lu , P_snowc snowc , P_xice xice , P_snoalb snoalb , P_initial_albbck initial_albbck , P_table table , P_out out , P_ivg ivg , P_status status , int n , int cats , int seas , int season , int iswater , int isice , int fractional , int monalb , int nodata , uint gid ) {
int p = 0 * 1 + gid ;
if ( p >= n ) return ;
F value = lu [ p ] ;
int category = value >= SF(0x00000000u) ? ( int ) floorf ( __fadd_rn ( value , SF(0x3f000000u) ) ) : ( int ) ceilf ( __fsub_rn ( value , SF(0x3f000000u) ) ) ;
ivg [ p ] = category ;
status [ p ] = 0 ;
if ( category == 0 ) {
category = iswater > 0 ? iswater : nodata ;
if ( iswater == 0 && nodata > 0 ) ivg [ p ] = nodata ;
}
if ( category < 1 || category > cats || isice < 1 || isice > cats ) {
status [ p ] = 1 ;
return ;
}
int r = ( ( season - 1 ) * cats + category - 1 ) * 7 ;
F albbck = monalb ? initial_albbck [ p ] : __fdiv_rn ( table [ r ] , SF(0x42c80000u) ) ;
F albedo = albbck ;
if ( snowc [ p ] > SF(0x3f000000u) ) albedo = monalb ? snoalb [ p ] : __fmul_rn ( albbck , __fadd_rn ( SF(0x3f800000u) , table [ ( ( seas - 1 ) * cats + category - 1 ) * 7 + 5 ] ) ) ;
F thc = __fdiv_rn ( table [ r + 4 ] , SF(0x42c80000u) ) , z0 = __fdiv_rn ( table [ r + 3 ] , SF(0x42c80000u) ) , embck = table [ r + 2 ] , emiss = embck , mavail = table [ r + 1 ] ;
F land = category == iswater ? SF(0x40000000u) : SF(0x3f800000u) ;
F threshold = fractional ? SF(0x3ca3d70au) : SF(0x3f000000u) ;
if ( xice [ p ] >= threshold ) {
land = SF(0x3f800000u) ;
r = ( ( season - 1 ) * cats + isice - 1 ) * 7 ;
albbck = __fdiv_rn ( table [ r ] , SF(0x42c80000u) ) ;
embck = table [ r + 2 ] ;
if ( fractional ) {
albedo = __fadd_rn ( __fmul_rn ( xice [ p ] , albbck ) , __fmul_rn ( __fsub_rn ( SF(0x3f800000u) , xice [ p ] ) , SF(0x3da3d70au) ) ) ;
emiss = __fadd_rn ( __fmul_rn ( xice [ p ] , embck ) , __fmul_rn ( __fsub_rn ( SF(0x3f800000u) , xice [ p ] ) , SF(0x3f7ae148u) ) ) ;
}
else {
albedo = albbck ;
emiss = embck ;
}
thc = __fdiv_rn ( table [ r + 4 ] , SF(0x42c80000u) ) ;
z0 = __fdiv_rn ( table [ r + 3 ] , SF(0x42c80000u) ) ;
mavail = table [ r + 1 ] ;
}
out [ p ] = albedo ;
out [ n + p ] = albbck ;
out [ 2 * n + p ] = mavail ;
out [ 3 * n + p ] = emiss ;
out [ 4 * n + p ] = embck ;
out [ 5 * n + p ] = z0 ;
out [ 6 * n + p ] = z0 ;
out [ 7 * n + p ] = thc ;
out [ 8 * n + p ] = land ;
out [ 9 * n + p ] = xice [ p ] ;
out [ 10 * n + p ] = land < SF(0x3fc00000u) ? SF(0x3f800000u) : SF(0x00000000u) ;
}

