template < typename P_temperature , typename P_theta , typename P_qv , typename P_pressure , typename P_coeff , typename P_t2 , typename P_th2 , typename P_q2 , typename P_psfc > static inline void sfire_moisture_surface_diagnostics_body ( P_temperature temperature , P_theta theta , P_qv qv , P_pressure pressure , P_coeff coeff , P_t2 t2 , P_th2 th2 , P_q2 q2 , P_psfc psfc , int n , uint gid ) {
