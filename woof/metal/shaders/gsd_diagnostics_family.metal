                 cft1,cft2,rdx,rdy,mm,k,cy,cx,nz,ny,nx);
}

kernel void gsd_uh_columns(constant GsdUhColumnsResources &r [[buffer(0)]],
    constant GsdUhColumnsParams &prm [[buffer(1)]],
    uint tid [[thread_position_in_grid]]) {
    device const float* w = r.w;
    device const float* ph = r.ph;
    device const float* phb = r.phb;
    int phb3d = prm.phb3d;
    device const float* ht = r.ht;
    device const float* rv = r.rv;
    device float* uh = r.uh;
    device float* usecol = r.usecol;
    float lower = prm.lower;
    float upper = prm.upper;
    int nz = prm.nz;
    int ny = prm.ny;
    int nx = prm.nx;
 int c=int(tid),n=nx*ny;if(c>=n)return;
 int cy=c/nx,cx=c%nx;float sum=0.f,use=1.f;
 if(cx==0||cy==0){uh[c]=0.f;usecol[c]=1.f;return;}
 float zl=uh_agl(ph,phb,phb3d,ht,0,cy,cx,ny,nx);
 for(int k=0;k<nz;k++){
  float zu=uh_agl(ph,phb,phb3d,ht,k+1,cy,cx,ny,nx);
  if(zl>=lower&&zu<=upper){
   float wa=uh_wavg(w,k,cy,cx,ny,nx);
   float wb=k+1<nz?uh_wavg(w,k+1,cy,cx,ny,nx):0.f;
   float rb=k+1<nz?rv[(k+1)*n+c]:0.f;
   if(wa>0.f&&wb>0.f){
    float pair=__fmul_rn(__fadd_rn(__fmul_rn(wa,rv[k*n+c]),__fmul_rn(wb,rb)),.5f);
    sum=__fadd_rn(sum,__fmul_rn(pair,__fsub_rn(zu,zl)));
   }else{use=0.f;sum=0.f;}
  }
  zl=zu;
 }
