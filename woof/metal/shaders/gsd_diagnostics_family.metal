 float s=qs>0.f?M(M(gfk_pow(M(qs,rho),1.75f),2.185e-10f),1.e18f):0.f;
 float g=qg>0.f?M(M(gfk_pow(M(qg,rho),1.75f),1.033267e-9f),1.e18f):0.f;
 float z=A(A(r,s),g);if(z>0.f)z=M(10.f,gfk_log10(z));return fmaxf(-10.f,z);
}

static inline float gd_hail(float mass) {
 if(mass<1.e-6f)return 0.f;
 float xam=M(D(3.1415926536f,6.f),500.f);
 float zans=A(2.5f,M(D(2.f,7.f),A(gfk_log10(mass),7.f)));
 zans=fmaxf(2.f,fminf(zans,7.f));
 HailR8 n0=HailR8(gfk_pow(10.f,zans));
 HailR8 lam_exp=glibc_pow(n0*HailR8(xam)*HAIL_D(0x4018000000000000ul)/HailR8(mass),HailR8(D(1.f,4.f)));
 HailR8 lamg=lam_exp*HailR8(gfk_pow(D(D(24.f,1.f),6.f),D(1.f,3.f)));
 HailR8 n0g=n0/(HAIL_D(0x3ff0000000000000ul)*lam_exp)*lamg*lamg;
 float number=float((n0g*HAIL_D(0x3ff0000000000000ul)*glibc_pow(lamg,-HAIL_D(0x4000000000000000ul))));
 // The source rounds this parenthesized REAL expression before **.
 float ratio=D(M(M(D(M(xam,24.f),1.f),number),1.f),mass);
 lamg=HailR8(gfk_pow(ratio,D(1.f,3.f)));
 n0g=HailR8(D(number,1.f))*lamg*lamg;
 HailR8 sum=HAIL_D(0x0000000000000000ul),previous=HAIL_D(0x0000000000000000ul),diam=HAIL_D(0x0000000000000000ul),nextdiam=HAIL_D(0x0000000000000000ul);int bin;
 for(bin=50;bin>=1;--bin){
  diam=HailR8(gsd_hail_d_bits[bin-1]);
  sum=sum+(n0g*diam*glibc_exp(-lamg*diam)*HailR8(gsd_hail_width_bits[bin-1]));
  if(sum>HAIL_D(0x3f40624dd2f1a9fcul))break;
  previous=sum;nextdiam=diam;
 }
 if(bin>=50)return float(diam);
 if(nextdiam>HAIL_D(0x3f50624dd2f1a9fcul))return float((diam-(sum-HAIL_D(0x3f40624dd2f1a9fcul))/(sum-previous)*(diam-nextdiam)));
 return 1.e-4f;
}

kernel void gsd_prepare(constant GsdPrepareResources &r [[buffer(0)]],
    constant GsdPrepareParams &prm [[buffer(1)]],
    uint tid [[thread_position_in_grid]]) {
    device const float* u = r.u;
    device const float* v = r.v;
    device const float* ph = r.ph;
    device const float* phb = r.phb;
    int phb3 = prm.phb3;
    device const float* thp = r.thp;
    device const float* thb = r.thb;
    int thb3 = prm.thb3;
    device const float* p = r.p;
    device const float* alt = r.alt;
    device const float* qv = r.qv;
    device const float* fnm = r.fnm;
    device const float* fnp = r.fnp;
    device float* pw = r.pw;
    device float* temperature = r.temperature;
    device float* rho = r.rho;
    device float* wind10 = r.wind10;
    device float* wind80 = r.wind80;
    int nx = prm.nx;
    int ny = prm.ny;
    int nz = prm.nz;
    int diagflag = prm.diagflag;
 int c=int(tid),n=nx*ny;if(c>=n)return;
 int y=c/nx,x=c%nx;
 float previous=0.f,previous_z=0.f,ter=gd_z(ph,phb,phb3,0,c,n);
 if(diagflag){wind10[c]=-99.f;wind80[c]=-99.f;}
 for(int k=0;k<nz;++k){
  int t=k*n+c;
  temperature[t]=M(A(thp[t],thb[thb3?t:k]),gfk_pow(D(p[t],100000.f),.2857142857142857f));
  rho[t]=gd_rho(alt,qv,t);
  if(k>0)pw[t]=A(M(fnm[k],p[t]),M(fnp[k],p[t-n]));
  if(diagflag){
   float zm=M(.5f,A(gd_z(ph,phb,phb3,k,c,n),gd_z(ph,phb,phb3,k+1,c,n)));
   float uu=M(.5f,A(u[(k*ny+y)*(nx+1)+x],u[(k*ny+y)*(nx+1)+x+1]));
   float vv=M(.5f,A(v[(k*(ny+1)+y)*nx+x],v[(k*(ny+1)+y+1)*nx+x]));
   float sp=sqrtf(A(M(uu,uu),M(vv,vv)));
   float targets[2]={10.f,80.f};device float* winds[2]={wind10,wind80};
   for(int h=0;h<2;++h)if(S(zm,ter)>targets[h]&&winds[h][c]==-99.f){
    float wt=k==0?0.f:fminf(1.f,fmaxf(0.f,D(S(S(zm,ter),targets[h]),S(zm,previous_z))));
    winds[h][c]=A(M(S(1.f,wt),sp),M(wt,previous));
   }
   previous=sp;previous_z=zm;
  }
 }
 float z0=gd_z(ph,phb,phb3,0,c,n);
 float z1=M(.5f,A(z0,gd_z(ph,phb,phb3,1,c,n)));
 float z2=M(.5f,A(gd_z(ph,phb,phb3,1,c,n),gd_z(ph,phb,phb3,2,c,n)));
 float a=D(S(z0,z2),S(z1,z2));pw[c]=A(M(a,p[c]),M(S(1.f,a),p[n+c]));
 z0=gd_z(ph,phb,phb3,nz,c,n);
 z1=M(.5f,A(z0,gd_z(ph,phb,phb3,nz-1,c,n)));
 z2=M(.5f,A(gd_z(ph,phb,phb3,nz-1,c,n),gd_z(ph,phb,phb3,nz-2,c,n)));
 a=D(S(z0,z2),S(z1,z2));
 pw[nz*n+c]=gfk_exp(A(M(a,gfk_log(p[(nz-1)*n+c])),M(S(1.f,a),gfk_log(p[(nz-2)*n+c]))));
}

kernel void gsd_columns(constant GsdColumnsResources &r [[buffer(0)]],
    constant GsdColumnsParams &prm [[buffer(1)]],
    uint tid [[thread_position_in_grid]]) {
    device const float* u = r.u;
    device const float* v = r.v;
    device const float* w = r.w;
    device const float* ph = r.ph;
    device const float* phb = r.phb;
    int phb3 = prm.phb3;
    device const float* thp = r.thp;
    device const float* thb = r.thb;
    int thb3 = prm.thb3;
    device const float* p = r.p;
    device const float* alt = r.alt;
    device const float* qv = r.qv;
    device const float* qc = r.qc;
    device const float* qr = r.qr;
    device const float* qi = r.qi;
    device const float* qs = r.qs;
    device const float* qg = r.qg;
    device const float* qh = r.qh;
    device const float* znw = r.znw;
    device const float* density = r.density;
    device const float* temperature = r.temperature;
    device const float* wind10 = r.wind10;
    device const float* wind80 = r.wind80;
    device const float* msft = r.msft;
    device const float* qcbl = r.qcbl;
    device const float* cfbl = r.cfbl;
    device const float* u10 = r.u10;
    device const float* v10 = r.v10;
    device float* pw = r.pw;
    device float* wspdmax = r.wspdmax;
    device float* umax = r.umax;
    device float* vmax = r.vmax;
    device float* wup = r.wup;
    device float* wdn = r.wdn;
    device float* wmean = r.wmean;
    device float* wsum = r.wsum;
    device float* count = r.count;
    device float* grplmax = r.grplmax;
    device float* refmax = r.refmax;
    device float* refm10 = r.refm10;
    device float* ltg1max = r.ltg1max;
    device float* ltg2max = r.ltg2max;
    device float* ltg1 = r.ltg1;
    device float* ltg2 = r.ltg2;
    device float* wspd10 = r.wspd10;
    device float* wspd80 = r.wspd80;
    device float* lwp = r.lwp;
    device float* iwp = r.iwp;
    device float* maxcf = r.maxcf;
    device float* hailk1 = r.hailk1;
    device float* hail2d = r.hail2d;
    int nx = prm.nx;
    int ny = prm.ny;
    int nz = prm.nz;
    float ptop = prm.ptop;
    int diagflag = prm.diagflag;
    int icloud_bl = prm.icloud_bl;
    int thompson = prm.thompson;
 int c=int(tid),n=nx*ny;if(c>=n)return;
 int y=c/nx,x=c%nx;
 float wc=0.f,nc=0.f,grpl=0.f,ice=0.f,meanprev=0.f,prevspd=0.f;
 float ter=gd_z(ph,phb,phb3,0,c,n),lw=0.f,iw=0.f,cf=0.f;
 bool threat=false,minus10=false;
 for(int k=0;k<=nz;++k){
  int t=k*n+c;
  if(pw[t]>10000.f){if(w[t]>wup[c])wup[c]=w[t];if(w[t]<wdn[c])wdn[c]=w[t];}
  if(znw[k]>=.5f&&znw[k]<=.8f){wc=A(wc,w[t]);nc=A(nc,1.f);}
  if(k==nz)break;
  float zlo=gd_z(ph,phb,phb3,k,c,n),zhi=gd_z(ph,phb,phb3,k+1,c,n);
  float depth=S(zhi,zlo),rho=density[t];
  grpl=A(grpl,M(M(qg[t],depth),rho));
  ice=A(ice,M(M(A(A(qi[t],qs[t]),qg[t]),depth),rho));
  float temp=gd_t(thp,thb,thb3,p,k,c,n);
  if(!threat&&k+1<nz){
   float tb=gd_t(thp,thb,thb3,p,k+1,c,n);
   if(M(A(temp,tb),.5f)<258.15f){
    threat=true;float val=D(M(M(M(M(.042f,1000.f),1.22f),w[t]),M(A(qg[t],qg[t+n]),.5f)),msft[c]);
    if(val<1.5f)val=0.f;ltg1[c]=val;if(val>ltg1max[c])ltg1max[c]=val;
   }
  }
  // Find the highest -10 C crossing by allowing later qualifying levels
  // to replace earlier ones (the authority walks the levels downward).
  if(k>0){
   float ta=gd_t(thp,thb,thb3,p,k-1,c,n);
   if(temp<=263.15f&&ta>=263.15f){
    float a=D(S(263.15f,ta),S(temp,ta));
    float rr=A(qr[t-n],M(a,S(qr[t],qr[t-n])));
    float ss=A(qs[t-n],M(a,S(qs[t],qs[t-n])));
    float gg=A(qg[t-n],M(a,S(qg[t],qg[t-n])));
    float ra=density[t-n],r=A(ra,M(a,S(rho,ra)));
    meanprev=gd_refl(rr,ss,gg,r);minus10=true;
   }
  }
  if(thompson){
   float size=gd_hail(fmaxf(1.e-12f,M(qg[t],rho)));
   if(k==0&&size>hailk1[c])hailk1[c]=size;if(size>hail2d[c])hail2d[c]=size;
  }
  if(diagflag){
   float qct=qc[t],qit=qi[t];
   if(icloud_bl>0&&qc[t]<1.e-6f&&qi[t]<1.e-8f&&cfbl[t]>.01f){
    float cb=qcbl[t]<1.e-9f?0.f:qcbl[t],cl=cfbl[t]<.01f?0.f:cfbl[t];
    float fraction=fminf(1.f,fmaxf(0.f,D(S(temperature[t],254.f),15.f)));
    qct=M(M(cb,fraction),cl);qit=M(M(cb,S(1.f,fraction)),cl);
   }
   float dp=S(pw[t],pw[t+n]);
   lw=A(lw,fmaxf(M(D(dp,9.81f),qct),0.f));iw=A(iw,fmaxf(M(D(dp,9.81f),qit),0.f));
   cf=fmaxf(cf,cfbl[t]);
  }
 }
 float speed=sqrtf(A(M(u10[c],u10[c]),M(v10[c],v10[c])));
 if(speed>wspdmax[c]){wspdmax[c]=speed;umax[c]=u10[c];vmax[c]=v10[c];}
 count[c]=A(count[c],1.f);wsum[c]=A(wsum[c],D(wc,nc));wmean[c]=D(wsum[c],count[c]);
 if(grpl>grplmax[c])grplmax[c]=grpl;
 float threat2=D(M(M(.20f,1.22f),ice),msft[c]);if(threat2<M(.40f,1.22f))threat2=0.f;
 ltg2[c]=threat2;if(threat2>ltg2max[c])ltg2max[c]=threat2;
 float ref=gd_refl(qr[c],qs[c],qg[c],density[c]);if(ref>refmax[c])refmax[c]=ref;
 if(minus10&&meanprev>refm10[c])refm10[c]=meanprev;
 if(diagflag){
  lwp[c]=M(lw,1000.f);iwp[c]=M(iw,1000.f);maxcf[c]=cf;
  if(wspd10[c]==-99.f)wspd10[c]=wind10[c];if(wspd80[c]==-99.f)wspd80[c]=wind80[c];
 }
}

kernel void gsd_lightning3(constant GsdLightning3Resources &r [[buffer(0)]],
    constant GsdLightning3Params &prm [[buffer(1)]],
    uint tid [[thread_position_in_grid]]) {
    device const float* a = r.a;
    device const float* b = r.b;
    device float* out = r.out;
    device const float* ma = r.ma;
    device const float* mb = r.mb;
    int n = prm.n;
 int i=int(tid);if(i>=n)return;
 float value=M(.95f,a[i]);if(mb[0]>0.f)value=A(value,M(M(.05f,D(ma[0],mb[0])),b[i]));
 out[i]=value<M(.02f,1.22f)?0.f:value;
}

kernel void gsd_reflectivity(constant GsdReflectivityResources &r [[buffer(0)]],
    constant GsdReflectivityParams &prm [[buffer(1)]],
    uint tid [[thread_position_in_grid]]) {
    device float* refl = r.refl;
    device const float* phb = r.phb;
    int phb3 = prm.phb3;
    device const float* ht = r.ht;
    device const float* rainc = r.rainc;
    device float* composite = r.composite;
    device float* at1 = r.at1;
    device float* at4 = r.at4;
    int nx = prm.nx;
    int ny = prm.ny;
    int nz = prm.nz;
    float dt = prm.dt;
 int c=int(tid),n=nx*ny;if(c>=n)return;
 float rate=D(M(rainc[c],3600.f),dt),conv=M(300.f,gfk_pow(rate,1.4f));
 composite[c]=-10.f;at1[c]=-10.f;at4[c]=-10.f;bool found1=false,found4=false;
 for(int k=0;k<nz;++k){
  int t=k*n+c;float h=S(D(phb[phb3?t:k],9.81f),ht[c]);
  float ze=gfk_pow(10.f,M(.1f,refl[t]));float dbz=fmaxf(-10.f,M(10.f,gfk_log10(A(ze,conv))));
  refl[t]=dbz;if(!found1&&h>1000.f){at1[c]=dbz;found1=true;}
  if(!found4&&h>4000.f){at4[c]=dbz;found4=true;}composite[c]=fmaxf(composite[c],dbz);
 }
}

kernel void gsd_vorticity(constant GsdVorticityResources &r [[buffer(0)]],
    constant GsdVorticityParams &prm [[buffer(1)]],
    uint tid [[thread_position_in_grid]]) {
    device const float* u = r.u;
    device const float* v = r.v;
    device const float* ph = r.ph;
    device const float* phb = r.phb;
    int phb3d = prm.phb3d;
    device const float* msfu = r.msfu;
    device const float* msfv = r.msfv;
    device const float* dn = r.dn;
    device const float* dnw = r.dnw;
    device const float* fnm = r.fnm;
    device const float* fnp = r.fnp;
    float cf1 = prm.cf1;
    float cf2 = prm.cf2;
    float cf3 = prm.cf3;
    float rdx = prm.rdx;
    float rdy = prm.rdy;
    device float* rv = r.rv;
    int nz = prm.nz;
    int ny = prm.ny;
    int nx = prm.nx;
 int idx=int(tid),n=nx*ny; if(idx>=nz*n)return;
 int k=idx/n,c=idx-k*n,cy=c/nx,cx=c%nx;
 // Boundary values are the inward corner's value, as the fork copies.
 cy=max(cy,1);cx=max(cx,1);
 float cft2=-__fdiv_rn(__fmul_rn(.5f,dnw[nz-1]),dn[nz-1]);
