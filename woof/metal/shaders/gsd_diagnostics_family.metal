 float mm=__fmul_rn(__fmul_rn(.25f,__fadd_rn(msfu[(cy-1)*(nx+1)+cx],msfu[cy*(nx+1)+cx])),
                  __fadd_rn(msfv[cy*nx+cx-1],msfv[cy*nx+cx]));
