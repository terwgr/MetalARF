}

kernel void gsd_uh_fold(constant GsdUhFoldResources &r [[buffer(0)]],
    constant GsdUhFoldParams &prm [[buffer(1)]],
    uint tid [[thread_position_in_grid]]) {
    device const float* uh = r.uh;
    device const float* use = r.use;
    device float* maximum = r.maximum;
    device float* minimum = r.minimum;
    int ny = prm.ny;
    int nx = prm.nx;
 int c=int(tid);if(c>=nx*ny)return;
 int y=c/nx,x=c%nx;if(x<1||x>nx-2||y<1||y>ny-2)return;
 float edge=__fadd_rn(uh[c+1],uh[c-1]);
 edge=__fadd_rn(edge,uh[c+nx]);edge=__fadd_rn(edge,uh[c-nx]);
 float corner=__fadd_rn(uh[c+nx+1],uh[c-nx+1]);
 corner=__fadd_rn(corner,uh[c+nx-1]);corner=__fadd_rn(corner,uh[c-nx-1]);
 float val=__fadd_rn(__fadd_rn(__fmul_rn(.25f,uh[c]),__fmul_rn(.125f,edge)),__fmul_rn(.0625f,corner));
 if(use[c]!=0.f){if(val>maximum[c])maximum[c]=val;if(val<minimum[c])minimum[c]=val;}
}

kernel void gsd_vorticity_fold(constant GsdVorticityFoldResources &r [[buffer(0)]],
    constant GsdVorticityFoldParams &prm [[buffer(1)]],
    uint tid [[thread_position_in_grid]]) {
    device const float* rv = r.rv;
    device const float* ph = r.ph;
    device const float* phb = r.phb;
    int phb3d = prm.phb3d;
    device const float* ht = r.ht;
    device float* maximum = r.maximum;
    device float* max01 = r.max01;
    device float* total_steps = r.total_steps;
    int idump = prm.idump;
    int nz = prm.nz;
    int ny = prm.ny;
    int nx = prm.nx;
 int c=int(tid),n=nx*ny;if(c>=n)return;
 int y=c/nx,x=c%nx;
 // cal_helicity uses the integer timestep modulo INT(reset*60/dt),
 // even when adaptive dt changes. This is separate from the hourly
 // curr_secs reset in module_diag_gsd, which follows this call.
 float old=((int)total_steps[c]%idump==0)?0.f:maximum[c];
 total_steps[c]=__fadd_rn(total_steps[c],1.f);
 // Preserve the fork's overwrite ordering: compare every level with the
 // PREVIOUS timestep's 0-2 km value, including for the 0-1 km field.
 for(int k=1;k<nz;k++){
  float z=__fsub_rn(__fmul_rn(.5f,__fadd_rn(uh_z_at_w(ph,phb,phb3d,k,y,x,ny,nx),
                 uh_z_at_w(ph,phb,phb3d,k+1,y,x,ny,nx))),ht[c]);
  if(z<2001.f)maximum[c]=fmaxf(rv[k*n+c],old);
  if(z<1001.f)max01[c]=fmaxf(rv[k*n+c],old);
 }
}
