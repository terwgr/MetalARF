#include <metal_stdlib>
using namespace metal;
template<int R> struct MynnIndices { int value[R]; };
struct MynnRange { int lo, hi; };
struct MynnArena {
    device uchar *data;
    ulong offset;
    device void *allocate(ulong bytes, int itemsize) {
        offset = (offset+7ul)&~7ul;
        device void *result = data+offset;
        offset += bytes;
        return result;
    }
};
template<class T, int R> struct MynnArray {
    device T *data = nullptr;
    int lo[R],hi[R],stride[R];
    bool present() const { return data != nullptr; }
    int extent(int d) const { return hi[d]-lo[d]+1; }
    int size() const { int n=1; for (int d=0;d<R;++d) n*=extent(d); return n; }
    void rebase(MynnIndices<R> lower) { for (int d=0;d<R;++d) { int n=extent(d); lo[d]=lower.value[d]; hi[d]=lo[d]+n-1; } }
    device T &linear(int index) const {
        int offset=0;
        for (int d=0;d<R;++d) { offset+=(index%extent(d))*stride[d]; index/=extent(d); }
        return data[offset];
    }
    device T &operator()(int i0) const { return data[(i0-lo[0])*stride[0]]; }
    device T &operator()(int i0, int i1) const { return data[(i0-lo[0])*stride[0]+(i1-lo[1])*stride[1]]; }
    device T &operator()(int i0, int i1, int i2) const { return data[(i0-lo[0])*stride[0]+(i1-lo[1])*stride[1]+(i2-lo[2])*stride[2]]; }
    device T &operator()(int i0, int i1, int i2, int i3) const { return data[(i0-lo[0])*stride[0]+(i1-lo[1])*stride[1]+(i2-lo[2])*stride[2]+(i3-lo[3])*stride[3]]; }
    MynnArray<T,1> slice(MynnRange i0) const { MynnArray<T,1> out; out.data=data+(i0.lo-lo[0])*stride[0]; out.lo[0]=1; out.hi[0]=i0.hi-i0.lo+1; out.stride[0]=stride[0]; return out; }
    MynnArray<T,1> slice(int i0, MynnRange i1) const { MynnArray<T,1> out; out.data=data+(i0-lo[0])*stride[0]+(i1.lo-lo[1])*stride[1]; out.lo[0]=1; out.hi[0]=i1.hi-i1.lo+1; out.stride[0]=stride[1]; return out; }
    MynnArray<T,1> slice(MynnRange i0, int i1) const { MynnArray<T,1> out; out.data=data+(i0.lo-lo[0])*stride[0]+(i1-lo[1])*stride[1]; out.lo[0]=1; out.hi[0]=i0.hi-i0.lo+1; out.stride[0]=stride[0]; return out; }
    MynnArray<T,2> slice(MynnRange i0, MynnRange i1) const { MynnArray<T,2> out; out.data=data+(i0.lo-lo[0])*stride[0]+(i1.lo-lo[1])*stride[1]; out.lo[0]=1; out.hi[0]=i0.hi-i0.lo+1; out.stride[0]=stride[0]; out.lo[1]=1; out.hi[1]=i1.hi-i1.lo+1; out.stride[1]=stride[1]; return out; }
    MynnArray<T,1> slice(int i0, int i1, MynnRange i2) const { MynnArray<T,1> out; out.data=data+(i0-lo[0])*stride[0]+(i1-lo[1])*stride[1]+(i2.lo-lo[2])*stride[2]; out.lo[0]=1; out.hi[0]=i2.hi-i2.lo+1; out.stride[0]=stride[2]; return out; }
    MynnArray<T,1> slice(int i0, MynnRange i1, int i2) const { MynnArray<T,1> out; out.data=data+(i0-lo[0])*stride[0]+(i1.lo-lo[1])*stride[1]+(i2-lo[2])*stride[2]; out.lo[0]=1; out.hi[0]=i1.hi-i1.lo+1; out.stride[0]=stride[1]; return out; }
    MynnArray<T,2> slice(int i0, MynnRange i1, MynnRange i2) const { MynnArray<T,2> out; out.data=data+(i0-lo[0])*stride[0]+(i1.lo-lo[1])*stride[1]+(i2.lo-lo[2])*stride[2]; out.lo[0]=1; out.hi[0]=i1.hi-i1.lo+1; out.stride[0]=stride[1]; out.lo[1]=1; out.hi[1]=i2.hi-i2.lo+1; out.stride[1]=stride[2]; return out; }
    MynnArray<T,1> slice(MynnRange i0, int i1, int i2) const { MynnArray<T,1> out; out.data=data+(i0.lo-lo[0])*stride[0]+(i1-lo[1])*stride[1]+(i2-lo[2])*stride[2]; out.lo[0]=1; out.hi[0]=i0.hi-i0.lo+1; out.stride[0]=stride[0]; return out; }
    MynnArray<T,2> slice(MynnRange i0, int i1, MynnRange i2) const { MynnArray<T,2> out; out.data=data+(i0.lo-lo[0])*stride[0]+(i1-lo[1])*stride[1]+(i2.lo-lo[2])*stride[2]; out.lo[0]=1; out.hi[0]=i0.hi-i0.lo+1; out.stride[0]=stride[0]; out.lo[1]=1; out.hi[1]=i2.hi-i2.lo+1; out.stride[1]=stride[2]; return out; }
    MynnArray<T,2> slice(MynnRange i0, MynnRange i1, int i2) const { MynnArray<T,2> out; out.data=data+(i0.lo-lo[0])*stride[0]+(i1.lo-lo[1])*stride[1]+(i2-lo[2])*stride[2]; out.lo[0]=1; out.hi[0]=i0.hi-i0.lo+1; out.stride[0]=stride[0]; out.lo[1]=1; out.hi[1]=i1.hi-i1.lo+1; out.stride[1]=stride[1]; return out; }
    MynnArray<T,3> slice(MynnRange i0, MynnRange i1, MynnRange i2) const { MynnArray<T,3> out; out.data=data+(i0.lo-lo[0])*stride[0]+(i1.lo-lo[1])*stride[1]+(i2.lo-lo[2])*stride[2]; out.lo[0]=1; out.hi[0]=i0.hi-i0.lo+1; out.stride[0]=stride[0]; out.lo[1]=1; out.hi[1]=i1.hi-i1.lo+1; out.stride[1]=stride[1]; out.lo[2]=1; out.hi[2]=i2.hi-i2.lo+1; out.stride[2]=stride[2]; return out; }
    MynnArray<T,1> slice(int i0, int i1, int i2, MynnRange i3) const { MynnArray<T,1> out; out.data=data+(i0-lo[0])*stride[0]+(i1-lo[1])*stride[1]+(i2-lo[2])*stride[2]+(i3.lo-lo[3])*stride[3]; out.lo[0]=1; out.hi[0]=i3.hi-i3.lo+1; out.stride[0]=stride[3]; return out; }
    MynnArray<T,1> slice(int i0, int i1, MynnRange i2, int i3) const { MynnArray<T,1> out; out.data=data+(i0-lo[0])*stride[0]+(i1-lo[1])*stride[1]+(i2.lo-lo[2])*stride[2]+(i3-lo[3])*stride[3]; out.lo[0]=1; out.hi[0]=i2.hi-i2.lo+1; out.stride[0]=stride[2]; return out; }
    MynnArray<T,2> slice(int i0, int i1, MynnRange i2, MynnRange i3) const { MynnArray<T,2> out; out.data=data+(i0-lo[0])*stride[0]+(i1-lo[1])*stride[1]+(i2.lo-lo[2])*stride[2]+(i3.lo-lo[3])*stride[3]; out.lo[0]=1; out.hi[0]=i2.hi-i2.lo+1; out.stride[0]=stride[2]; out.lo[1]=1; out.hi[1]=i3.hi-i3.lo+1; out.stride[1]=stride[3]; return out; }
    MynnArray<T,1> slice(int i0, MynnRange i1, int i2, int i3) const { MynnArray<T,1> out; out.data=data+(i0-lo[0])*stride[0]+(i1.lo-lo[1])*stride[1]+(i2-lo[2])*stride[2]+(i3-lo[3])*stride[3]; out.lo[0]=1; out.hi[0]=i1.hi-i1.lo+1; out.stride[0]=stride[1]; return out; }
    MynnArray<T,2> slice(int i0, MynnRange i1, int i2, MynnRange i3) const { MynnArray<T,2> out; out.data=data+(i0-lo[0])*stride[0]+(i1.lo-lo[1])*stride[1]+(i2-lo[2])*stride[2]+(i3.lo-lo[3])*stride[3]; out.lo[0]=1; out.hi[0]=i1.hi-i1.lo+1; out.stride[0]=stride[1]; out.lo[1]=1; out.hi[1]=i3.hi-i3.lo+1; out.stride[1]=stride[3]; return out; }
    MynnArray<T,2> slice(int i0, MynnRange i1, MynnRange i2, int i3) const { MynnArray<T,2> out; out.data=data+(i0-lo[0])*stride[0]+(i1.lo-lo[1])*stride[1]+(i2.lo-lo[2])*stride[2]+(i3-lo[3])*stride[3]; out.lo[0]=1; out.hi[0]=i1.hi-i1.lo+1; out.stride[0]=stride[1]; out.lo[1]=1; out.hi[1]=i2.hi-i2.lo+1; out.stride[1]=stride[2]; return out; }
    MynnArray<T,3> slice(int i0, MynnRange i1, MynnRange i2, MynnRange i3) const { MynnArray<T,3> out; out.data=data+(i0-lo[0])*stride[0]+(i1.lo-lo[1])*stride[1]+(i2.lo-lo[2])*stride[2]+(i3.lo-lo[3])*stride[3]; out.lo[0]=1; out.hi[0]=i1.hi-i1.lo+1; out.stride[0]=stride[1]; out.lo[1]=1; out.hi[1]=i2.hi-i2.lo+1; out.stride[1]=stride[2]; out.lo[2]=1; out.hi[2]=i3.hi-i3.lo+1; out.stride[2]=stride[3]; return out; }
    MynnArray<T,1> slice(MynnRange i0, int i1, int i2, int i3) const { MynnArray<T,1> out; out.data=data+(i0.lo-lo[0])*stride[0]+(i1-lo[1])*stride[1]+(i2-lo[2])*stride[2]+(i3-lo[3])*stride[3]; out.lo[0]=1; out.hi[0]=i0.hi-i0.lo+1; out.stride[0]=stride[0]; return out; }
    MynnArray<T,2> slice(MynnRange i0, int i1, int i2, MynnRange i3) const { MynnArray<T,2> out; out.data=data+(i0.lo-lo[0])*stride[0]+(i1-lo[1])*stride[1]+(i2-lo[2])*stride[2]+(i3.lo-lo[3])*stride[3]; out.lo[0]=1; out.hi[0]=i0.hi-i0.lo+1; out.stride[0]=stride[0]; out.lo[1]=1; out.hi[1]=i3.hi-i3.lo+1; out.stride[1]=stride[3]; return out; }
    MynnArray<T,2> slice(MynnRange i0, int i1, MynnRange i2, int i3) const { MynnArray<T,2> out; out.data=data+(i0.lo-lo[0])*stride[0]+(i1-lo[1])*stride[1]+(i2.lo-lo[2])*stride[2]+(i3-lo[3])*stride[3]; out.lo[0]=1; out.hi[0]=i0.hi-i0.lo+1; out.stride[0]=stride[0]; out.lo[1]=1; out.hi[1]=i2.hi-i2.lo+1; out.stride[1]=stride[2]; return out; }
    MynnArray<T,3> slice(MynnRange i0, int i1, MynnRange i2, MynnRange i3) const { MynnArray<T,3> out; out.data=data+(i0.lo-lo[0])*stride[0]+(i1-lo[1])*stride[1]+(i2.lo-lo[2])*stride[2]+(i3.lo-lo[3])*stride[3]; out.lo[0]=1; out.hi[0]=i0.hi-i0.lo+1; out.stride[0]=stride[0]; out.lo[1]=1; out.hi[1]=i2.hi-i2.lo+1; out.stride[1]=stride[2]; out.lo[2]=1; out.hi[2]=i3.hi-i3.lo+1; out.stride[2]=stride[3]; return out; }
    MynnArray<T,2> slice(MynnRange i0, MynnRange i1, int i2, int i3) const { MynnArray<T,2> out; out.data=data+(i0.lo-lo[0])*stride[0]+(i1.lo-lo[1])*stride[1]+(i2-lo[2])*stride[2]+(i3-lo[3])*stride[3]; out.lo[0]=1; out.hi[0]=i0.hi-i0.lo+1; out.stride[0]=stride[0]; out.lo[1]=1; out.hi[1]=i1.hi-i1.lo+1; out.stride[1]=stride[1]; return out; }
    MynnArray<T,3> slice(MynnRange i0, MynnRange i1, int i2, MynnRange i3) const { MynnArray<T,3> out; out.data=data+(i0.lo-lo[0])*stride[0]+(i1.lo-lo[1])*stride[1]+(i2-lo[2])*stride[2]+(i3.lo-lo[3])*stride[3]; out.lo[0]=1; out.hi[0]=i0.hi-i0.lo+1; out.stride[0]=stride[0]; out.lo[1]=1; out.hi[1]=i1.hi-i1.lo+1; out.stride[1]=stride[1]; out.lo[2]=1; out.hi[2]=i3.hi-i3.lo+1; out.stride[2]=stride[3]; return out; }
    MynnArray<T,3> slice(MynnRange i0, MynnRange i1, MynnRange i2, int i3) const { MynnArray<T,3> out; out.data=data+(i0.lo-lo[0])*stride[0]+(i1.lo-lo[1])*stride[1]+(i2.lo-lo[2])*stride[2]+(i3-lo[3])*stride[3]; out.lo[0]=1; out.hi[0]=i0.hi-i0.lo+1; out.stride[0]=stride[0]; out.lo[1]=1; out.hi[1]=i1.hi-i1.lo+1; out.stride[1]=stride[1]; out.lo[2]=1; out.hi[2]=i2.hi-i2.lo+1; out.stride[2]=stride[2]; return out; }
    MynnArray<T,4> slice(MynnRange i0, MynnRange i1, MynnRange i2, MynnRange i3) const { MynnArray<T,4> out; out.data=data+(i0.lo-lo[0])*stride[0]+(i1.lo-lo[1])*stride[1]+(i2.lo-lo[2])*stride[2]+(i3.lo-lo[3])*stride[3]; out.lo[0]=1; out.hi[0]=i0.hi-i0.lo+1; out.stride[0]=stride[0]; out.lo[1]=1; out.hi[1]=i1.hi-i1.lo+1; out.stride[1]=stride[1]; out.lo[2]=1; out.hi[2]=i2.hi-i2.lo+1; out.stride[2]=stride[2]; out.lo[3]=1; out.hi[3]=i3.hi-i3.lo+1; out.stride[3]=stride[3]; return out; }
    template<int N> MynnArray<T,N> sequence(MynnIndices<N> lower,MynnIndices<N> upper) const {
        MynnArray<T,N> out; out.data=data; int step=1;
        for(int d=0;d<N;++d) { out.lo[d]=lower.value[d];out.hi[d]=upper.value[d];out.stride[d]=step;step*=out.extent(d); }
        return out;
    }
};
template<class T,int R,int TILE> MynnArray<T,R> mynn_array(thread MynnArena &arena,MynnIndices<R> lo,MynnIndices<R> hi) {
    static_assert(sizeof(T)==4,"MYNN word size");
    static_assert(TILE==1,"contiguous serial column");
    MynnArray<T,R> a; int count=1;
    for(int d=0;d<R;++d) { a.lo[d]=lo.value[d];a.hi[d]=hi.value[d];a.stride[d]=count;count*=a.extent(d); }
    a.data=static_cast<device T *>(arena.allocate(sizeof(T)*count,sizeof(T)));
    return a;
}
template<class T> struct MynnOptional {
    T value{}; bool supplied=false;
    MynnOptional()=default;
    MynnOptional(T v):value(v),supplied(true) {}
    operator T() const { return value; }
    bool present() const { return supplied; }
};
