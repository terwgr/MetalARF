static inline F gdd_ozone ( F latitude , int julday , F pressure ) {
F summer , winter ;
if ( julday < 30 ) {
summer = __fdiv_rn ( F ( 30 - julday ) , 183.f ) ;
winter = 1.f - summer ;
}
else if ( julday <= 212 ) {
summer = __fdiv_rn ( F ( julday - 30 ) , 183.f ) ;
winter = 1.f - summer ;
}
else {
winter = __fdiv_rn ( F ( julday - 212 ) , 183.f ) ;
summer = 1.f - winter ;
}
if ( latitude < 0.f ) {
summer = winter ;
winter = 1.f - summer ;
}
F lat = g_abs ( latitude ) ;
int north = 2 * int ( __fdiv_rn ( ( 90.f - lat ) , 22.5f ) ) ;
if ( north > 6 ) north = 6 ;
int south = north + 2 ;
F lat_north = 90.f - F ( aa_div ( north , 2 ) ) * 22.5f ;
F wn = __fdiv_rn ( ( lat - ( lat_north - 22.5f ) ) , 22.5f ) , ws = 1.f - wn ;
F sounding [ 33 ] [ 3 ] ;
constexpr int field [ 3 ] = {
1 , 4 , 5 }
;
for ( int k = 0 ;
k < 33 ;
++ k ) for ( int f = 0 ;
f < 3 ;
++ f ) {
F a = summer * f32_word(gdd_sounding [ north ] [ k ] [ field [ f ] ]) + winter * f32_word(gdd_sounding [ north + 1 ] [ k ] [ field [ f ] ]) ;
F b = summer * f32_word(gdd_sounding [ south ] [ k ] [ field [ f ] ]) + winter * f32_word(gdd_sounding [ south + 1 ] [ k ] [ field [ f ] ]) ;
sounding [ k ] [ f ] = wn * a + ws * b ;
}
F pa = pressure * 100.f , o , r ;
if ( pa <= sounding [ 32 ] [ 0 ] ) {
o = sounding [ 32 ] [ 1 ] ;
r = sounding [ 32 ] [ 2 ] ;
}
else if ( pa >= sounding [ 0 ] [ 0 ] ) {
o = sounding [ 0 ] [ 1 ] ;
r = sounding [ 0 ] [ 2 ] ;
}
else {
o = 0.f ;
r = 1.f ;
for ( int kk = 31 ;
kk >= 0 ;
-- kk ) if ( pa >= sounding [ kk + 1 ] [ 0 ] && pa <= sounding [ kk ] [ 0 ] ) {
F w = aa_div ( ( pa - sounding [ kk + 1 ] [ 0 ] ) , ( sounding [ kk ] [ 0 ] - sounding [ kk + 1 ] [ 0 ] ) ) ;
o = sounding [ kk ] [ 1 ] * w + sounding [ kk + 1 ] [ 1 ] * ( 1.f - w ) ;
r = sounding [ kk ] [ 2 ] * w + sounding [ kk + 1 ] [ 2 ] * ( 1.f - w ) ;
break ;
}
}
return aa_div ( o , r ) ;
}

