static inline W lw_abs(W x){return lw_bits(x.bits & 0x7ffffffffffffffful);}
static inline W lw_pow2(int e){return lw_bits(ulong(e+1023)<<52);}
static inline LakeWcrDD lw_mul_d(LakeWcrDD a,W b){LakeWcrDD p=lw_prod(a.h,b);return lw_fast_sum(p.h,p.l+a.l*b);}
static inline W lw_round(LakeWcrDD a){return a.h+a.l;}
static inline bool lw_round_ok(LakeWcrDD v,W rel,thread W &out){W e=rel*lw_abs(v.h);W up=v.h+(v.l+e),dn=v.h+(v.l-e);out=v.h+v.l;return up==dn;}
static inline LakeWcrDD lw_exp_core(LakeWcrDD x,thread int &k){
 W zero=lw_bits(0ul);W kd=lw_bits(soft64_rint_bits((x.h*lw_bits(0x3ff71547652b82feul)).bits));
 LakeWcrDD p=lw_prod(kd,lw_bits(0x3fe62e42fefa39eful));
 LakeWcrDD r=lw_add(lw_sum(x.h,-p.h),{-p.l,zero});
 r=lw_add(r,lw_neg(lw_prod(kd,lw_bits(0x3c7abc9e3b39803ful))));
 r=lw_add(r,{-(kd*lw_bits(0x3907b57a079a1934ul)),zero});r=lw_add(r,{x.l,zero});
 W scale=lw_bits(0x3f70000000000000ul);LakeWcrDD s={r.h*scale,r.l*scale},q=lw_fact(11,0);
 for(int n=10;n>=1;--n)q=lw_add(lw_mul(q,s),lw_fact(n,0));
 LakeWcrDD m=lw_mul(q,s);for(int i=0;i<8;++i)m=lw_mul(m,lw_add({W(2),zero},m));
 k=soft64_to_i32_rz(kd.bits).value;return lw_add({W(1),zero},m);
}
static inline W lw_exp_finish(LakeWcrDD y,int k){
 if(k>-1022){W h=lw_round(y);return k>1023?(h*lw_pow2(1023))*W(2):h*lw_pow2(k);}
 W t=(y.h*lw_pow2(k+600))*lw_bits(0x1a70000000000000ul);
 W d=y.h-(t*lw_bits(0x6570000000000000ul))*lw_pow2(-k-600);
 W midpoint=lw_pow2(-1075-k),zero=W(0),unit=lw_bits(1ul);
 if(d==midpoint && y.l>zero)t=t+unit;else if(d== -midpoint && y.l<zero)t=t-unit;return t;
}
static inline LakeWcrDD lw_exp_fast(LakeWcrDD x,thread int &K){
 W kd=lw_bits(soft64_rint_bits((x.h*lw_bits(0x40571547652b82feul)).bits));
 int kj=soft64_to_i32_rz(kd.bits).value;
 LakeWcrDD p=lw_prod(kd,lw_bits(0x3f862e42fefa39eful));
 W t=x.h-p.h;LakeWcrDD r=lw_sum(t,(x.l-p.l)-kd*lw_bits(0x3c1abc9e3b39803ful));W rh=r.h;
 W q=rh*rh*(W(.5f)+rh*(lw_bits(0x3fc5555555555555ul)+rh*(lw_bits(0x3fa5555555555555ul)+rh*(lw_bits(0x3f81111111111111ul)+rh*(lw_bits(0x3f56c16c16c16c17ul)+rh*lw_bits(0x3f2a01a01a01a01aul))))))+rh*r.l;
 LakeWcrDD em=lw_sum(rh,q);em.l=em.l+r.l;
 LakeWcrDD T={lw_bits(lw_exp2_h[kj & 63]),lw_bits(lw_exp2_l[kj & 63])};
 LakeWcrDD a=lw_prod(T.h,em.h),y=lw_fast_sum(T.h,a.h);
 y=lw_fast_sum(y.h,y.l+(a.l+(T.h*em.l+(T.l*em.h+T.l))));K=kj>>6;return y;
}
static inline W lw_add_odd(W x,W y){LakeWcrDD s=lw_sum(x,y);ulong b=s.h.bits;
 if(!soft64_is_zero(s.l.bits) && !(b & 1ul))b+=((s.l>W(0))==(s.h>W(0)))?1ul:~0ul;return lw_bits(b);}
static inline W lw_rn3(W a,W b,W c){LakeWcrDD u=lw_sum(b,c),t=lw_sum(a,u.h);return t.h+lw_add_odd(t.l,u.l);}
static inline W lw_exp_near0(W x){LakeWcrDD p=lw_fact(14,0);for(int n=13;n>=2;--n)p=lw_add(lw_mul_d(p,x),lw_fact(n,0));
 LakeWcrDD B=lw_mul(lw_prod(x,x),p),u=lw_sum(x,B.h);W w=u.l+B.l;return lw_rn3(W(1),u.h,w);}
static inline ulong lake_wcr_exp_bits(ulong bits){W x=lw_bits(bits),zero=W(0),one=W(1);if(soft64_is_nan(bits))return (x+x).bits;
 if(x>W(710))return 0x7ff0000000000000ul;if(x<W(-746))return 0ul;
 if(lw_abs(x)<lw_bits(0x3c90000000000000ul))return (one+x).bits;
 int k;W out;LakeWcrDD y=lw_exp_fast({x,zero},k);
 if(k> -1022 && lw_round_ok(y,lw_bits(0x3c00000000000000ul),out))return (k>1023?(out*lw_pow2(1023))*W(2):out*lw_pow2(k)).bits;
 if(lw_abs(x)<lw_bits(0x3f70000000000000ul))return lw_exp_near0(x).bits;
 y=lw_exp_core({x,zero},k);return lw_exp_finish(y,k).bits;
}
#endif
