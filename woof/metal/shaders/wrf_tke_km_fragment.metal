#include <metal_stdlib>
#include "wrf_tke_km_bindings.metalh"
using namespace metal;

// needs integration: append alongside smag2d_family.metal after its
// WrfSmagGrid and wrf_sm2_* metric helpers are visible.  The typed binding
// include is generated by the integrator from smag2d_family.py; this file is
// intentionally source-only in the platform lane.
#pragma clang fp contract(off)

static inline float tke_theta(thread const WrfSmagGrid &q,
                              device const float *thp,
                              device const float *thb, int thb3d,
                              int k, int j, int i) {
    const int jj=wrf_sm2_iy(q,j), ii=wrf_sm2_ix(q,i);
    const ulong n=ulong(q.ny)*ulong(q.nx), c=ulong(jj)*ulong(q.nx)+ulong(ii);
    const float base=thb3d ? thb[ulong(k)*n+c] : thb[k];
    return thp[ulong(k)*n+c]+base;
}

static inline float tke_l_scale(float tke, float bn2, float delta) {
    if (bn2 > 1.0e-6f) {
        const float l=0.76f*sqrt(max(tke,1.0e-6f))/sqrt(bn2);
        return max(0.001f*delta,min(l,delta));
    }
    return delta;
}

kernel void wrf_tke_km(
    constant WrfTkeKmResources &r [[buffer(0)]],
    constant WrfTkeKmParams &p [[buffer(1)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid >= uint(p.nz*p.ny*p.nx)) return;
    const int i=int(tid%uint(p.nx));
    const int j=int((tid/uint(p.nx))%uint(p.ny));
    const int k=int(tid/uint(p.nx*p.ny));
    WrfSmagGrid q=wrf_sm2_grid(r,p);
    const ulong idx=sm2_i3(k,j,i,p.ny,p.nx);
    const ulong col=ulong(j)*ulong(p.nx)+ulong(i);
    const float map=r.msft[col], dxm=p.dx/map, dym=p.dy/map;
    const float rdzw=wrf_sm2_rdzw(q,k,j,i);
    const float tke=max(r.tke[idx],p.seed), root=sqrt(tke);
    float kmh,kmv,khh,khv;
    if (!p.isotropic) {
        const float theta=tke_theta(q,r.thp,r.thb,p.thb3d,k,j,i);
        float dth;
        if (k==0) {
            const float dz=1.0f/wrf_sm2_rdzw(q,1,j,i)+1.0f/wrf_sm2_rdzw(q,0,j,i);
            const float z0=wrf_sm2_phi(q,0,j,i)/9.81f;
            const float z1=0.5f*(wrf_sm2_phi(q,0,j,i)+wrf_sm2_phi(q,1,j,i))/9.81f;
            const float z2=0.5f*(wrf_sm2_phi(q,1,j,i)+wrf_sm2_phi(q,2,j,i))/9.81f;
            const float w1=(z0-z2)/(z1-z2), w2=1.0f-w1;
            const float t0=tke_theta(q,r.thp,r.thb,p.thb3d,0,j,i)*pow(r.p[sm2_i3(0,j,i,p.ny,p.nx)]/100000.0f,0.2857143f);
            const float t1=tke_theta(q,r.thp,r.thb,p.thb3d,1,j,i)*pow(r.p[sm2_i3(1,j,i,p.ny,p.nx)]/100000.0f,0.2857143f);
            const float ps=w1*r.p[sm2_i3(0,j,i,p.ny,p.nx)]+w2*r.p[sm2_i3(1,j,i,p.ny,p.nx)];
            const float ts=(w1*t0+w2*t1)/pow(ps/100000.0f,0.2857143f);
            dth=(tke_theta(q,r.thp,r.thb,p.thb3d,1,j,i)-ts)/dz;
        } else if (k==p.nz-1) {
            const float dz=1.0f/wrf_sm2_rdz(q,p.nz-1,j,i)+0.5f/wrf_sm2_rdzw(q,p.nz-1,j,i);
            const float z0=wrf_sm2_phi(q,p.nz,j,i)/9.81f;
            const float z1=0.5f*(wrf_sm2_phi(q,p.nz-1,j,i)+wrf_sm2_phi(q,p.nz,j,i))/9.81f;
            const float z2=0.5f*(wrf_sm2_phi(q,p.nz-2,j,i)+wrf_sm2_phi(q,p.nz-1,j,i))/9.81f;
            const float w1=(z0-z2)/(z1-z2), w2=1.0f-w1;
            const ulong a=sm2_i3(p.nz-1,j,i,p.ny,p.nx), b=sm2_i3(p.nz-2,j,i,p.ny,p.nx);
            const float ta=tke_theta(q,r.thp,r.thb,p.thb3d,p.nz-1,j,i)*pow(r.p[a]/100000.0f,0.2857143f);
            const float tb=tke_theta(q,r.thp,r.thb,p.thb3d,p.nz-2,j,i)*pow(r.p[b]/100000.0f,0.2857143f);
            const float ps=exp(w1*log(r.p[a])+w2*log(r.p[b]));
            const float ts=(w1*ta+w2*tb)/pow(ps/100000.0f,0.2857143f);
            dth=(ts-tke_theta(q,r.thp,r.thb,p.thb3d,p.nz-2,j,i))/dz;
        } else {
            const float dz=1.0f/wrf_sm2_rdz(q,k+1,j,i)+1.0f/wrf_sm2_rdz(q,k,j,i);
            dth=(tke_theta(q,r.thp,r.thb,p.thb3d,k+1,j,i)-tke_theta(q,r.thp,r.thb,p.thb3d,k-1,j,i))/dz;
        }
        const float mh=sqrt(dxm*dym), delta=1.0f/rdzw;
        float mv=delta;
        if (dth>0.0f) mv=min(mv,0.76f*root/sqrt(abs(9.81f/theta*dth)));
        kmh=min(max(p.c_k*root*mh,1.0e-6f*mh*mh),p.mix_upper_bound*mh*mh/p.dt);
        kmv=min(max(p.c_k*root*mv,1.0e-6f*delta*delta),p.mix_upper_bound*delta*delta/p.dt);
        khh=kmh/(1.0f/3.0f);
        khv=kmv*(1.0f+2.0f*mv/delta);
    } else {
        const float delta=pow(dxm*dym/rdzw,0.33333333f);
        const float l=tke_l_scale(r.tke[idx],r.bn2[idx],delta);
        kmh=min(p.mix_upper_bound*dxm*dym/p.dt,p.c_k*root*l);
        kmv=min(p.mix_upper_bound/rdzw/rdzw/p.dt,p.c_k*root*l);
        const float pr=1.0f+2.0f*l/delta;
        khh=min(p.mix_upper_bound*dxm*dym/p.dt,kmh*pr);
        khv=min(p.mix_upper_bound/rdzw/rdzw/p.dt,kmv*pr);
    }
    r.xkmh[idx]=kmh; r.xkhh[idx]=khh; r.xkmv[idx]=kmv; r.xkhv[idx]=khv;
}
