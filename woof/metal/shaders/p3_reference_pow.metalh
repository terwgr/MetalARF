static inline uint p3_reference_pow_bits(uint x, uint y) {
    if (x < 0x00800000u || x >= 0x7f800000u
            || (y & 0x7fffffffu) >= 0x7f800000u)
        return soft_gfk_pow_bits(x,y);
    if (x == 0x3f800000u || (y & 0x7fffffffu) == 0u) return 0x3f800000u;
    if (y == 0x3f800000u) return x;
    const uint reduced = x - 0x3f338000u;
    const uint index = (reduced >> 16u) & 127u;
    const uint exponent_bits = reduced & 0xff800000u;
    const uint normalized = x - exponent_bits;
    const int exponent = as_type<int>(exponent_bits) >> 16;
    const ulong one = 0x3ff0000000000000ul;
    const ulong r = soft64_fma(soft64_from_f32_bits(normalized),
        p3_reference_log_table[2u*index],soft64_negate_bits(one));
    const ulong base = soft64_add(p3_reference_log_table[2u*index+1u],
        soft_gfk_i32_to_f64_bits(exponent));
    const ulong r2 = soft64_mul(r,r);
    const ulong a = soft64_fma(r,p3_reference_log_coeff[0],p3_reference_log_coeff[1]);
    const ulong b = soft64_fma(r,p3_reference_log_coeff[2],p3_reference_log_coeff[3]);
    const ulong log2x = soft64_fma(soft64_fma(a,r2,b),r,base);
    ulong scaled = soft64_mul(soft64_from_f32_bits(y),log2x);
    const ulong limit = 0x40e0000000000000ul; // 32768, before exp2 / 128
    if (soft64_greater(scaled,limit)) scaled=limit;
    if (soft64_less(scaled,soft64_negate_bits(limit))) scaled=soft64_negate_bits(limit);
    // Round to nearest integer, ties away, as in the scalar range reduction.
    const Soft64Decoded dec = soft64_decode(scaled);
    const int shift = 52-dec.exponent;
    ulong magnitude = shift > 63 ? 0ul : (dec.significand >> uint(shift));
    if (shift > 0 && shift <= 63
            && (dec.significand & ((1ul << uint(shift))-1ul)) >= (1ul << uint(shift-1)))
        ++magnitude;
    const int n = (scaled >> 63u) != 0ul ? -int(magnitude) : int(magnitude);
    const ulong fraction = soft64_sub(scaled,soft_gfk_i32_to_f64_bits(n));
    const ulong factor = p3_reference_exp_table[uint(n)&127u] + (ulong(long(n)) << 45u);
    const ulong polynomial = soft64_fma(p3_reference_exp_coeff[0],fraction,
        p3_reference_exp_coeff[1]);
    return soft64_to_f32_bits(soft64_fma(soft64_mul(polynomial,fraction),factor,factor));
}
