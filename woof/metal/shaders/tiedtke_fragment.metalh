void tk_cuentr_new(int klon, int klev, int klevp1, int kk, TkArray<float> ptenh, TkArray<float> paph, TkArray<float> pap, TkArray<float> pgeoh, TkArray<int> klwmin, TkArray<bool> ldcum, TkArray<int> ktype, TkArray<int> kcbot, TkArray<int> kctop0, TkArray<float> zpbase, TkArray<float> pmfu, TkArray<float> pentr, TkArray<float> zdmfen, TkArray<float> zdmfde, TkArray<float> zodetr, TkArray<int> khmin, TkArena arena) {
    int jl;
    int iklwmin;
    int ikb;
    int ikt;
    int ikh;
    float zrrho;
    float zdprho;
    float zpmid;
    float zentr;
    float zzmzk;
    float ztmzk;
    float arg;
    float zorgde;
    bool llo1;
    bool llo2;
    const int tk_limit_2902 = klon;
    for (jl = 1; jl <= tk_limit_2902; jl += 1) {
        zpbase(jl) = paph(jl, kcbot(jl)); ;
        zrrho = tk_div(tk_mul(tk_rd, ptenh(jl, (kk + 1))), paph(jl, (kk + 1))); ;
        zdprho = tk_mul(tk_sub(paph(jl, (kk + 1)), paph(jl, kk)), tk_zrg); ;
        zpmid = tk_mul(0.5f, tk_add(zpbase(jl), paph(jl, kctop0(jl)))); ;
        zentr = tk_mul(tk_mul(tk_mul(pentr(jl), pmfu(jl, (kk + 1))), zdprho), zrrho); ;
        llo1 = ((kk < kcbot(jl)) & ldcum(jl));
        if (llo1) {
            zdmfde(jl) = zentr; ;
        } else {
            zdmfde(jl) = 0.0f; ;
        }
        llo2 = ((llo1 & (ktype(jl) == 2)) & ((tk_sub(zpbase(jl), paph(jl, kk)) < tk_zdnoprc) | (paph(jl, kk) > zpmid)));
        if (llo2) {
            zdmfen(jl) = zentr; ;
        } else {
            zdmfen(jl) = 0.0f; ;
        }
        iklwmin = tk_max(klwmin(jl), (kctop0(jl) + 2));
        llo2 = ((llo1 & (ktype(jl) == 3)) & ((kk >= iklwmin) | (pap(jl, kk) > zpmid)));
        if (llo2) { zdmfen(jl) = zentr; ; }
        llo2 = (llo1 & (ktype(jl) == 1));
        if (llo2) { zdmfen(jl) = zentr; ; }
        ikb = kcbot(jl);
        zodetr(jl, kk) = 0.f; ;
        if (((llo2 & (kk <= khmin(jl))) & (kk >= kctop0(jl)))) {
            ikt = kctop0(jl);
            ikh = khmin(jl);
            if ((ikh > ikt)) {
                zzmzk = tk_mul((-tk_sub(pgeoh(jl, ikh), pgeoh(jl, kk))), tk_zrg); ;
                ztmzk = tk_mul((-tk_sub(pgeoh(jl, ikh), pgeoh(jl, ikt))), tk_zrg); ;
                arg = tk_mul(tk_mul(3.1415f, tk_div(zzmzk, ztmzk)), 0.5f); ;
                zorgde = tk_div(tk_mul(tk_mul(tk_tan(arg, arena), 3.1415f), 0.5f), ztmzk); ;
                zdprho = tk_mul(tk_sub(paph(jl, (kk + 1)), paph(jl, kk)), tk_mul(tk_zrg, zrrho)); ;
                zodetr(jl, kk) = tk_mul(tk_mul(tk_min(zorgde, 1.e-3f), pmfu(jl, (kk + 1))), zdprho); ;
            }
        }
    }
    return;
}
float tk_ssum(int n, TkArray<float> x, int ix, TkArena arena) {
    float result;
    float zsum;
    int jx;
    int jl;
    jx = 1;
    zsum = 0.0f; ;
    const int tk_limit_2968 = n;
    for (jl = 1; jl <= tk_limit_2968; jl += 1) {
        zsum = tk_add(zsum, x(jx)); ;
        jx = (jx + ix);
    }
    result = zsum; ;
    return result;
}
float tk_tlucua(float tt, TkArena arena) {
    float result;
    float zcvm3;
    float zcvm4;
    if ((tk_sub(tt, tk_tmelt) > 0.f)) {
        zcvm3 = tk_c3les; ;
        zcvm4 = tk_c4les; ;
    } else {
        zcvm3 = tk_c3ies; ;
        zcvm4 = tk_c4ies; ;
    }
    result = tk_mul(tk_c2es, gfk_exp(tk_mul(tk_mul(zcvm3, tk_sub(tt, tk_tmelt)), tk_div(1.f, tk_sub(tt, zcvm4))))); ;
    return result;
}
float tk_tlucub(float tt, TkArena arena) {
    float result;
    float z5alvcp;
    float z5alscp;
    float zcvm4;
    float zcvm5;
    z5alvcp = tk_div(tk_mul(tk_c5les, tk_alv), tk_cpd); ;
    z5alscp = tk_div(tk_mul(tk_c5ies, tk_als), tk_cpd); ;
    if ((tk_sub(tt, tk_tmelt) > 0.f)) {
        zcvm4 = tk_c4les; ;
        zcvm5 = z5alvcp; ;
    } else {
        zcvm4 = tk_c4ies; ;
        zcvm5 = z5alscp; ;
    }
    result = tk_mul(zcvm5, tk_mul(tk_div(1.f, tk_sub(tt, zcvm4)), tk_div(1.f, tk_sub(tt, zcvm4)))); ;
    return result;
}
float tk_tlucuc(float tt, TkArena arena) {
    float result;
    float zalvdcp;
    float zalsdcp;
    float zldcp;
    zalvdcp = tk_div(tk_alv, tk_cpd); ;
    zalsdcp = tk_div(tk_als, tk_cpd); ;
    if ((tk_sub(tt, tk_tmelt) > 0.f)) {
        zldcp = zalvdcp; ;
    } else {
        zldcp = zalsdcp; ;
    }
    result = zldcp; ;
    return result;
}
float tk_tlucua_tiecnv(float tt, TkArena arena) {
    float result;
    float zcvm3;
    float zcvm4;
    if ((tk_sub(tt, tk_tmelt) > 0.f)) {
        zcvm3 = tk_c3les; ;
        zcvm4 = tk_c4les; ;
    } else {
        zcvm3 = tk_c3ies; ;
        zcvm4 = tk_c4ies; ;
    }
    result = tk_mul(tk_c2es, tk_lane_exp(arena, tk_mul(tk_mul(zcvm3, tk_sub(tt, tk_tmelt)), tk_div(1.f, tk_sub(tt, zcvm4))))); ;
    return result;
}
