#ifndef WOOF_EXACT_BINARY32_METALH
#define WOOF_EXACT_BINARY32_METALH

#include <metal_stdlib>
#include "soft_binary32.metalh"
using namespace metal;

// Binary32 values are stored and loaded as integer words. Every arithmetic
// operator rounds once, RN-even, with gradual underflow; native float is used
// only to bit-cast scalar ABI parameters and literal constants.
struct Exact32 {
    uint bits;
    constexpr Exact32() : bits(0u) {}
    Exact32(float value) : bits(as_type<uint>(value)) {}
    static Exact32 from_bits(uint value) { Exact32 r; r.bits = value; return r; }
};

static inline Exact32 operator+(Exact32 a, Exact32 b)
{ return Exact32::from_bits(soft32_add(a.bits, b.bits)); }
static inline Exact32 operator-(Exact32 a, Exact32 b)
{ return Exact32::from_bits(soft32_sub(a.bits, b.bits)); }
static inline Exact32 operator*(Exact32 a, Exact32 b)
{ return Exact32::from_bits(soft32_mul(a.bits, b.bits)); }
static inline Exact32 operator/(Exact32 a, Exact32 b)
{ return Exact32::from_bits(soft32_div(a.bits, b.bits)); }
static inline Exact32 operator-(Exact32 a)
{ return Exact32::from_bits(soft32_negate_bits(a.bits)); }
static inline bool operator>(Exact32 a, Exact32 b)
{ return soft32_greater(a.bits, b.bits); }
static inline bool operator>=(Exact32 a, Exact32 b)
{ return soft32_greater_equal(a.bits, b.bits); }
static inline device Exact32 &operator+=(device Exact32 &a, Exact32 b)
{ a = a + b; return a; }
static inline thread Exact32 &operator+=(thread Exact32 &a, Exact32 b)
{ a = a + b; return a; }
static inline thread Exact32 &operator-=(thread Exact32 &a, Exact32 b)
{ a = a - b; return a; }
static inline device Exact32 &operator-=(device Exact32 &a, Exact32 b)
{ a = a - b; return a; }
static inline thread Exact32 &operator*=(thread Exact32 &a, Exact32 b)
{ a = a * b; return a; }
static inline thread Exact32 &operator/=(thread Exact32 &a, Exact32 b)
{ a = a / b; return a; }

static inline Exact32 exact_add(Exact32 a, Exact32 b) { return a + b; }
static inline Exact32 exact_sub(Exact32 a, Exact32 b) { return a - b; }
static inline Exact32 exact_mul(Exact32 a, Exact32 b) { return a * b; }
static inline Exact32 exact_div(Exact32 a, Exact32 b) { return a / b; }
static inline Exact32 exact_sqrt(Exact32 a)
{ return Exact32::from_bits(soft32_sqrt(a.bits)); }
static inline Exact32 exact_abs(Exact32 a)
{ return Exact32::from_bits(soft32_abs_bits(a.bits)); }
static inline Exact32 exact_min(Exact32 a, Exact32 b)
{
    if (soft32_is_nan(a.bits)) return b;
    if (soft32_is_nan(b.bits)) return a;
    if (soft32_is_zero(a.bits) && soft32_is_zero(b.bits))
        return Exact32::from_bits(a.bits | b.bits);
    return soft32_less(a.bits, b.bits) ? a : b;
}
static inline Exact32 exact_max(Exact32 a, Exact32 b)
{
    if (soft32_is_nan(a.bits)) return b;
    if (soft32_is_nan(b.bits)) return a;
    if (soft32_is_zero(a.bits) && soft32_is_zero(b.bits))
        return Exact32::from_bits(a.bits & b.bits);
    return soft32_greater(a.bits, b.bits) ? a : b;
}

#endif
