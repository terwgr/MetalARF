constant float sncovfac_values[] = {0.030f, 0.030f, 0.030f, 0.030f, 0.030f, 0.016f, 0.016f, 0.020f, 0.020f, 0.020f, 0.020f, 0.014f, 0.042f, 0.026f, 0.030f, 0.016f, 0.030f, 0.030f, 0.030f, 0.030f, 0.000f, 0.000f, 0.000f, 0.000f, 0.000f, 0.000f, 0.000f, 0.000f, 0.000f, 0.000f};
inline F sncovfac(int i){return F(sncovfac_values[i-1]);}
inline F rrfs_gfk_log(F x){return f32_word(soft_gfk_log(x.bits));}
inline F ruc_log10f_rn(F x){return f32_word(native_thompson_log10_bits(x.bits));}
inline F glibc_cosf(F x){return f32_word(soft_glibc_solar_cosf(x.bits));}
