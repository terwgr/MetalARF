lambda = aa_div ( 3.672f , mvd ) ;
rain_number = __fdiv_rn ( ( aa_div ( 1.0f , 6.0f ) ) * rain_mass , am_r ) * lambda * lambda * lambda ;
* rain_number_per_kg = aa_div ( rain_number , density ) ;
}

