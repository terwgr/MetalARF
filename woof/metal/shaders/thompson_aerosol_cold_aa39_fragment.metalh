template < typename P_rain_number_per_kg > static inline void thompson_aa_bound_rain_number ( float rain_mass , float density , P_rain_number_per_kg rain_number_per_kg ) {
if ( rain_mass <= 1.0e-12f ) {
* rain_number_per_kg = 0.0f ;
return ;
}
const float am_r = 5.235988159e+02f ;
float rain_number = aa_fmaxf ( 1.0e-6f , * rain_number_per_kg * density ) ;
float lambda = thompson_aa_powf ( aa_div ( am_r * 6.0f * rain_number , rain_mass ) , aa_div ( 1.0f , 3.0f ) ) ;
float mvd = aa_div ( 3.672f , lambda ) ;
if ( mvd > 2.5e-3f ) {
mvd = 2.5e-3f ;
}
else if ( mvd < 37.5e-6f ) {
mvd = 37.5e-6f ;
}
else {
return ;
