const float ratio = thompson_aa_div ( Da , D ) ;
const float term2 = thompson_aa_mul ( thompson_aa_div ( thompson_aa_mul ( 4.0f , Da ) , D ) , thompson_aa_add ( 0.02f , thompson_aa_mul ( ratio , thompson_aa_add ( 1.0f , thompson_aa_mul ( 2.0f , sqrt_re ) ) ) ) ) ;
float Eff = thompson_aa_add ( term1 , term2 ) ;
if ( St > St2 ) {
