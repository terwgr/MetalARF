static inline float thompson_ice_koop ( float temp , float qv , float qvs , float naero , float dt ) {
const float satw = thompson_aa_div ( qv , qvs ) ;
float mu_diff = thompson_aa_add ( 210368.0f , thompson_aa_mul ( 131.438f , temp ) ) ;
mu_diff = thompson_aa_sub ( mu_diff , thompson_aa_div ( 3.32373e6f , temp ) ) ;
mu_diff = thompson_aa_sub ( mu_diff , thompson_aa_mul ( 41729.1f , thompson_aa_logf ( temp ) ) ) ;
const float a_w_i = thompson_aa_expf ( thompson_aa_div ( mu_diff , thompson_aa_mul ( 8.314f , temp ) ) ) ;
const float d = thompson_aa_sub ( satw , a_w_i ) ;
float log_J_rate = thompson_aa_add ( - 906.7f , thompson_aa_mul ( 8502.0f , d ) ) ;
log_J_rate = thompson_aa_sub ( log_J_rate , thompson_aa_mul ( thompson_aa_mul ( 26924.0f , d ) , d ) ) ;
log_J_rate = thompson_aa_add ( log_J_rate , thompson_aa_mul ( thompson_aa_mul ( thompson_aa_mul ( 29180.0f , d ) , d ) , d ) ) ;
log_J_rate = aa_fminf ( 20.0f , log_J_rate ) ;
const float J_rate = thompson_aa_powf ( 10.0f , log_J_rate ) ;
const float koop_arg = thompson_aa_mul ( thompson_aa_mul ( - J_rate , 6.544983879e-17f ) , dt ) ;
const float prob_h = aa_fminf ( thompson_aa_sub ( 1.0f , thompson_aa_expf ( koop_arg ) ) , 1.0f ) ;
float xni = 0.0f ;
if ( prob_h > 0.0f ) {
xni = aa_fminf ( thompson_aa_mul ( prob_h , naero ) , 1000.0e3f ) ;
}
return aa_fmaxf ( 0.0f , xni ) ;
}

static inline float thompson_eff_aero ( float D , float Da , float visc , float rhoa , float Temp , int species ) {
