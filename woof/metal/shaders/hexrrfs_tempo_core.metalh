k <= nz ;
++ k ) {
dip = aa_div ( ( qa [ k + 1 ] - qa [ k ] ) , ( dza [ k + 1 ] + dza [ k ] ) ) ;
dim = aa_div ( ( qa [ k ] - qa [ k - 1 ] ) , ( dza [ k - 1 ] + dza [ k ] ) ) ;
