static inline F tempo_cloud_number ( F qc , F qr , F qi , F qs , F pressure , F temperature , F w ) {
const F input [ 7 ] = {
qc , qr , qi , qs , pressure , temperature , w }
;
F transformed [ 7 ] ;
F activated [ 24 ] ;
for ( int i = 0 ;
i < 7 ;
++ i ) transformed [ i ] = aa_div ( ( input [ i ] - tempo_nc_ml_trans_mean ( i ) ) , ntc::tc_sqrt( tempo_nc_ml_trans_var ( i ) ) ) ;
for ( int node = 0 ;
node < 24 ;
++ node ) {
F value = 0.0f ;
for ( int i = 0 ;
i < 7 ;
++ i ) value = value + tempo_nc_ml_w00 ( node + 24 * i ) * transformed [ i ] ;
activated [ node ] = tmax ( value + tempo_nc_ml_b00 ( node ) , 0.0f ) ;
}
F value = 0.0f ;
for ( int node = 0 ;
node < 24 ;
++ node ) value = value + tempo_nc_ml_w01 ( node ) * activated [ node ] ;
value = tmax ( value + tempo_nc_ml_b01 ( 0 ) , 0.0f ) ;
const F p = tmin ( 9.3010299957f , tmax ( - 6.0f , value ) ) ;
F bias = 1.0f ;
if ( p >= 0.0f && p < 3.0f ) {
const F p2 = p * p ;
const F p3 = p2 * p ;
const F p4 = p2 * p2 ;
const F p5 = p2 * p3 ;
bias = - 0.2704f * p5 + 1.838f * p4 - 5.127f * p3 + 8.547f * p2 - 8.439f * p + 4.297f ;
}
return bias * tempo_pow ( 10.0f , p ) ;
}

template < typename P_qc , typename P_qr , typename P_qi , typename P_qs , typename P_nc , typename P_w , typename P_qc_bl , typename P_fraction_bl > static inline void tempo_subgrid_cloud_radii ( thread const TempoParams & P , thread const TempoCtx & C , int nz , device TempoWork & W , P_qc qc , P_qr qr , P_qi qi , P_qs qs , P_nc nc , P_w w , P_qc_bl qc_bl , P_fraction_bl fraction_bl , int nt , int c0 ) {
if ( ! W . did_micro || ! C . re_cloud_flag || ! C . re_ice_flag || ! C . re_snow_flag ) return ;
for ( int k = 1 + 0 ;
k <= ( nz ) ;
k += 1 ) {
const long index = ( long ) ( k - 1 ) * nt + c0 ;
W . xrx [ k ] = qc [ k ] ;
if ( qc [ k ] <= ( ( F ) P . L [ TOFF_r1 + ( 0 ) ] ) && qc_bl [ index ] > 1.0e-9f && fraction_bl [ index ] > 0.0f ) W . xrx [ k ] += aa_div ( qc_bl [ index ] , fraction_bl [ index ] ) ;
if ( W . xrx [ k ] <= 1.0e-12f ) W . xrx [ k ] = 0.0f ;
W . xncx [ k ] = tempo_cloud_number ( W . xrx [ k ] , qr [ k ] , qi [ k ] , qs [ k ] , W . pres [ k ] , W . temp [ k ] , w [ k ] ) ;
W . qcten [ k ] = 0.0f ;
W . ncten [ k ] = 0.0f ;
}
cloud_check_and_update ( P , C , nz , W . rho , W . l_qc , W . xrx , W . xncx , ( thread const F * ) nullptr , W . rc , W . nc , W . qcten , W . ncten , W . ilamc , W . mvd_c ) ;
effective_radius ( P , C , nz , W . temp , W . l_qc , W . nc , W . ilamc , W . l_qi , W . ilami , W . l_qs , W . rs , W . re_cloud , W . re_ice , W . re_snow ) ;
}
