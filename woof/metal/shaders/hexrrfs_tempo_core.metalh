template < class A , class B > static inline auto tmax ( A a , B b ) -> decltype ( a + b ) {
return a > b ? decltype(a+b)(a) : decltype(a+b)(b) ;
}

template < class A , class B > static inline auto tmin ( A a , B b ) -> decltype ( a + b ) {
return a < b ? decltype(a+b)(a) : decltype(a+b)(b) ;
}

template < class A , class B , class C > static inline auto tmax3 ( A a , B b , C c ) -> decltype ( a + b + c ) {
return tmax ( tmax ( a , b ) , c ) ;
}

template < class A , class B , class C > static inline auto tmin3 ( A a , B b , C c ) -> decltype ( a + b + c ) {
return tmin ( tmin ( a , b ) , c ) ;
}

static inline int imax ( int a , int b ) {
return a > b ? a : b ;
}

static inline int imin ( int a , int b ) {
return a < b ? a : b ;
}

static inline int tnint ( F x ) {
return ( int ) tempo_lround( x ) ;
}

static inline int tnint ( Soft8 x ) {
return ( int ) tempo_lround( x ) ;
}

template < class A , class B > static inline auto tsign ( A a , B b ) -> decltype ( a + b ) {
using T = decltype ( a + b ) ;
return copysign ( fabs ( T ( a ) ) , T ( b ) ) ;
}

template < class T > static inline T tpowi ( T x , int m ) {
bool neg = m < 0 ;
uint n = neg ? 0u - ( uint ) m : ( uint ) m ;
T y = ( n & 1u ) ? x : T ( 1 ) ;
while ( n >>= 1u ) {
