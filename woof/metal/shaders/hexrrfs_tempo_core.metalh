k <= nz - 1 ;
++ k ) wi [ k ] = fa1 * ( vt [ k ] + vt [ k - 1 ] ) - fa2 * ( vt [ k + 1 ] + vt [ k - 2 ] ) ;
wi [ nz ] = 0.5f * ( vt [ nz ] + vt [ nz - 1 ] ) ;
wi [ nz + 1 ] = vt [ nz + 1 ] ;
