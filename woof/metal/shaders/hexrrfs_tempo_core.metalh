for ( int k = 2 ;
k <= nz ;
++ k ) {
nwfa [ k ] = ( ( F ) P . L [ TOFF_naccn1 + ( 0 ) ] ) + ( ( F ) P . L [ TOFF_naccn0 + ( 0 ) ] ) * tempo_exp ( - ( aa_div ( ( hgt [ k ] - hgt [ 1 ] ) , 1000.0f ) ) * niccn3 ) ;
}
}

