template < typename P_dz1d , typename P_nwfa > static inline void init_water_friendly_aerosols ( thread const TempoParams & P , int nz , P_dz1d dz1d , P_nwfa nwfa ) {
F hgt [ ( TNZMAX + 3 ) ] ;
F h_01 ;
F niccn3 ;
for ( int k = 0 ;
k < ( TNZMAX + 3 ) ;
++ k ) hgt [ k ] = 0.0f ;
for ( int k = 2 ;
k <= nz ;
++ k ) hgt [ k ] = hgt [ k - 1 ] + dz1d [ k ] ;
if ( hgt [ 1 ] <= 1000.0f ) {
h_01 = 0.8f ;
}
else if ( hgt [ 1 ] >= 2500.0f ) {
h_01 = 0.01f ;
}
