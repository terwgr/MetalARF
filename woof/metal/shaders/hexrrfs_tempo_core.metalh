template < typename P_dz1d , typename P_rho , typename P_xr , typename P_xten , typename P_vt , typename P_precip > static inline void semilagrangian_sedimentation ( thread const TempoParams & P , thread const TempoCtx & C , int nz , device TempoWork & W , P_dz1d dz1d , P_rho rho , P_xr xr , P_xten xten , P_vt vt , int steps , F limit , P_precip precip ) {
F fa1 ;
F fa2 ;
F con1 ;
F decfl ;
F dip ;
F dim ;
F tl ;
F th ;
F tl2 ;
F th2 ;
F qqd ;
F qqh ;
F qql ;
F zsum ;
F qsum ;
F orho ;
F dql ;
F dqh ;
device F * zi = W . sl_zi ;
device F * wi = W . sl_wi ;
device F * za = W . sl_za ;
device F * dza = W . sl_dza ;
device F * qa = W . sl_qa ;
device F * qmi = W . sl_qmi ;
device F * qpi = W . sl_qpi ;
device F * net_flx = W . sl_net_flx ;
device F * precip_flx = W . sl_precip_flx ;
device F * rr_save = W . sl_rr_save ;
int k , kk , kb , kt , m ;
for ( k = 1 ;
k <= nz + 2 ;
++ k ) {
zi [ k ] = 0.0f ;
wi [ k ] = 0.0f ;
dza [ k ] = 0.0f ;
za [ k ] = 0.0f ;
qa [ k ] = 0.0f ;
qmi [ k ] = 0.0f ;
qpi [ k ] = 0.0f ;
}
for ( k = 1 ;
k <= nz ;
++ k ) {
net_flx [ k ] = 0.0f ;
precip_flx [ k ] = 0.0f ;
rr_save [ k ] = xr [ k ] ;
}
zi [ 1 ] = 0.0f ;
for ( k = 1 ;
k <= nz ;
++ k ) zi [ k + 1 ] = zi [ k ] + dz1d [ k ] ;
fa1 = aa_div ( 9.0f , 16.0f ) ;
fa2 = aa_div ( 1.0f , 16.0f ) ;
wi [ 1 ] = vt [ 1 ] ;
wi [ 2 ] = 0.5f * ( vt [ 2 ] + vt [ 1 ] ) ;
