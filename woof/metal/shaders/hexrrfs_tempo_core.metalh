}
orho = aa_div ( 1.0f , rho [ k ] ) ;
xr [ k ] = tmax ( xr [ k ] , limit ) ;
xten [ k ] = xten [ k ] + ( xr [ k ] - rr_save [ k ] ) * orho * C . global_inverse_dt ;
