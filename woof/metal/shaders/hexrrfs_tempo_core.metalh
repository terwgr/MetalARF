template < typename P_xr , typename P_vt , typename P_dz1d , typename P_rho , typename P_xten , typename P_precip , typename P_sed_r > static inline void sedimentation ( thread const TempoParams & P , thread const TempoCtx & C , int nz , P_xr xr , P_vt vt , P_dz1d dz1d , P_rho rho , P_xten xten , F limit , int steps , int ktop_sedi , P_precip precip , P_sed_r sed_r ) {
