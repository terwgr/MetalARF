}
th = aa_div ( ( zi [ k + 1 ] - za [ kt ] ) , dza [ kt ] ) ;
th2 = th * th ;
qqd = 0.5f * ( qpi [ kt ] - qmi [ kt ] ) ;
dqh = qqd * th2 + qmi [ kt ] * th ;
zsum = zsum + th * dza [ kt ] ;
