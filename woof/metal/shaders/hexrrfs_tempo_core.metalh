break ;
}
else {
for ( kk = kb ;
kk <= nz ;
++ kk ) {
if ( zi [ k ] <= za [ kk + 1 ] ) {
kb = kk ;
break ;
}
}
for ( kk = kt ;
kk <= nz + 2 ;
++ kk ) {
if ( zi [ k + 1 ] <= za [ kk ] ) {
kt = kk ;
break ;
}
}
kt = kt - 1 ;
if ( kt == kb ) {
tl = aa_div ( ( zi [ k ] - za [ kb ] ) , dza [ kb ] ) ;
th = aa_div ( ( zi [ k + 1 ] - za [ kb ] ) , dza [ kb ] ) ;
tl2 = tl * tl ;
th2 = th * th ;
qqd = 0.5f * ( qpi [ kb ] - qmi [ kb ] ) ;
