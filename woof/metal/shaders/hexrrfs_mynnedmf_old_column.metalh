MynnArray<Exact32, 1> sqv = mynn_array<Exact32, 1, mynn_tile>(arena, {1}, {kte});
MynnArray<Exact32, 1> sqc = mynn_array<Exact32, 1, mynn_tile>(arena, {1}, {kte});
