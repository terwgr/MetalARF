static inline F wf_expf(F x) {
    if (((x.bits>>23)&255u)>=134u) return x<F(0.f) ? F(0.f) : x*SF(0x7f7fffffu);
    const Soft8 scale=SD8(0x40671547652b82feul),shift=SD8(0x4338000000000000ul);
    Soft8 z=Soft8(x),n=wf_fma(scale,z,shift);
    ulong i=n.bits;
    Soft8 r=wf_fma(scale,z,-(n-shift));
    Soft8 s=SD8(wf_exp_table[i&127ul]+(i<<45));
    Soft8 p=wf_fma(SD8(0x3eeebfbdff30d656ul),r,SD8(0x3f762e4453e10daeul));
    return F(wf_fma(p*r,s,s));
}
