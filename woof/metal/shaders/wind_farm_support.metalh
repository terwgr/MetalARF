#ifndef WOOF_WIND_FARM_SUPPORT
#define WOOF_WIND_FARM_SUPPORT
#include "sfire_support.metalh"
#include "soft_fdlibm64_trig.metalh"

static inline F wf_hypotf(F x, F y) {
    Soft8 a = Soft8(x), b = Soft8(y);
    return F(SD8(soft64_sqrt((a*a+b*b).bits)));
}
// Scalar libm graph used by the host-built turbine source. Library FMAs
// remain fused even though the calling CUDA statements do not contract.
static inline Soft8 wf_fma(Soft8 a, Soft8 b, Soft8 c) {
    return SD8(soft64_fma(a.bits, b.bits, c.bits));
}
// Turbine trig arguments come from latitude or atan2, hence |x| < 4.
static inline F wf_trig(F x, bool cosine) {
    if (cosine) x=fabsf(x);
    if (fabsf(x)<SF(0x39800000u))
        return cosine ? (SF(0x4c800000u)-x)*SF(0x32800000u)
                      : __fmaf_rn(x,SF(0x4c800000u),x)*SF(0x32800000u);
    Soft8 z=Soft8(x),scaled=z*SD8(0x3fe45f306dc9c883ul);
    int n=int(scaled);
    Soft8 rem=scaled-Soft8(n),midpoint=Soft8(.5f);
    if (rem>midpoint || (rem==midpoint && (n&1))) ++n;
    if (rem<-midpoint || (rem==-midpoint && (n&1))) --n;
    z=wf_fma(-Soft8(n),SD8(0x3ff921fb54442d18ul),z);
    Soft8 t=z*z,r;
    if (((n+int(cosine))&1)!=0) {
        Soft8 p=wf_fma(t,SD8(0x3ef99169fc938f4aul),SD8(0xbf56c07f16945df4ul));
        Soft8 q=wf_fma(t,SD8(0x3fa55553c7899699ul),SD8(0xbfdffffffcb82e97ul));
        r=wf_fma(t,wf_fma(t*t,p,q),Soft8(1));
    } else {
        Soft8 cube=z*t;
        Soft8 p=wf_fma(t,SD8(0xbf29943e0fc4818ful),SD8(0x3f811073afd145ebul));
        Soft8 q=wf_fma(cube,SD8(0xbfc555545268a02aul),z);
        r=wf_fma(t*cube,p,q);
    }
    if (((n+int(cosine))>>1)&1) r=-r;
    return F(r);
}
static inline F wf_sinf(F x) { return wf_trig(x,false); }
static inline F wf_cosf(F x) { return wf_trig(x,true); }
// Adjacent sine/cosine calls use the host compiler's paired routine.
static inline F wf_pair_trig(F x, bool cosine) {
    if (fabsf(x)<SF(0x39800000u)) return wf_trig(x,cosine);
    Soft8 scaled=Soft8(x)*SD8(0x3fe45f306dc9c883ul);
    int n=int(scaled);
    Soft8 rem=scaled-Soft8(n),midpoint=Soft8(.5f);
    if (rem>midpoint || (rem==midpoint && (n&1))) ++n;
    if (rem<-midpoint || (rem==-midpoint && (n&1))) --n;
    rem=scaled-Soft8(n);
    Soft8 t=rem*rem,r;
    if (((n+int(cosine))&1)!=0) {
        Soft8 a=wf_fma(t,t+SD8(0xc020bc0396540c13ul),SD8(0x401d78212789bc11ul));
        Soft8 b=wf_fma(t,t+SD8(0xc02d6f5ade6c8c37ul),SD8(0x4062c6b9c7f88fa0ul));
        r=(SD8(0x3f4d9c364e9721d5ul)*a)*b;
    } else {
        Soft8 a=wf_fma(t,t+SD8(0xc02c3d3ee4f8713ful),SD8(0x40444921a30f0d80ul));
        Soft8 b=wf_fma(t,t+SD8(0xc02ef09ab49e3a5bul),SD8(0x406e97264e36bd93ul));
        r=((rem*SD8(0x3f24bc899499342cul))*a)*b;
    }
    if (((n+int(cosine))>>1)&1) r=-r;
    return F(r);
}
constant ulong wf_asin_large[6] = {0x3f5ee93cb2957053ul,0x3f6140186da86810ul,
    0x3f807e5fa0a35d8bul,0x3f9b21ec14e82132ul,0x3fbe2b8cc3173f9eul,0x3ff6a09e64c7c6e1ul};
constant ulong wf_asin_small[6] = {0x3fa15e1a450e8b98ul,0x3f9169f766637e01ul,
    0x3f9fe10bae9583baul,0x3fa6d55e6da5eec2ul,0x3fb3334481d0bc2ful,0x3fc555554d58f2f9ul};
static inline Soft8 wf_asin_poly(Soft8 t, constant ulong *c) {
    Soft8 a=wf_fma(t,SD8(c[0]),SD8(c[1]));
    Soft8 b=wf_fma(t,SD8(c[2]),SD8(c[3]));
    Soft8 d=wf_fma(t,SD8(c[4]),SD8(c[5]));
    Soft8 tt=t*t;
    return wf_fma(tt,wf_fma(tt,a,b),d);
}
static inline F wf_asinf(F x) {
    F ax=fabsf(x);
    if (ax==F(1.f)) return F::lit(0x3fc90fdau | (x.bits & 0x80000000u));
    if (ax>F(1.f)) return F::lit(0x7fc00000u);
    if (ax>F(.5f)) {
        Soft8 t=Soft8(F(1.f)-ax);
        Soft8 r=wf_fma(-wf_asin_poly(t,wf_asin_large),SD8(soft64_sqrt(t.bits)),SD8(0x3ff921fb54442d18ul));
        F y=F(r);return F::lit(y.bits | (x.bits & 0x80000000u));
    }
    if (ax < SF(0x32000000u)) return __fmaf_rn(x,SF(0x4d000000u),x)*SF(0x32000000u);
    Soft8 z=Soft8(x),t=z*z;
    return F(wf_fma(z,t*wf_asin_poly(t,wf_asin_small),z));
}
static inline F wf_acosf(F x) {
    F ax=fabsf(x);
    if (ax==F(1.f)) return x>F(0.f) ? F(0.f) : SF(0x40490fdau);
    if (ax>F(1.f)) return F::lit(0x7fc00000u);
    if (ax>F(.5f)) {
        Soft8 t=Soft8(F(1.f)-ax),root=SD8(soft64_sqrt(t.bits));
        Soft8 p=wf_asin_poly(t,wf_asin_large);
        return F(x>F(0.f) ? p*root : wf_fma(-p,root,SD8(0x400921fb54442d18ul)));
    }
    Soft8 z=Soft8(x);
    if (ax>=SF(0x3b000000u)) {
        Soft8 t=z*z;z=wf_fma(z,t*wf_asin_poly(t,wf_asin_small),z);
    }
    return F(SD8(0x3ff921fb54442d18ul)-z);
}
static inline F wf_remainderf(F x, F y) {
    // Geographic differences are bounded by 360 degrees; ties round to even.
    float q = rint(as_type<float>((x/y).bits));
    return x-y*F(q);
}
constant ulong wf_atan_coeff[9] = {
    0x4002609372076e2cul,0xc00792d5bf17c0bcul,0x40038f4c070b63c1ul,
    0x4015e43168d7c2b6ul,0x3f953db49b9fcf6bul,0xc013e370146726b3ul,
    0x400e4fa479729042ul,0x401ae0fb08f2dc00ul,0x3f680bc0fe23203dul};
static inline Soft8 wf_atan_poly(Soft8 z) {
    Soft8 t=z*z;
    Soft8 a=wf_fma(t,t+SD8(wf_atan_coeff[0]),SD8(wf_atan_coeff[2]));
    Soft8 b=wf_fma(t,t+SD8(wf_atan_coeff[1]),SD8(wf_atan_coeff[3]));
    Soft8 c=wf_fma(t,t+SD8(wf_atan_coeff[4]),SD8(wf_atan_coeff[6]));
    Soft8 d=wf_fma(t,t+SD8(wf_atan_coeff[5]),SD8(wf_atan_coeff[7]));
    return ((a*c)*SD8(wf_atan_coeff[8]))*((b*d)*z);
}
static inline F wf_atan2f(F y, F x) {
    const Soft8 pi=SD8(0x400921fb54442d18ul),halfpi=SD8(0x3ff921fb54442d18ul);
    if (isnan(x)||isnan(y)) return x+y;
    if ((x.bits & 0x7fffffffu)==0u && (y.bits & 0x7fffffffu)==0u)
        return (x.bits>>31) ? F::lit((y.bits&0x80000000u)|0x40490fdbu) : y;
    if (fabsf(y)>fabsf(x)) {
        Soft8 p=wf_atan_poly(Soft8(x)/Soft8(y));
        return F((y.bits>>31 ? -halfpi : halfpi)-p);
    }
    Soft8 p=wf_atan_poly(Soft8(y)/Soft8(x));
    if (x.bits>>31) p=p+(y.bits>>31 ? -pi : pi);
    return F(p);
}
