SD8 ( 0x0000000000000000ul ) , - SD8 ( 0x3df83496000e13b7ul ) , - SD8 ( 0x3e6ebc7db224cadcul ) , - SD8 ( 0x3ed87e636ac48256ul ) , SD8 ( 0x3e695d3ca4020994ul ) , - SD8 ( 0x3ddf2c040abc83f0ul ) , SD8 ( 0x3d3892535affcbeaul ) }
