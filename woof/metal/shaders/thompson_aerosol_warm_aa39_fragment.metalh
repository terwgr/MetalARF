out -> nwfa_m3 = thompson_aa_clamp_nwfa ( nwfa_entry_v * rho ) ;
out -> nifa_m3 = thompson_aa_clamp_nifa ( nifa_entry_v * rho ) ;
if ( out -> l_qc ) {
int entry_nu_c = 0 ;
Soft8 entry_lamc = SD8 ( 0x0000000000000000ul ) ;
out -> nc_m3 = thompson_aa_cloud_dist ( cloud_mass , nc_entry_v , rho , & entry_nu_c , & entry_lamc ) ;
( void ) entry_nu_c ;
( void ) entry_lamc ;
out -> nu_c = thompson_aa_nu_c_working ( out -> nc_m3 ) ;
out -> xdc = aa_fmaxf ( 1.0e-6f * 1.0e6f , thompson_aa_mul ( thompson_aa_powf ( thompson_aa_div ( cloud_mass , thompson_aa_mul ( am_r , out -> nc_m3 ) ) , 3.333333433e-01f ) , 1.0e6f ) ) ;
out -> lamc = ( Soft8 ) thompson_aa_powf ( thompson_aa_div ( thompson_aa_mul ( thompson_aa_mul ( thompson_aa_mul ( out -> nc_m3 , am_r ) , THOMPSON_AA_CCG2 [ out -> nu_c ] ) , THOMPSON_AA_OCG1 [ out -> nu_c ] ) , cloud_mass ) , 3.333333433e-01f ) ;
float mvd_c = ( float ) ( aa_div ( ( Soft8 ) ( ( 3.0f + ( float ) out -> nu_c ) + 0.672f ) , out -> lamc ) ) ;
out -> mvd_c = mvd_c ;
}
float rain_number ;
Soft8 rain_lambda ;
float rain_mvd ;
Soft8 rain_n0 ;
out -> rain_active = thompson_aa_entry_rain_distribution ( qr_v , nr_entry_v , rho , & rain_number , & rain_lambda , & rain_mvd , & rain_n0 ) ;
out -> nr_m3 = rain_number ;
out -> lamr = rain_lambda ;
out -> mvd_r = rain_mvd ;
out -> n0_r = rain_n0 ;
if ( cloud_mass > 0.01e-3f ) {
const int nu_c = out -> nu_c ;
const float xdc = out -> xdc ;
const float dcg = ( float ) ( aa_div ( ( Soft8 ) thompson_aa_powf ( thompson_aa_mul ( THOMPSON_AA_CCG3 [ nu_c ] , THOMPSON_AA_OCG2 [ nu_c ] ) , 3.333333433e-01f ) , out -> lamc ) * SD8 ( 0x412e848000000000ul ) ) ;
const float xdc3 = thompson_aa_mul ( thompson_aa_mul ( xdc , xdc ) , xdc ) ;
const float dcb_arg = thompson_aa_sub ( thompson_aa_mul ( thompson_aa_mul ( thompson_aa_mul ( xdc3 , dcg ) , dcg ) , dcg ) , thompson_aa_mul ( thompson_aa_mul ( thompson_aa_mul ( xdc3 , xdc ) , xdc ) , xdc ) ) ;
const float dcb = thompson_aa_powf ( aa_fmaxf ( 0.0f , dcb_arg ) , aa_div ( 1.0f , 6.0f ) ) ;
const float zeta_term = thompson_aa_sub ( thompson_aa_mul ( thompson_aa_mul ( thompson_aa_mul ( thompson_aa_mul ( 6.25e-6f , xdc ) , dcb ) , dcb ) , dcb ) , 0.4f ) ;
const float zeta1 = thompson_aa_mul ( 0.5f , thompson_aa_add ( zeta_term , fabs ( zeta_term ) ) ) ;
const float zeta = thompson_aa_mul ( thompson_aa_mul ( 0.027f , cloud_mass ) , zeta1 ) ;
const float tau_diameter = thompson_aa_sub ( thompson_aa_mul ( 0.5f , dcb ) , 7.5f ) ;
const float taud = thompson_aa_add ( thompson_aa_mul ( 0.5f , thompson_aa_add ( tau_diameter , fabs ( tau_diameter ) ) ) , 1.0e-12f ) ;
const float tau = thompson_aa_div ( 3.72f , thompson_aa_mul ( cloud_mass , taud ) ) ;
out -> prr_wau = fmin ( ( Soft8 ) ( cloud_mass * inverse_dt ) , ( Soft8 ) thompson_aa_div ( zeta , tau ) ) ;
out -> pnr_wau = aa_div ( out -> prr_wau , ( Soft8 ) thompson_aa_mul ( thompson_aa_mul ( thompson_aa_mul ( am_r , ( float ) nu_c ) , 50.0e-6f ) , thompson_aa_mul ( 50.0e-6f , 50.0e-6f ) ) ) ;
out -> pnc_wau = fmin ( ( Soft8 ) ( out -> nc_m3 * inverse_dt ) , aa_div ( out -> prr_wau , ( Soft8 ) thompson_aa_mul ( thompson_aa_mul ( thompson_aa_mul ( am_r , out -> mvd_c ) , out -> mvd_c ) , out -> mvd_c ) ) ) ;
}
if ( ! out -> rain_active ) return ;
if ( rain_mvd > 50.0e-6f ) {
const float efficiency = 1.0f - thompson_aa_expf ( 2300.0f * ( rain_mvd - 1950.0e-6f ) ) ;
out -> pnr_rcr = ( Soft8 ) ( efficiency * 2.0f * rain_number * rain_mass ) ;
}
if ( ! ( rain_mvd > 50.0e-6f ) ) return ;
const Soft8 fall_kernel = thompson_aa_pow ( thompson_aa_rain_lambda_reformed ( rain_lambda ) + SD8 ( 0x4068600000000000ul ) , - SD8 ( 0x4010000000000000ul ) ) ;
const float t1_qr_qc = pi * 0.25f * 4854.0f * 6.0f ;
if ( out -> l_qc && out -> mvd_c > 1.0e-6f ) {
const Soft8 first = SD8 ( 0x3f0ad333f9742941ul ) ;
const Soft8 last = SD8 ( 0x3f740389985ae9dbul ) ;
int rain_bin = 1 + ( int ) ( aa_div ( SD8 ( 0x4059000000000000ul ) * thompson_aa_log ( aa_div ( ( Soft8 ) rain_mvd , first ) ) , thompson_aa_log ( aa_div ( last , first ) ) ) ) ;
rain_bin = min ( rain_bin , 100 ) ;
const int cloud_bin = min ( 100 , ( int ) ( out -> mvd_c * 1.0e6f ) ) ;
const float efficiency = ( float ) t_efrw [ ( rain_bin - 1 ) + 100 * ( cloud_bin - 1 ) ] ;
out -> prr_rcw = fmin ( ( Soft8 ) ( cloud_mass * inverse_dt ) , ( Soft8 ) ( rho_factor * t1_qr_qc * efficiency * cloud_mass ) * rain_n0 * fall_kernel ) ;
out -> pnc_rcw = fmin ( ( Soft8 ) ( out -> nc_m3 * inverse_dt ) , ( Soft8 ) ( rho_factor * t1_qr_qc * efficiency * out -> nc_m3 ) * rain_n0 * fall_kernel ) ;
}
const float visco = ( tempc >= 0.0f ) ? ( 1.718f + 0.0049f * tempc ) * 1.0e-5f : ( 1.718f + 0.0049f * tempc - 1.2e-5f * tempc * tempc ) * 1.0e-5f ;
const float ef_ccn = thompson_aa_eff_aero ( rain_mvd , 0.04e-6f , visco , rho , temp_k , 0 ) ;
out -> pna_rca = fmin ( ( Soft8 ) ( out -> nwfa_m3 * inverse_dt ) , ( Soft8 ) ( rho_factor * t1_qr_qc * ef_ccn * out -> nwfa_m3 ) * rain_n0 * fall_kernel ) ;
const float ef_in = thompson_aa_eff_aero ( rain_mvd , 0.8e-6f , visco , rho , temp_k , 0 ) ;
out -> pnd_rcd = fmin ( ( Soft8 ) ( out -> nifa_m3 * inverse_dt ) , ( Soft8 ) ( rho_factor * t1_qr_qc * ef_in * out -> nifa_m3 ) * rain_n0 * fall_kernel ) ;
}

static inline float thompson_aa_log10f_cr ( float x ) {
return thompson_aa_log10f ( x ) ;
}

static inline float thompson_aa_graupel_number_from_lambda ( float graupel_mass , Soft8 lamg , float am_g ) {
return ( float ) ( aa_div ( ( Soft8 ) thompson_aa_mul ( ( aa_div ( 1.0f , 6.0f ) ) , graupel_mass ) * thompson_aa_pow ( lamg , SD8 ( 0x4008000000000000ul ) ) , ( Soft8 ) am_g ) ) ;
}

