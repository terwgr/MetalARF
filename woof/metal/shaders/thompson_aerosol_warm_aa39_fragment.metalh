out -> smo0 = 0.0f ;
out -> smo1 = 0.0f ;
out -> smoc = 0.0f ;
out -> smoe = 0.0f ;
out -> smof = 0.0f ;
out -> xds = 0.0f ;
out -> ng_m3 = 0.0f ;
out -> mvd_g = 0.0f ;
out -> xdg = 0.0f ;
out -> vtg = 0.0f ;
out -> stoke_g = 0.0f ;
out -> ef_sw = 0.0f ;
out -> ef_gw = 0.0f ;
out -> lamg = SD8 ( 0x3ff0000000000000ul ) ;
out -> ilamg = SD8 ( 0x3ff0000000000000ul ) ;
out -> n0_g = SD8 ( 0x0000000000000000ul ) ;
out -> prs_scw = SD8 ( 0x0000000000000000ul ) ;
out -> pnc_scw = SD8 ( 0x0000000000000000ul ) ;
out -> prg_gcw = SD8 ( 0x0000000000000000ul ) ;
out -> pnc_gcw = SD8 ( 0x0000000000000000ul ) ;
out -> pna_sca = SD8 ( 0x0000000000000000ul ) ;
out -> pnd_scd = SD8 ( 0x0000000000000000ul ) ;
out -> pna_gca = SD8 ( 0x0000000000000000ul ) ;
out -> pnd_gcd = SD8 ( 0x0000000000000000ul ) ;
if ( out -> l_qs ) {
const float tc0 = aa_fminf ( - 0.1f , tempc ) ;
out -> smob = snow_mass * ( aa_div ( 1.0f , 0.069f ) ) ;
out -> smo0 = thompson_field_a ( tc0 , 0.0f ) * thompson_aa_powf ( out -> smob , thompson_field_b ( tc0 , 0.0f ) ) ;
out -> smo1 = thompson_field_a ( tc0 , 1.0f ) * thompson_aa_powf ( out -> smob , thompson_field_b ( tc0 , 1.0f ) ) ;
out -> smof = thompson_field_a ( tc0 , 1.775f ) * thompson_aa_powf ( out -> smob , thompson_field_b ( tc0 , 1.775f ) ) ;
out -> smoc = thompson_field_a ( tc0 , 3.0f ) * thompson_aa_powf ( out -> smob , thompson_field_b ( tc0 , 3.0f ) ) ;
out -> smoe = thompson_field_a ( tc0 , 2.55f ) * thompson_aa_powf ( out -> smob , thompson_field_b ( tc0 , 2.55f ) ) ;
out -> xds = aa_div ( out -> smoc , out -> smob ) ;
}
thompson_aa_wrf39_graupel_slope ( graupel_number_per_kg_v , graupel_mass , & out -> lamg , & out -> ilamg , & out -> n0_g ) ;
out -> ng_m3 = 0.0f ;
( void ) am_g ;
if ( false ) {
float ng = 1.0e-6f ;
ng = aa_fmaxf ( 1.0e-6f , graupel_number_per_kg_v * rho ) ;
Soft8 lamg ;
if ( ng <= 1.0e-6f ) {
out -> mvd_g = 1.5e-3f ;
lamg = ( Soft8 ) ( aa_div ( ( ( 3.0f + 0.0f ) + 0.672f ) , out -> mvd_g ) ) ;
ng = thompson_aa_graupel_number_from_lambda ( graupel_mass , lamg , am_g ) ;
}
lamg = ( Soft8 ) thompson_aa_powf ( aa_div ( am_g * 6.0f * ng , graupel_mass ) , aa_div ( 1.0f , 3.0f ) ) ;
out -> mvd_g = ( float ) ( aa_div ( ( ( Soft8 ) ( ( 3.0f + 0.0f ) + 0.672f ) ) , lamg ) ) ;
if ( out -> mvd_g > 25.4e-3f ) {
out -> mvd_g = 25.4e-3f ;
lamg = ( Soft8 ) ( aa_div ( ( ( 3.0f + 0.0f ) + 0.672f ) , out -> mvd_g ) ) ;
ng = thompson_aa_graupel_number_from_lambda ( graupel_mass , lamg , am_g ) ;
}
else if ( out -> mvd_g < 50.0e-6f ) {
out -> mvd_g = 50.0e-6f ;
lamg = ( Soft8 ) ( aa_div ( ( ( 3.0f + 0.0f ) + 0.672f ) , out -> mvd_g ) ) ;
ng = thompson_aa_graupel_number_from_lambda ( graupel_mass , lamg , am_g ) ;
}
}
const float viscosity_aero = ( tempc >= 0.0f ) ? ( 1.718f + 0.0049f * tempc ) * 1.0e-5f : ( 1.718f + 0.0049f * tempc - 1.2e-5f * tempc * tempc ) * 1.0e-5f ;
const float snow_d0 = 200.0e-6f ;
const Soft8 snow_d0_d = ( Soft8 ) 200.0e-6f ;
const float frozen_first = 1.0e-5f ;
if ( l_qc && cloud_mvd > 1.0e-6f ) {
if ( out -> xds > snow_d0 ) {
const Soft8 diameter_ratio = aa_div ( SD8 ( 0x3f947ae147ae147bul ) , snow_d0_d ) ;
const Soft8 log_ratio = thompson_aa_log ( diameter_ratio ) ;
const Soft8 first = snow_d0_d * thompson_aa_exp ( aa_div ( SD8 ( 0x3fe0000000000000ul ) , SD8 ( 0x4059000000000000ul ) ) * log_ratio ) ;
const Soft8 last = snow_d0_d * thompson_aa_exp ( aa_div ( SD8 ( 0x4058e00000000000ul ) , SD8 ( 0x4059000000000000ul ) ) * log_ratio ) ;
int snow_bin = 1 + ( int ) ( aa_div ( SD8 ( 0x4059000000000000ul ) * thompson_aa_log ( aa_div ( ( Soft8 ) out -> xds , first ) ) , thompson_aa_log ( aa_div ( last , first ) ) ) ) ;
snow_bin = max ( 1 , min ( snow_bin , 100 ) ) ;
const int cloud_bin = max ( 1 , min ( ( int ) ( cloud_mvd * 1.0e6f ) , 100 ) ) ;
out -> ef_sw = ( float ) snow_cloud_efficiency [ ( snow_bin - 1 ) + 100 * ( cloud_bin - 1 ) ] ;
out -> prs_scw = fmin ( ( Soft8 ) ( cloud_mass * inverse_dt ) , ( Soft8 ) ( rho_factor * t1_qs_qc * out -> ef_sw * cloud_mass * out -> smoe ) ) ;
out -> pnc_scw = fmin ( ( Soft8 ) ( cloud_number * inverse_dt ) , ( Soft8 ) ( rho_factor * t1_qs_qc * out -> ef_sw * cloud_number * out -> smoe ) ) ;
}
if ( graupel_mass >= frozen_first ) {
out -> xdg = ( float ) ( SD8 ( 0x4010000000000000ul ) * out -> ilamg ) ;
out -> vtg = ( float ) ( ( Soft8 ) ( rho_factor * 442.0f * 20.3632278f * ( aa_div ( 1.0f , 6.0f ) ) ) * thompson_aa_pow ( out -> ilamg , ( ( Soft8 ) ( 0.0f + 0.89f ) ) ) ) ;
out -> stoke_g = aa_div ( cloud_mvd * cloud_mvd * out -> vtg * 1000.0f , ( 9.0f * viscosity_aero * out -> xdg ) ) ;
float efficiency = 0.0f ;
if ( out -> stoke_g >= 0.4f && out -> stoke_g <= 10.0f ) {
efficiency = thompson_aa_mul ( 0.55f , thompson_aa_log10f_cr ( thompson_aa_mul ( 2.51f , out -> stoke_g ) ) ) ;
}
else if ( out -> stoke_g > 10.0f ) {
efficiency = 0.77f ;
}
( void ) wet_bulb ;
if ( ! ( out -> xdg > 250.0e-6f ) ) efficiency = 0.0f ;
out -> ef_gw = efficiency ;
const Soft8 fall_kernel = thompson_aa_pow ( out -> ilamg , ( ( Soft8 ) ( ( 0.0f + 0.89f ) + 3.0f ) ) ) ;
out -> prg_gcw = ( Soft8 ) ( rho_factor * t1_qg_qc * efficiency * cloud_mass ) * out -> n0_g * fall_kernel ;
out -> pnc_gcw = fmin ( ( Soft8 ) ( cloud_number * inverse_dt ) , ( Soft8 ) ( rho_factor * t1_qg_qc * efficiency * cloud_number ) * out -> n0_g * fall_kernel ) ;
}
}
if ( snow_mass > frozen_first ) {
const float ef_ccn = thompson_aa_eff_aero ( out -> xds , 0.04e-6f , viscosity_aero , rho , temp_k , 1 ) ;
out -> pna_sca = fmin ( ( Soft8 ) ( nwfa_m3 * inverse_dt ) , ( Soft8 ) ( rho_factor * t1_qs_qc * ef_ccn * nwfa_m3 * out -> smoe ) ) ;
const float ef_in = thompson_aa_eff_aero ( out -> xds , 0.8e-6f , viscosity_aero , rho , temp_k , 1 ) ;
out -> pnd_scd = fmin ( ( Soft8 ) ( nifa_m3 * inverse_dt ) , ( Soft8 ) ( rho_factor * t1_qs_qc * ef_in * nifa_m3 * out -> smoe ) ) ;
}
if ( graupel_mass > frozen_first ) {
out -> xdg = ( float ) ( SD8 ( 0x4010000000000000ul ) * out -> ilamg ) ;
const Soft8 fall_kernel = thompson_aa_pow ( out -> ilamg , ( ( Soft8 ) ( ( 0.0f + 0.89f ) + 3.0f ) ) ) ;
const float ef_ccn = thompson_aa_eff_aero ( out -> xdg , 0.04e-6f , viscosity_aero , rho , temp_k , 2 ) ;
out -> pna_gca = fmin ( ( Soft8 ) ( nwfa_m3 * inverse_dt ) , ( Soft8 ) ( rho_factor * t1_qg_qc * ef_ccn * nwfa_m3 ) * out -> n0_g * fall_kernel ) ;
const float ef_in = thompson_aa_eff_aero ( out -> xdg , 0.8e-6f , viscosity_aero , rho , temp_k , 2 ) ;
out -> pnd_gcd = fmin ( ( Soft8 ) ( nifa_m3 * inverse_dt ) , ( Soft8 ) ( rho_factor * t1_qg_qc * ef_in * nifa_m3 ) * out -> n0_g * fall_kernel ) ;
