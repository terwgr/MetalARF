template < typename P_t_efrw , typename P_out > static inline void thompson_aa_warm_rain_rates ( float qc_v , float nc_entry_v , float qr_v , float nr_entry_v , float nwfa_entry_v , float nifa_entry_v , float rho , float temp_k , float rho_factor , float inverse_dt , P_t_efrw t_efrw , P_out out ) {
const float pi = 3.1415926536f ;
const float am_r = 5.235988159e+02f ;
const float tempc = temp_k - 273.15f ;
const float cloud_mass = aa_fmaxf ( 0.0f , qc_v * rho ) ;
const float rain_mass = aa_fmaxf ( 0.0f , qr_v * rho ) ;
out -> l_qc = qc_v > 1.0e-12f ;
out -> nu_c = 0 ;
out -> lamc = SD8 ( 0x0000000000000000ul ) ;
out -> xdc = 0.0f ;
out -> mvd_c = 1.0e-6f ;
