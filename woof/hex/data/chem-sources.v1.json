      "grid": {
        "time": "time",
        "latitude": "grid_latt",
        "longitude": "grid_lont",
        "latitude_units": "degrees_north",
        "longitude_units": "degrees_east",
        "angle": "degrees",
        "time_attribute": "time_coverage_start"
      },
      "download": {
        "listing": "https://www.ospo.noaa.gov/pub/Blended/RAVE/RAVE-HrlyEmiss-3km/%Y/%m/",
        "pattern": "RAVE-HrlyEmiss-3km_v[0-9]+r[0-9]+_blend_s(?P<valid>\\d{10})00000_e\\d{15}_c(?P<creation>\\d{15})\\.nc",
        "time_format": "%Y%m%d%H"
      },
      "variables": [
        {
          "species": "smoke",
          "selector": "PM25",
          "units": "kg",
          "no_fire_sentinel": -1,
          "sentinel_meaning": "RAVE documented no-fire cells use -1; not a generic missing-value conversion",
          "masks": [
            {
              "selector": "QA",
              "minimum": 2,
              "maximum": 3
            }
          ]
        }
      ]
    },
